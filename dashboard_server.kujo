# Existing dashboard APIs
server := server.route("GET", "/api/stats", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}

	total_rows := db_query(db, "SELECT COUNT(*) AS n FROM requests", [])
	error_rows := db_query(db, "SELECT COUNT(*) AS n FROM requests WHERE status = 'error'", [])
	cost_rows := db_query(db, "SELECT COALESCE(SUM(cost_usd),0) AS total FROM requests", [])
	lat_rows := db_query(db, "SELECT COALESCE(AVG(latency_ms),0) AS avg FROM requests WHERE status = 'success'", [])
	tok_rows := db_query(db, "SELECT COALESCE(SUM(total_tokens),0) AS total FROM requests", [])
	sess_rows := db_query(db, "SELECT COUNT(DISTINCT session_id) AS n FROM requests", [])
	tc_rows := db_query(db, "SELECT COUNT(*) AS n FROM tool_calls", [])
	step_rows := db_query(db, "SELECT COUNT(*) AS n FROM agent_steps", [])

	total := total_rows[0]["n"]
	errors := error_rows[0]["n"]
	cost := cost_rows[0]["total"]
	avg_lat := lat_rows[0]["avg"]
	tokens := tok_rows[0]["total"]
	sess_n := sess_rows[0]["n"]
	tc_n := tc_rows[0]["n"]
	steps_n := step_rows[0]["n"]

	error_rate := 0.0
	if total > 0 {
		error_rate := (errors * 100.0) / total
	}

	return api_ok({
		"total_requests": total,
		"total_errors": errors,
		"error_rate_pct": error_rate,
		"total_cost_usd": cost,
		"avg_latency_ms": avg_lat,
		"total_tokens": tokens,
		"total_sessions": sess_n,
		"total_tool_calls": tc_n,
		"total_agent_steps": steps_n
	})
})

server := server.route("GET", "/api/requests", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}

	page := request_query_int(req, "page", 1, 1, 1000000)
	page_size := request_query_int(req, "page_size", 200, 1, 500)
	offset := (page - 1) * page_size

	conditions := []
	params := []

	session_id := request_query_text(req, "session_id", "")
	if session_id != "" {
		conditions := push(conditions, "session_id = ?")
		params := push(params, session_id)
	}

	user_id := request_query_text(req, "user_id", "")
	if user_id != "" {
		conditions := push(conditions, "user_id = ?")
		params := push(params, user_id)
	}

	tenant_id := request_query_text(req, "tenant_id", "")
	if tenant_id != "" {
		conditions := push(conditions, "tenant_id = ?")
		params := push(params, tenant_id)
	}

	project_id := request_query_text(req, "project_id", "")
	if project_id != "" {
		conditions := push(conditions, "project_id = ?")
		params := push(params, project_id)
	}

	status := request_query_text(req, "status", "")
	if status != "" {
		conditions := push(conditions, "status = ?")
		params := push(params, status)
	}

	provider := request_query_text(req, "provider", "")
	if provider != "" {
		conditions := push(conditions, "provider = ?")
		params := push(params, provider)
	}

	workflow_id := request_query_text(req, "workflow_id", "")
	if workflow_id != "" {
		conditions := push(conditions, "workflow_id = ?")
		params := push(params, workflow_id)
	}

	task_id := request_query_text(req, "task_id", "")
	if task_id != "" {
		conditions := push(conditions, "task_id = ?")
		params := push(params, task_id)
	}

	correlation_id := request_query_text(req, "correlation_id", "")
	if correlation_id != "" {
		conditions := push(conditions, "correlation_id = ?")
		params := push(params, correlation_id)
	}

	model := request_query_text(req, "model", "")
	if model != "" {
		conditions := push(conditions, "model = ?")
		params := push(params, model)
	}

	since_ms := request_query_int(req, "since_ms", 0, 0, 9223372036854775807)
	if since_ms > 0 {
		conditions := push(conditions, "CAST(created_at AS INTEGER) >= ?")
		params := push(params, since_ms)
	}

	until_ms := request_query_int(req, "until_ms", 0, 0, 9223372036854775807)
	if until_ms > 0 {
		conditions := push(conditions, "CAST(created_at AS INTEGER) <= ?")
		params := push(params, until_ms)
	}

	sql := "SELECT id, session_id, user_id, tenant_id, project_id, workflow_id, task_id, correlation_id, provider, model, request_id, status, input_tokens, output_tokens, total_tokens, cost_usd, latency_ms, finish_reason, error_code, error_message, prompt_summary, response_summary, created_at FROM requests"
	sql := sql + where_clause_from_conditions(conditions)
	sql := sql + " ORDER BY created_at DESC LIMIT ? OFFSET ?"
	params := push(params, page_size)
	params := push(params, offset)

	rows := db_query(db, sql, params)
	return api_ok(rows)
})

server := server.route("GET", "/api/audit-events", func(req) {
