{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujolang.dev/schemas/watchdog-telemetry-v2.schema.json",
  "title": "Watchdog canonical AI telemetry batch",
  "description": "Backend-neutral, metadata-first Watchdog telemetry. This is not an OTLP wire schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "producer", "records"],
  "properties": {
    "schema_version": {"const": "watchdog.telemetry.v2"},
    "batch_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "sent_at": {"type": ["string", "null"], "format": "date-time"},
    "producer": {"$ref": "#/$defs/producer"},
    "records": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "version": {"type": "string", "minLength": 1, "maxLength": 40},
        "adapter_id": {"type": ["string", "null"], "maxLength": 80},
        "adapter_version": {"type": ["string", "null"], "maxLength": 40},
        "original_schema": {"type": ["string", "null"], "maxLength": 120}
      }
    },
    "scalar": {"type": ["string", "number", "integer", "boolean", "null"]},
    "scalarArray": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/scalar"}},
    "attributeArray": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/attributeValue"}},
    "attributeObject": {"type": "object", "maxProperties": 128, "additionalProperties": {"$ref": "#/$defs/attributeValue"}},
    "attributeValue": {"anyOf": [{"$ref": "#/$defs/scalar"}, {"$ref": "#/$defs/attributeArray"}, {"$ref": "#/$defs/attributeObject"}]},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["session", "run", "turn", "workflow", "task", "agent", "tool_call", "request", "artifact", "evaluation", "external"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 160},
        "namespace": {"type": ["string", "null"], "maxLength": 80},
        "relation": {"type": ["string", "null"], "maxLength": 40}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_write_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "usage_source": {"type": ["string", "null"], "maxLength": 80},
        "total_semantics": {"type": ["string", "null"], "maxLength": 120},
        "provider_usage": {"type": ["object", "null"], "maxProperties": 32, "additionalProperties": {"$ref": "#/$defs/scalar"}}
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "currency", "amount", "source"],
      "properties": {
        "kind": {"enum": ["provider_reported", "catalog_estimated", "subscription_value_estimate", "unknown"]},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "amount": {"type": ["number", "null"], "minimum": 0},
        "source": {"type": "string", "minLength": 1, "maxLength": 120},
        "catalog_version": {"type": ["string", "null"], "maxLength": 80},
        "calculated_at": {"type": ["string", "null"], "format": "date-time"},
        "components": {"type": ["object", "null"], "maxProperties": 16, "additionalProperties": {"type": ["number", "integer", "null"]}}
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "class": {"type": ["string", "null"], "maxLength": 120},
        "category": {"type": ["string", "null"], "maxLength": 80},
        "code": {"type": ["string", "null"], "maxLength": 80},
        "retryable": {"type": ["boolean", "null"]},
        "message": {"type": ["string", "null"], "maxLength": 1000}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "media_type", "value"],
      "properties": {
        "class": {"enum": ["prompt", "response", "tool_input", "tool_output", "retrieval_document", "shell_input", "shell_output", "artifact", "error_detail"]},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 120},
        "value": {"type": "string", "maxLength": 65536},
        "truncated": {"type": "boolean"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_mode", "policy_version"],
      "properties": {
        "content_mode": {"enum": ["off", "summaries", "selected", "full"]},
        "policy_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "transformations": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 80}}
      }
    },
    "observabilitySource": {
      "type": "object",
      "maxProperties": 16,
      "properties": {
        "watchdog.semantic_profile": {"const": "watchdog.observability.v1"},
        "application.name": {"type": "string", "minLength": 1, "maxLength": 80},
        "application.version": {"type": "string", "minLength": 1, "maxLength": 40},
        "harness.name": {"type": "string", "minLength": 1, "maxLength": 80},
        "harness.version": {"type": "string", "minLength": 1, "maxLength": 40},
        "runtime.name": {"type": "string", "minLength": 1, "maxLength": 80},
        "runtime.version": {"type": "string", "minLength": 1, "maxLength": 40},
        "instrumentation.name": {"type": "string", "minLength": 1, "maxLength": 80},
        "instrumentation.version": {"type": "string", "minLength": 1, "maxLength": 40},
        "adapter_id": {"type": "string", "minLength": 1, "maxLength": 80},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 40},
        "original_schema": {"type": "string", "minLength": 1, "maxLength": 120},
        "source_event_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "source_trace_id": {"type": "string", "minLength": 1, "maxLength": 160}
      },
      "additionalProperties": {"$ref": "#/$defs/scalar"}
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_type", "trace_id", "observed_at", "source", "privacy"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "record_type": {"enum": ["trace", "span", "event"]},
        "trace_id": {"type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$"},
        "span_id": {"type": ["string", "null"], "pattern": "^(?!0{16}$)[0-9a-f]{16}$"},
        "parent_span_id": {"type": ["string", "null"], "pattern": "^(?!0{16}$)[0-9a-f]{16}$"},
        "observed_at": {"type": "string", "format": "date-time"},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "ended_at": {"type": ["string", "null"], "format": "date-time"},
        "kind": {"enum": [null, "model", "agent", "tool", "retrieval", "workflow", "handoff", "approval", "execution", "persistence", "evaluation", "internal"]},
        "name": {"type": ["string", "null"], "maxLength": 160},
        "status": {"enum": [null, "unset", "ok", "error", "cancelled", "timeout", "denied"]},
        "source": {"type": "object", "maxProperties": 16, "additionalProperties": {"$ref": "#/$defs/scalar"}},
        "references": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/reference"}},
        "attributes": {"type": "object", "maxProperties": 128, "additionalProperties": {"$ref": "#/$defs/attributeValue"}},
        "usage": {"anyOf": [{"$ref": "#/$defs/usage"}, {"type": "null"}]},
        "costs": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/cost"}},
        "error": {"$ref": "#/$defs/error"},
        "content": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/content"}},
        "privacy": {"$ref": "#/$defs/privacy"}
      },
      "allOf": [
        {"if": {"properties": {"record_type": {"const": "trace"}}}, "then": {"properties": {"span_id": {"type": "null"}, "parent_span_id": {"type": "null"}}}},
        {"if": {"properties": {"record_type": {"const": "span"}}}, "then": {"required": ["span_id"]}},
        {
          "if": {"properties": {"source": {"type": "object", "required": ["watchdog.semantic_profile"], "properties": {"watchdog.semantic_profile": {"const": "watchdog.observability.v1"}}}}},
          "then": {
            "properties": {
              "source": {"$ref": "#/$defs/observabilitySource"},
              "attributes": {
                "type": "object",
                "properties": {
                  "watchdog.attempt.number": {"type": "integer", "minimum": 1, "maximum": 1000000},
                  "watchdog.retry.reason_code": {"enum": ["rate_limit", "timeout", "transport", "provider_error", "invalid_response", "capacity", "policy", "operator", "unknown"]},
                  "watchdog.retry.decision_source": {"enum": ["application", "framework", "watchdog", "provider", "operator", "unknown"]},
                  "watchdog.fallback.dimension": {"enum": ["provider", "model", "account_route", "region", "strategy", "unknown"]},
                  "watchdog.fallback.reason_code": {"enum": ["rate_limit", "timeout", "transport", "provider_error", "invalid_response", "capacity", "policy", "operator", "quality", "unknown"]},
                  "watchdog.recovery.outcome": {"enum": ["succeeded", "failed", "partial", "unknown"]},
                  "watchdog.outcome.code": {"enum": ["success", "error", "cancelled", "timeout", "denied", "partial", "unknown"]},
                  "watchdog.outcome.terminal": {"type": "boolean"},
                  "watchdog.response.streamed": {"type": "boolean"},
                  "watchdog.timing.source": {"enum": ["producer_clock", "watchdog_proxy_clock", "provider_reported", "unavailable_buffered_transport", "unknown"]},
                  "watchdog.cancellation.source": {"enum": ["client", "provider", "watchdog", "framework", "operator", "policy", "shutdown", "unknown"]},
                  "watchdog.cancellation.reason_code": {"enum": ["disconnect", "abort_signal", "deadline", "budget", "approval_denied", "shutdown", "provider_cancelled", "unknown"]},
                  "watchdog.context.limit_source": {"enum": ["provider_reported", "versioned_catalog", "operator_config", "unknown"]},
                  "watchdog.context.pressure": {"enum": ["normal", "warning", "critical", "overflow", "unknown"]},
                  "watchdog.cost.evidence": {"enum": ["response_usage", "billing_api", "invoice", "catalog", "subscription_equivalent", "producer_assertion", "unknown"]}
                }
              }
            }
          }
        }
      ]
    }
  }
}
