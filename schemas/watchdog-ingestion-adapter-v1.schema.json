{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujolang.dev/schemas/watchdog-ingestion-adapter-v1.schema.json",
  "title": "Watchdog ingestion adapter manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "source_type", "input_protocol", "output_schema", "content_default", "supported_kinds"],
  "properties": {
    "contract_version": {"const": "watchdog.ingestion-adapter.v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 80},
    "version": {"type": "string", "minLength": 1, "maxLength": 40},
    "source_type": {"enum": ["proxy", "native", "host", "framework", "otlp", "mcp"]},
    "input_protocol": {"type": "string", "minLength": 1, "maxLength": 120},
    "output_schema": {"const": "watchdog.telemetry.v2"},
    "content_default": {"const": "off"},
    "supported_kinds": {"type": "array", "minItems": 1, "uniqueItems": true},
    "dependency_requirements": {"type": "array"},
    "source_id_namespace": {"type": "string", "maxLength": 80},
    "failure_isolation": {"enum": ["fail-open", "fail-closed"]}
  }
}
