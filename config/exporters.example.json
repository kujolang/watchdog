{
  "schema_version": "watchdog.exporters.v1",
  "exporters": [
    {
      "id": "local-collector",
      "type": "otlp_http",
      "enabled": false,
      "endpoint": "http://127.0.0.1:4318/v1/traces",
      "mapping_profile": "otel.genai.v1",
      "headers_from_env": {},
      "batch_records": 256,
      "timeout_seconds": 10,
      "max_attempts": 10,
      "max_queue_age_seconds": 604800,
      "history_age_seconds": 604800,
      "max_dead_letters": 10000
    }
  ]
}
