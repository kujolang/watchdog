# Pure canonical Watchdog -> OTLP/HTTP JSON mapper.

OTLP_EXPORTER_CONTRACT := "watchdog.exporter.v1"
OTLP_BASE_PROFILE := "otel.base.v1"
OTLP_GENAI_PROFILE := "otel.genai.v1"
OTLP_OPENINFERENCE_PROFILE := "openinference.v1"

func otlp_get(value, key, fallback_value) {
	if type(value) != "dict" || has_key(value, key) == 0 { return fallback_value }
	return value[key]
}

func otlp_text(value, max_len) {
	if type(value) == "null" { return "" }
	text := trim(to_string(value))
	if len(text) <= max_len { return text }
	return substring(text, 0, max_len)
}

func otlp_any_value_depth(value, depth) {
	if depth > 8 { return {"stringValue": "[depth-limit]"} }
	value_type := type(value)
	if value_type == "bool" || value_type == "boolean" { return {"boolValue": value} }
	if value_type == "integer" { return {"intValue": to_string(value)} }
	if value_type == "float" || value_type == "number" { return {"doubleValue": value} }
	if value_type == "array" {
		values := []
		item_count := 0
		for item in value {
			if item_count < 128 { values = push(values, otlp_any_value_depth(item, depth + 1)) }
			item_count = item_count + 1
		}
		return {"arrayValue": {"values": values}}
	}
	if value_type == "dict" {
		if has_key(value, "$watchdog.bytes_base64") { return {"bytesValue": otlp_text(value["$watchdog.bytes_base64"], 65536)} }
		if has_key(value, "$watchdog.kvlist") {
			values := []
			items := value["$watchdog.kvlist"]
			if type(items) == "array" {
				item_count := 0
				for item in items {
					if item_count < 128 && type(item) == "dict" {
						item_key := otlp_text(otlp_get(item, "key", ""), 160)
						if item_key != "" { values = push(values, {"key": item_key, "value": otlp_any_value_depth(otlp_get(item, "value", null), depth + 1)}) }
					}
					item_count = item_count + 1
				}
			}
			return {"kvlistValue": {"values": values}}
		}
		values := []
		item_count := 0
		for key in keys(value) {
			if item_count < 128 { values = push(values, {"key": otlp_text(key, 160), "value": otlp_any_value_depth(value[key], depth + 1)}) }
			item_count = item_count + 1
		}
		return {"kvlistValue": {"values": values}}
	}
	return {"stringValue": otlp_text(value, 4096)}
}

func otlp_any_value(value) { return otlp_any_value_depth(value, 0) }

func otlp_attribute(key, value) {
	return {"key": otlp_text(key, 160), "value": otlp_any_value(value)}
}

func otlp_add_attribute(attributes, key, value) {
	if type(value) == "null" || len(attributes) >= 160 { return attributes }
	return push(attributes, otlp_attribute(key, value))
}

func otlp_timestamp_nano(value) {
	text := otlp_text(value, 80)
	if len(text) >= 19 {
		base := substring(text, 0, 19)
		try {
			seconds := parse_date(base, "YYYY-MM-DDTHH:mm:ss")
			return to_string(seconds * 1000000000)
		} except err {}
	}
	return to_string(current_timestamp() * 1000000)
}

func otlp_status(value) {
	text := otlp_text(value, 20)
	if text == "error" || text == "timeout" || text == "denied" { return {"code": 2} }
	if text == "ok" { return {"code": 1} }
	return {"code": 0}
}

func otlp_span_kind(value) {
	kind := otlp_text(value, 40)
	if kind == "model" { return 3 }
	return 1
}

func otlp_openinference_kind(kind) {
	if kind == "model" { return "LLM" }
	if kind == "agent" { return "AGENT" }
	if kind == "tool" { return "TOOL" }
	if kind == "retrieval" { return "RETRIEVER" }
	if kind == "evaluation" { return "EVALUATOR" }
	if kind == "workflow" { return "CHAIN" }
	return ""
}

func otlp_reference_attributes(attributes, references) {
	if type(references) != "array" { return attributes }
	for reference in references {
		if type(reference) == "dict" {
			ref_type := otlp_text(otlp_get(reference, "type", "external"), 40)
			ref_id := otlp_text(otlp_get(reference, "id", ""), 160)
			if ref_id != "" { attributes = otlp_add_attribute(attributes, "watchdog.ref." + ref_type, ref_id) }
		}
	}
	return attributes
}

func otlp_usage_attributes(attributes, usage) {
	if type(usage) != "dict" { return attributes }
	fields := {
		"input_tokens": "gen_ai.usage.input_tokens",
		"output_tokens": "gen_ai.usage.output_tokens",
		"total_tokens": "watchdog.usage.total_tokens",
		"cached_input_tokens": "watchdog.usage.cached_input_tokens",
		"cache_write_input_tokens": "watchdog.usage.cache_write_input_tokens",
		"reasoning_tokens": "watchdog.usage.reasoning_tokens",
		"usage_source": "watchdog.usage.source",
		"total_semantics": "watchdog.usage.total_semantics"
	}
	for field in keys(fields) {
		if has_key(usage, field) { attributes = otlp_add_attribute(attributes, fields[field], usage[field]) }
	}
	return attributes
}

func otlp_cost_attributes(attributes, costs) {
	if type(costs) != "array" || len(costs) == 0 || type(costs[0]) != "dict" { return attributes }
	cost := costs[0]
	attributes = otlp_add_attribute(attributes, "watchdog.cost.kind", otlp_get(cost, "kind", "unknown"))
	attributes = otlp_add_attribute(attributes, "watchdog.cost.amount", otlp_get(cost, "amount", null))
	attributes = otlp_add_attribute(attributes, "watchdog.cost.currency", otlp_get(cost, "currency", ""))
	attributes = otlp_add_attribute(attributes, "watchdog.cost.source", otlp_get(cost, "source", ""))
	return attributes
}

func otlp_canonical_attribute_allowed(key_value) {
	key := to_lower(otlp_text(key_value, 160))
	prefixes := ["watchdog.", "gen_ai.", "openinference.", "http.", "rpc.", "db.", "messaging.", "server.", "network.", "error.", "service.", "telemetry."]
	for prefix in prefixes { if starts_with(key, prefix) { return true } }
	return false
}

func otlp_record_attributes(record, profile) {
	attributes := []
	attributes = otlp_add_attribute(attributes, "watchdog.record.id", otlp_get(record, "record_id", ""))
	attributes = otlp_add_attribute(attributes, "watchdog.record.type", otlp_get(record, "record_type", ""))
	attributes = otlp_add_attribute(attributes, "watchdog.span.kind", otlp_get(record, "kind", ""))
	attributes = otlp_add_attribute(attributes, "watchdog.mapping.profile", profile)
	attributes = otlp_add_attribute(attributes, "watchdog.exporter.contract", OTLP_EXPORTER_CONTRACT)
	source := otlp_get(record, "source", {})
	if type(source) == "dict" {
		attributes = otlp_add_attribute(attributes, "watchdog.source.producer", otlp_get(source, "producer", ""))
		attributes = otlp_add_attribute(attributes, "watchdog.source.adapter.id", otlp_get(source, "adapter_id", ""))
		attributes = otlp_add_attribute(attributes, "watchdog.source.original_schema", otlp_get(source, "original_schema", ""))
		source_fields := ["watchdog.semantic_profile", "application.name", "application.version", "harness.name", "harness.version", "runtime.name", "runtime.version", "instrumentation.name", "instrumentation.version"]
		for field in source_fields {
			if has_key(source, field) { attributes = otlp_add_attribute(attributes, "watchdog.source." + field, source[field]) }
		}
	}
	raw_attributes := otlp_get(record, "attributes", {})
	if type(raw_attributes) == "dict" {
		for key in keys(raw_attributes) {
			if otlp_canonical_attribute_allowed(key) { attributes = otlp_add_attribute(attributes, otlp_text(key, 160), raw_attributes[key]) }
		}
	}
	attributes = otlp_reference_attributes(attributes, otlp_get(record, "references", []))
	attributes = otlp_usage_attributes(attributes, otlp_get(record, "usage", null))
	attributes = otlp_cost_attributes(attributes, otlp_get(record, "costs", []))
	if profile == OTLP_OPENINFERENCE_PROFILE {
		oi_kind := otlp_openinference_kind(otlp_text(otlp_get(record, "kind", ""), 40))
		if oi_kind != "" { attributes = otlp_add_attribute(attributes, "openinference.span.kind", oi_kind) }
	}
	return attributes
}

func otlp_event(record, profile) {
	name := otlp_text(otlp_get(record, "name", "watchdog.event"), 160)
	return {"timeUnixNano": otlp_timestamp_nano(otlp_get(record, "observed_at", null)), "name": name, "attributes": otlp_record_attributes(record, profile)}
}

func otlp_record_span(record, profile) {
	trace_id := otlp_text(otlp_get(record, "trace_id", ""), 32)
	span_id := otlp_text(otlp_get(record, "span_id", ""), 16)
	record_type := otlp_text(otlp_get(record, "record_type", ""), 20)
	if span_id == "" { span_id = substring(sha256("watchdog:" + trace_id + ":" + otlp_text(otlp_get(record, "record_id", ""), 160)), 0, 16) }
	parent_span_id := otlp_text(otlp_get(record, "parent_span_id", ""), 16)
	started_at := otlp_get(record, "started_at", otlp_get(record, "observed_at", null))
	ended_at := otlp_get(record, "ended_at", started_at)
	name := otlp_text(otlp_get(record, "name", ""), 160)
	if name == "" { name = "watchdog." + record_type }
	span := {
		"traceId": trace_id,
		"spanId": span_id,
		"name": name,
		"kind": otlp_span_kind(otlp_get(record, "kind", null)),
		"startTimeUnixNano": otlp_timestamp_nano(started_at),
		"endTimeUnixNano": otlp_timestamp_nano(ended_at),
		"attributes": otlp_record_attributes(record, profile),
		"status": otlp_status(otlp_get(record, "status", "unset"))
	}
	if parent_span_id != "" { span["parentSpanId"] = parent_span_id }
	if record_type == "event" {
		span["attributes"] = otlp_add_attribute(span["attributes"], "watchdog.event.synthetic_projection", true)
		span["events"] = [otlp_event(record, profile)]
	}
	return span
}

func otlp_map(records, profile) {
	if profile != OTLP_BASE_PROFILE && profile != OTLP_GENAI_PROFILE && profile != OTLP_OPENINFERENCE_PROFILE { profile = OTLP_GENAI_PROFILE }
	spans := []
	owners := {}
	service_name := "watchdog-export"
	for record in records {
		if type(record) == "dict" && otlp_text(otlp_get(record, "record_type", ""), 20) != "event" {
			source := otlp_get(record, "source", {})
			if service_name == "watchdog-export" && type(source) == "dict" {
				next_service := otlp_text(otlp_get(source, "producer", ""), 80)
				if next_service != "" { service_name = next_service }
			}
			span_index := len(spans)
			spans = push(spans, otlp_record_span(record, profile))
			owner_span_id := otlp_text(otlp_get(record, "span_id", ""), 16)
			owner_trace_id := otlp_text(otlp_get(record, "trace_id", ""), 32)
			if owner_span_id != "" { owners[owner_trace_id + ":" + owner_span_id] = span_index }
		}
	}
	for record in records {
		if type(record) != "dict" || otlp_text(otlp_get(record, "record_type", ""), 20) != "event" { continue }
		trace_id := otlp_text(otlp_get(record, "trace_id", ""), 32)
		span_id := otlp_text(otlp_get(record, "span_id", ""), 16)
		owner_key := trace_id + ":" + span_id
		if span_id != "" && has_key(owners, owner_key) {
			owner_index := owners[owner_key]
			owner_span := spans[owner_index]
			events := otlp_get(owner_span, "events", [])
			owner_span["events"] = push(events, otlp_event(record, profile))
			spans[owner_index] = owner_span
		} else {
			spans = push(spans, otlp_record_span(record, profile))
		}
	}
	return {
		"resourceSpans": [{
			"resource": {"attributes": [otlp_attribute("service.name", service_name), otlp_attribute("telemetry.sdk.name", "kujo-watchdog"), otlp_attribute("watchdog.mapping.profile", profile)]},
			"scopeSpans": [{"scope": {"name": "kujo-watchdog", "version": OTLP_EXPORTER_CONTRACT}, "spans": spans}]
		}]
	}
}

export watchdog_otlp_map := otlp_map
export watchdog_otlp_exporter_contract := OTLP_EXPORTER_CONTRACT
