# Bounded OTLP TraceService protobuf codec. It covers the complete trace signal
# shapes Watchdog accepts and emits, including nested AnyValue values, links,
# dropped counts, flags, schema URLs, and partial-success responses. It is not a
# generic protobuf runtime and deliberately rejects unsupported wire types.

func pb_get(value, key, fallback_value) {
	if type(value) != "dict" || has_key(value, key) == 0 { return fallback_value }
	return value[key]
}

func pb_varint(value) {
	n := value
	if type(n) != "int" || n < 0 { n = 0 }
	varint_bytes := []
	while n >= 128 {
		varint_bytes = push(varint_bytes, parse_int(to_string((n % 128) + 128)))
		n = floor(n / 128)
	}
	return push(varint_bytes, parse_int(to_string(n)))
}

func pb_utf8(value) {
	raw := decode_base64(encode_base64(to_string(value)))
	return pb_byte_array(raw)
}

func pb_byte_array(raw) {
	utf8_bytes := []
	i := 0
	while i < len(raw) {
		utf8_bytes = push(utf8_bytes, raw[i])
		i = i + 1
	}
	return utf8_bytes
}

func pb_field_varint(field, value) {
	return concat(pb_varint(field * 8), pb_varint(value))
}

func pb_field_fixed64(field, bytes_value) {
	return concat(pb_varint((field * 8) + 1), bytes_value)
}

func pb_field_bytes(field, value) {
	return concat(concat(pb_varint((field * 8) + 2), pb_varint(len(value))), value)
}

func pb_field_text(field, value) {
	return pb_field_bytes(field, pb_utf8(value))
}

func pb_fixed64_integer(value) {
	n := value
	if type(n) != "int" || n < 0 { n = 0 }
	fixed_bytes := []
	i := 0
	while i < 8 {
		fixed_bytes = push(fixed_bytes, parse_int(to_string(n % 256)))
		n = floor(n / 256)
		i = i + 1
	}
	return fixed_bytes
}

func pb_fixed32_integer(value) {
	n := value
	if type(n) != "int" || n < 0 { n = 0 }
	fixed_bytes := []
	i := 0
	while i < 4 {
		fixed_bytes = push(fixed_bytes, parse_int(to_string(n % 256)))
		n = floor(n / 256)
		i = i + 1
	}
	return fixed_bytes
}

func pb_double(value) {
	n := value * 1.0
	if n == 0.0 { return [0,0,0,0,0,0,0,0] }
	sign := 0
	if n < 0.0 { sign = 1; n = 0.0 - n }
	exponent := floor(log(n) / log(2.0))
	if exponent < -1022 || exponent > 1023 { return pb_fixed64_integer(0) }
	mantissa := floor(((n / pow(2.0, exponent)) - 1.0) * 4503599627370496.0 + 0.5)
	if mantissa >= 4503599627370496 { mantissa = 0; exponent = exponent + 1 }
	biased := exponent + 1023
	double_bytes := []
	i := 0
	while i < 6 {
		double_bytes = push(double_bytes, parse_int(to_string(mantissa % 256)))
		mantissa = floor(mantissa / 256)
		i = i + 1
	}
	double_bytes = push(double_bytes, parse_int(to_string((mantissa % 16) + ((biased % 16) * 16))))
	double_bytes = push(double_bytes, parse_int(to_string(floor(biased / 16) + (sign * 128))))
	return double_bytes
}

func pb_hex(value) {
	text := to_lower(to_string(value))
	digits := "0123456789abcdef"
	hex_bytes := []
	i := 0
	while i + 1 < len(text) {
		hi := parse_int(to_string(index_of(digits, substring(text, i, i + 1))))
		lo := parse_int(to_string(index_of(digits, substring(text, i + 1, i + 2))))
		if hi < 0 || lo < 0 { return [] }
		hex_bytes = push(hex_bytes, (hi * 16) + lo)
		i = i + 2
	}
	return hex_bytes
}

func pb_any_value_depth(value, depth) {
	if depth > 8 { return pb_field_text(1, "[depth-limit]") }
	if type(value) != "dict" { return pb_field_text(1, to_string(value)) }
	if has_key(value, "stringValue") { return pb_field_text(1, value["stringValue"]) }
	if has_key(value, "boolValue") {
		bool_number := 0
		if value["boolValue"] == true { bool_number = 1 }
		return pb_field_varint(2, bool_number)
	}
	if has_key(value, "intValue") {
		int_value := value["intValue"]
		if type(int_value) == "int" && int_value >= 0 { return pb_field_varint(3, int_value) }
		return pb_field_text(1, to_string(int_value))
	}
	if has_key(value, "doubleValue") { return pb_field_fixed64(4, pb_double(value["doubleValue"])) }
	if has_key(value, "arrayValue") {
		array_message := []
		array_value := value["arrayValue"]
		if type(array_value) == "dict" {
			items := pb_get(array_value, "values", [])
			if type(items) == "array" {
				item_count := 0
				for item in items {
					if item_count < 128 { array_message = concat(array_message, pb_field_bytes(1, pb_any_value_depth(item, depth + 1))) }
					item_count = item_count + 1
				}
			}
		}
		return pb_field_bytes(5, array_message)
	}
	if has_key(value, "kvlistValue") {
		kvlist_message := []
		kvlist_value := value["kvlistValue"]
		if type(kvlist_value) == "dict" {
			items := pb_get(kvlist_value, "values", [])
			if type(items) == "array" {
				item_count := 0
				for item in items {
					if item_count < 128 { kvlist_message = concat(kvlist_message, pb_field_bytes(1, pb_key_value_depth(item, depth + 1))) }
					item_count = item_count + 1
				}
			}
		}
		return pb_field_bytes(6, kvlist_message)
	}
	if has_key(value, "bytesValue") {
		raw_bytes := decode_base64(to_string(value["bytesValue"]))
		return pb_field_bytes(7, pb_byte_array(raw_bytes))
	}
	return pb_field_text(1, "")
}

func pb_any_value(value) { return pb_any_value_depth(value, 0) }

func pb_key_value_depth(value, depth) {
	kv_bytes := pb_field_text(1, pb_get(value, "key", ""))
	return concat(kv_bytes, pb_field_bytes(2, pb_any_value_depth(pb_get(value, "value", {}), depth)))
}

func pb_key_value(value) { return pb_key_value_depth(value, 0) }

func pb_attributes(values, field) {
	attribute_bytes := []
	if type(values) != "array" { return attribute_bytes }
	for value in values { attribute_bytes = concat(attribute_bytes, pb_field_bytes(field, pb_key_value(value))) }
	return attribute_bytes
}

func pb_resource(value) {
	resource_bytes := pb_attributes(pb_get(value, "attributes", []), 1)
	dropped := pb_get(value, "droppedAttributesCount", 0)
	if dropped > 0 { resource_bytes = concat(resource_bytes, pb_field_varint(2, dropped)) }
	return resource_bytes
}

func pb_scope(value) {
	scope_bytes := []
	name := pb_get(value, "name", "")
	version := pb_get(value, "version", "")
	if name != "" { scope_bytes = concat(scope_bytes, pb_field_text(1, name)) }
	if version != "" { scope_bytes = concat(scope_bytes, pb_field_text(2, version)) }
	scope_bytes = concat(scope_bytes, pb_attributes(pb_get(value, "attributes", []), 3))
	dropped := pb_get(value, "droppedAttributesCount", 0)
	if dropped > 0 { scope_bytes = concat(scope_bytes, pb_field_varint(4, dropped)) }
	return scope_bytes
}

func pb_status(value) {
	status_bytes := []
	message := pb_get(value, "message", "")
	if message != "" { status_bytes = concat(status_bytes, pb_field_text(2, message)) }
	code := pb_get(value, "code", 0)
	if code > 0 { status_bytes = concat(status_bytes, pb_field_varint(3, code)) }
	return status_bytes
}

func pb_event(value) {
	event_bytes := pb_field_fixed64(1, pb_fixed64_integer(parse_int(to_string(pb_get(value, "timeUnixNano", "0")))))
	event_bytes = concat(event_bytes, pb_field_text(2, pb_get(value, "name", "event")))
	event_bytes = concat(event_bytes, pb_attributes(pb_get(value, "attributes", []), 3))
	dropped := pb_get(value, "droppedAttributesCount", 0)
	if dropped > 0 { event_bytes = concat(event_bytes, pb_field_varint(4, dropped)) }
	return event_bytes
}

func pb_link(value) {
	link_bytes := pb_field_bytes(1, pb_hex(pb_get(value, "traceId", "")))
	link_bytes = concat(link_bytes, pb_field_bytes(2, pb_hex(pb_get(value, "spanId", ""))))
	trace_state := pb_get(value, "traceState", "")
	if trace_state != "" { link_bytes = concat(link_bytes, pb_field_text(3, trace_state)) }
	link_bytes = concat(link_bytes, pb_attributes(pb_get(value, "attributes", []), 4))
	dropped := pb_get(value, "droppedAttributesCount", 0)
	if dropped > 0 { link_bytes = concat(link_bytes, pb_field_varint(5, dropped)) }
	flags := pb_get(value, "flags", 0)
	if flags > 0 { link_bytes = concat(link_bytes, concat(pb_varint((6 * 8) + 5), pb_fixed32_integer(flags))) }
	return link_bytes
}

func pb_span(value) {
	span_bytes := pb_field_bytes(1, pb_hex(pb_get(value, "traceId", "")))
	span_bytes = concat(span_bytes, pb_field_bytes(2, pb_hex(pb_get(value, "spanId", ""))))
	trace_state := pb_get(value, "traceState", "")
	if trace_state != "" { span_bytes = concat(span_bytes, pb_field_text(3, trace_state)) }
	parent := pb_hex(pb_get(value, "parentSpanId", ""))
	if len(parent) > 0 { span_bytes = concat(span_bytes, pb_field_bytes(4, parent)) }
	span_bytes = concat(span_bytes, pb_field_text(5, pb_get(value, "name", "span")))
	span_bytes = concat(span_bytes, pb_field_varint(6, pb_get(value, "kind", 0)))
	span_bytes = concat(span_bytes, pb_field_fixed64(7, pb_fixed64_integer(parse_int(to_string(pb_get(value, "startTimeUnixNano", "0"))))))
	span_bytes = concat(span_bytes, pb_field_fixed64(8, pb_fixed64_integer(parse_int(to_string(pb_get(value, "endTimeUnixNano", "0"))))))
	span_bytes = concat(span_bytes, pb_attributes(pb_get(value, "attributes", []), 9))
	dropped_attributes := pb_get(value, "droppedAttributesCount", 0)
	if dropped_attributes > 0 { span_bytes = concat(span_bytes, pb_field_varint(10, dropped_attributes)) }
	for event in pb_get(value, "events", []) { span_bytes = concat(span_bytes, pb_field_bytes(11, pb_event(event))) }
	dropped_events := pb_get(value, "droppedEventsCount", 0)
	if dropped_events > 0 { span_bytes = concat(span_bytes, pb_field_varint(12, dropped_events)) }
	for link in pb_get(value, "links", []) { span_bytes = concat(span_bytes, pb_field_bytes(13, pb_link(link))) }
	dropped_links := pb_get(value, "droppedLinksCount", 0)
	if dropped_links > 0 { span_bytes = concat(span_bytes, pb_field_varint(14, dropped_links)) }
	status := pb_status(pb_get(value, "status", {}))
	if len(status) > 0 { span_bytes = concat(span_bytes, pb_field_bytes(15, status)) }
	flags := pb_get(value, "flags", 0)
	if flags > 0 { span_bytes = concat(span_bytes, concat(pb_varint((16 * 8) + 5), pb_fixed32_integer(flags))) }
	return span_bytes
}

func pb_scope_spans(value) {
	scope_spans_bytes := pb_field_bytes(1, pb_scope(pb_get(value, "scope", {})))
	for span in pb_get(value, "spans", []) { scope_spans_bytes = concat(scope_spans_bytes, pb_field_bytes(2, pb_span(span))) }
	schema_url := pb_get(value, "schemaUrl", "")
	if schema_url != "" { scope_spans_bytes = concat(scope_spans_bytes, pb_field_text(3, schema_url)) }
	return scope_spans_bytes
}

func pb_resource_spans(value) {
	resource_spans_bytes := pb_field_bytes(1, pb_resource(pb_get(value, "resource", {})))
	for scope_spans in pb_get(value, "scopeSpans", []) { resource_spans_bytes = concat(resource_spans_bytes, pb_field_bytes(2, pb_scope_spans(scope_spans))) }
	schema_url := pb_get(value, "schemaUrl", "")
	if schema_url != "" { resource_spans_bytes = concat(resource_spans_bytes, pb_field_text(3, schema_url)) }
	return resource_spans_bytes
}

export watchdog_otlp_protobuf_encode := func(payload) {
	request_bytes := []
	for resource_spans in pb_get(payload, "resourceSpans", []) { request_bytes = concat(request_bytes, pb_field_bytes(1, pb_resource_spans(resource_spans))) }
	return bytes(request_bytes)
}

func pb_decode_varint(data, offset) {
	value := 0
	multiplier := 1
	i := offset
	count := 0
	while i < len(data) && count < 10 {
		byte_value := data[i]
		value = value + ((byte_value % 128) * multiplier)
		i = i + 1
		if byte_value < 128 { return {"ok": true, "value": value, "offset": i} }
		multiplier = multiplier * 128
		count = count + 1
	}
	return {"ok": false, "value": 0, "offset": i}
}

# Decodes only ExportTraceServiceResponse.partial_success.rejected_spans.
# Malformed or unsupported responses are reported as -1 so the worker retries.
export watchdog_otlp_protobuf_rejected_spans := func(data) {
	if type(data) != "bytes" || len(data) == 0 { return 0 }
	outer_key := pb_decode_varint(data, 0)
	if outer_key["ok"] == false || outer_key["value"] != 10 { return -1 }
	outer_length := pb_decode_varint(data, outer_key["offset"])
	if outer_length["ok"] == false { return -1 }
	start := outer_length["offset"]
	end := start + outer_length["value"]
	if end > len(data) { return -1 }
	if start == end { return 0 }
	inner_key := pb_decode_varint(data, start)
	if inner_key["ok"] == false { return -1 }
	if inner_key["value"] != 8 { return 0 }
	rejected := pb_decode_varint(data, inner_key["offset"])
	if rejected["ok"] == false { return -1 }
	return rejected["value"]
}

func pb_bytes_text(data) {
	return decode_base64_utf8(encode_base64(data))
}

func pb_bytes_hex(data) {
	digits := "0123456789abcdef"
	hex_text := ""
	i := 0
	while i < len(data) {
		byte_value := data[i]
		hex_text = hex_text + substring(digits, floor(byte_value / 16), floor(byte_value / 16) + 1)
		hex_text = hex_text + substring(digits, byte_value % 16, (byte_value % 16) + 1)
		i = i + 1
	}
	return hex_text
}

func pb_fixed64_decode(data) {
	decoded_value := 0
	multiplier := 1
	i := 0
	while i < 8 && i < len(data) {
		decoded_value = decoded_value + (data[i] * multiplier)
		if i < 7 { multiplier = multiplier * 256 }
		i = i + 1
	}
	return decoded_value
}

func pb_fixed32_decode(data) {
	decoded_value := 0
	multiplier := 1
	i := 0
	while i < 4 && i < len(data) {
		decoded_value = decoded_value + (data[i] * multiplier)
		if i < 3 { multiplier = multiplier * 256 }
		i = i + 1
	}
	return decoded_value
}

func pb_double_decode(data) {
	if len(data) != 8 { return 0.0 }
	mantissa := 0
	multiplier := 1
	i := 0
	while i < 6 {
		mantissa = mantissa + (data[i] * multiplier)
		multiplier = multiplier * 256
		i = i + 1
	}
	mantissa = mantissa + ((data[6] % 16) * multiplier)
	biased := floor(data[6] / 16) + ((data[7] % 128) * 16)
	if biased == 0 && mantissa == 0 { return 0.0 }
	sign := 1.0
	if data[7] >= 128 { sign = -1.0 }
	return sign * (1.0 + (mantissa / 4503599627370496.0)) * pow(2.0, biased - 1023)
}

func pb_parse_fields(data) {
	parsed_fields := []
	offset := 0
	field_count := 0
	while offset < len(data) && field_count < 10000 {
		key_result := pb_decode_varint(data, offset)
		if key_result["ok"] == false { return {"ok": false, "fields": [], "error": "malformed protobuf field key"} }
		offset = key_result["offset"]
		field_number := floor(key_result["value"] / 8)
		wire_type := key_result["value"] % 8
		if field_number <= 0 { return {"ok": false, "fields": [], "error": "invalid protobuf field number"} }
		if wire_type == 0 {
			varint_result := pb_decode_varint(data, offset)
			if varint_result["ok"] == false { return {"ok": false, "fields": [], "error": "malformed protobuf varint"} }
			offset = varint_result["offset"]
			parsed_fields = push(parsed_fields, {"number": field_number, "wire": wire_type, "value": varint_result["value"]})
		} else if wire_type == 1 {
			if offset + 8 > len(data) { return {"ok": false, "fields": [], "error": "truncated protobuf fixed64"} }
			parsed_fields = push(parsed_fields, {"number": field_number, "wire": wire_type, "value": slice(data, offset, offset + 8)})
			offset = offset + 8
		} else if wire_type == 2 {
			length_result := pb_decode_varint(data, offset)
			if length_result["ok"] == false { return {"ok": false, "fields": [], "error": "malformed protobuf length"} }
			offset = length_result["offset"]
			field_end := offset + length_result["value"]
			if field_end > len(data) { return {"ok": false, "fields": [], "error": "truncated protobuf message"} }
			parsed_fields = push(parsed_fields, {"number": field_number, "wire": wire_type, "value": slice(data, offset, field_end)})
			offset = field_end
		} else if wire_type == 5 {
			if offset + 4 > len(data) { return {"ok": false, "fields": [], "error": "truncated protobuf fixed32"} }
			parsed_fields = push(parsed_fields, {"number": field_number, "wire": wire_type, "value": slice(data, offset, offset + 4)})
			offset = offset + 4
		} else {
			return {"ok": false, "fields": [], "error": "unsupported protobuf wire type"}
		}
		field_count = field_count + 1
	}
	if offset != len(data) { return {"ok": false, "fields": [], "error": "protobuf field bound exceeded"} }
	return {"ok": true, "fields": parsed_fields, "error": ""}
}

func pb_fields_number(fields, number) {
	matches := []
	for field in fields { if field["number"] == number { matches = push(matches, field) } }
	return matches
}

func pb_first_field(fields, number) {
	for field in fields { if field["number"] == number { return field } }
	return null
}

func pb_parse_any_value_depth(data, depth) {
	if depth > 8 { return {"stringValue": "[depth-limit]"} }
	parsed_any := pb_parse_fields(data)
	if parsed_any["ok"] == false { return {"stringValue": ""} }
	field := pb_first_field(parsed_any["fields"], 1)
	if field != null { return {"stringValue": pb_bytes_text(field["value"])} }
	field = pb_first_field(parsed_any["fields"], 2)
	if field != null { return {"boolValue": field["value"] != 0} }
	field = pb_first_field(parsed_any["fields"], 3)
	if field != null { return {"intValue": field["value"]} }
	field = pb_first_field(parsed_any["fields"], 4)
	if field != null { return {"doubleValue": pb_double_decode(field["value"])} }
	field = pb_first_field(parsed_any["fields"], 5)
	if field != null {
		parsed_array := pb_parse_fields(field["value"])
		array_values := []
		if parsed_array["ok"] {
			item_count := 0
			for item_field in pb_fields_number(parsed_array["fields"], 1) {
				if item_count < 128 { array_values = push(array_values, pb_parse_any_value_depth(item_field["value"], depth + 1)) }
				item_count = item_count + 1
			}
		}
		return {"arrayValue": {"values": array_values}}
	}
	field = pb_first_field(parsed_any["fields"], 6)
	if field != null {
		parsed_kvlist := pb_parse_fields(field["value"])
		kv_values := []
		if parsed_kvlist["ok"] {
			item_count := 0
			for item_field in pb_fields_number(parsed_kvlist["fields"], 1) {
				if item_count < 128 {
					item := pb_parse_key_value_depth(item_field["value"], depth + 1)
					if item != null { kv_values = push(kv_values, item) }
				}
				item_count = item_count + 1
			}
		}
		return {"kvlistValue": {"values": kv_values}}
	}
	field = pb_first_field(parsed_any["fields"], 7)
	if field != null { return {"bytesValue": encode_base64(field["value"])} }
	return {"stringValue": ""}
}

func pb_parse_any_value(data) { return pb_parse_any_value_depth(data, 0) }

func pb_parse_key_value_depth(data, depth) {
	parsed_key_value := pb_parse_fields(data)
	if parsed_key_value["ok"] == false { return null }
	key_field := pb_first_field(parsed_key_value["fields"], 1)
	value_field := pb_first_field(parsed_key_value["fields"], 2)
	if key_field == null || value_field == null { return null }
	return {"key": pb_bytes_text(key_field["value"]), "value": pb_parse_any_value_depth(value_field["value"], depth)}
}

func pb_parse_key_value(data) { return pb_parse_key_value_depth(data, 0) }

func pb_parse_attributes(fields, number) {
	attribute_values := []
	for field in pb_fields_number(fields, number) {
		attribute := pb_parse_key_value(field["value"])
		if attribute != null { attribute_values = push(attribute_values, attribute) }
	}
	return attribute_values
}

func pb_parse_status(data) {
	parsed_status := pb_parse_fields(data)
	if parsed_status["ok"] == false { return {} }
	status_value := {}
	message := pb_first_field(parsed_status["fields"], 2)
	if message != null { status_value["message"] = pb_bytes_text(message["value"]) }
	code := pb_first_field(parsed_status["fields"], 3)
	if code != null { status_value["code"] = code["value"] }
	return status_value
}

func pb_parse_event(data) {
	parsed_event := pb_parse_fields(data)
	if parsed_event["ok"] == false { return null }
	event_value := {"timeUnixNano": "0", "name": "event", "attributes": pb_parse_attributes(parsed_event["fields"], 3)}
	time_field := pb_first_field(parsed_event["fields"], 1)
	if time_field != null { event_value["timeUnixNano"] = to_string(pb_fixed64_decode(time_field["value"])) }
	name_field := pb_first_field(parsed_event["fields"], 2)
	if name_field != null { event_value["name"] = pb_bytes_text(name_field["value"]) }
	dropped_field := pb_first_field(parsed_event["fields"], 4)
	if dropped_field != null { event_value["droppedAttributesCount"] = dropped_field["value"] }
	return event_value
}

func pb_parse_link(data) {
	parsed_link := pb_parse_fields(data)
	if parsed_link["ok"] == false { return null }
	trace_field := pb_first_field(parsed_link["fields"], 1)
	span_field := pb_first_field(parsed_link["fields"], 2)
	if trace_field == null || span_field == null { return null }
	link_value := {"traceId": pb_bytes_hex(trace_field["value"]), "spanId": pb_bytes_hex(span_field["value"]), "attributes": pb_parse_attributes(parsed_link["fields"], 4)}
	trace_state_field := pb_first_field(parsed_link["fields"], 3)
	if trace_state_field != null { link_value["traceState"] = pb_bytes_text(trace_state_field["value"]) }
	dropped_field := pb_first_field(parsed_link["fields"], 5)
	if dropped_field != null { link_value["droppedAttributesCount"] = dropped_field["value"] }
	flags_field := pb_first_field(parsed_link["fields"], 6)
	if flags_field != null { link_value["flags"] = pb_fixed32_decode(flags_field["value"]) }
	return link_value
}

func pb_parse_span(data) {
	parsed_span := pb_parse_fields(data)
	if parsed_span["ok"] == false { return null }
	trace_field := pb_first_field(parsed_span["fields"], 1)
	span_field := pb_first_field(parsed_span["fields"], 2)
	if trace_field == null || span_field == null { return null }
	span_value := {"traceId": pb_bytes_hex(trace_field["value"]), "spanId": pb_bytes_hex(span_field["value"]), "name": "span", "kind": 0, "startTimeUnixNano": "0", "endTimeUnixNano": "0", "attributes": pb_parse_attributes(parsed_span["fields"], 9), "events": [], "links": [], "status": {}}
	trace_state_field := pb_first_field(parsed_span["fields"], 3)
	if trace_state_field != null { span_value["traceState"] = pb_bytes_text(trace_state_field["value"]) }
	parent_field := pb_first_field(parsed_span["fields"], 4)
	if parent_field != null { span_value["parentSpanId"] = pb_bytes_hex(parent_field["value"]) }
	name_field := pb_first_field(parsed_span["fields"], 5)
	if name_field != null { span_value["name"] = pb_bytes_text(name_field["value"]) }
	kind_field := pb_first_field(parsed_span["fields"], 6)
	if kind_field != null { span_value["kind"] = kind_field["value"] }
	start_field := pb_first_field(parsed_span["fields"], 7)
	if start_field != null { span_value["startTimeUnixNano"] = to_string(pb_fixed64_decode(start_field["value"])) }
	end_field := pb_first_field(parsed_span["fields"], 8)
	if end_field != null { span_value["endTimeUnixNano"] = to_string(pb_fixed64_decode(end_field["value"])) }
	dropped_attributes_field := pb_first_field(parsed_span["fields"], 10)
	if dropped_attributes_field != null { span_value["droppedAttributesCount"] = dropped_attributes_field["value"] }
	event_values := []
	for event_field in pb_fields_number(parsed_span["fields"], 11) {
		event_value := pb_parse_event(event_field["value"])
		if event_value != null { event_values = push(event_values, event_value) }
	}
	span_value["events"] = event_values
	dropped_events_field := pb_first_field(parsed_span["fields"], 12)
	if dropped_events_field != null { span_value["droppedEventsCount"] = dropped_events_field["value"] }
	link_values := []
	for link_field in pb_fields_number(parsed_span["fields"], 13) {
		link_value := pb_parse_link(link_field["value"])
		if link_value != null { link_values = push(link_values, link_value) }
	}
	span_value["links"] = link_values
	dropped_links_field := pb_first_field(parsed_span["fields"], 14)
	if dropped_links_field != null { span_value["droppedLinksCount"] = dropped_links_field["value"] }
	status_field := pb_first_field(parsed_span["fields"], 15)
	if status_field != null { span_value["status"] = pb_parse_status(status_field["value"]) }
	flags_field := pb_first_field(parsed_span["fields"], 16)
	if flags_field != null { span_value["flags"] = pb_fixed32_decode(flags_field["value"]) }
	return span_value
}

func pb_parse_scope(data) {
	parsed_scope := pb_parse_fields(data)
	if parsed_scope["ok"] == false { return {} }
	scope_value := {"attributes": pb_parse_attributes(parsed_scope["fields"], 3)}
	name_field := pb_first_field(parsed_scope["fields"], 1)
	if name_field != null { scope_value["name"] = pb_bytes_text(name_field["value"]) }
	version_field := pb_first_field(parsed_scope["fields"], 2)
	if version_field != null { scope_value["version"] = pb_bytes_text(version_field["value"]) }
	dropped_field := pb_first_field(parsed_scope["fields"], 4)
	if dropped_field != null { scope_value["droppedAttributesCount"] = dropped_field["value"] }
	return scope_value
}

func pb_parse_scope_spans(data) {
	parsed_scope_spans := pb_parse_fields(data)
	if parsed_scope_spans["ok"] == false { return null }
	scope_spans_value := {"scope": {}, "spans": []}
	scope_field := pb_first_field(parsed_scope_spans["fields"], 1)
	if scope_field != null { scope_spans_value["scope"] = pb_parse_scope(scope_field["value"]) }
	span_values := []
	for span_field in pb_fields_number(parsed_scope_spans["fields"], 2) {
		span_value := pb_parse_span(span_field["value"])
