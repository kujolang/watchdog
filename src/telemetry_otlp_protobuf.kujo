}

func pb_parse_resource_spans(data) {
	parsed_resource_spans := pb_parse_fields(data)
	if parsed_resource_spans["ok"] == false { return null }
	resource_spans_value := {"resource": {"attributes": []}, "scopeSpans": []}
	resource_field := pb_first_field(parsed_resource_spans["fields"], 1)
	if resource_field != null { resource_spans_value["resource"] = pb_parse_resource(resource_field["value"]) }
	scope_values := []
	for scope_field in pb_fields_number(parsed_resource_spans["fields"], 2) {
		scope_value := pb_parse_scope_spans(scope_field["value"])
		if scope_value != null { scope_values = push(scope_values, scope_value) }
	}
	resource_spans_value["scopeSpans"] = scope_values
	schema_url_field := pb_first_field(parsed_resource_spans["fields"], 3)
	if schema_url_field != null { resource_spans_value["schemaUrl"] = pb_bytes_text(schema_url_field["value"]) }
	return resource_spans_value
}

export watchdog_otlp_protobuf_decode := func(data) {
	if type(data) != "bytes" { return {"ok": false, "payload": {}, "error": "protobuf input must be bytes"} }
	parsed_request := pb_parse_fields(data)
	if parsed_request["ok"] == false { return {"ok": false, "payload": {}, "error": parsed_request["error"]} }
	resource_values := []
	for resource_field in pb_fields_number(parsed_request["fields"], 1) {
		resource_value := pb_parse_resource_spans(resource_field["value"])
		if resource_value != null { resource_values = push(resource_values, resource_value) }
	}
	if len(resource_values) == 0 { return {"ok": false, "payload": {}, "error": "protobuf request contains no resource spans"} }
	return {"ok": true, "payload": {"resourceSpans": resource_values}, "error": ""}
}

export watchdog_otlp_protobuf_encode_response := func(rejected_spans, error_message) {
	if rejected_spans <= 0 && trim(to_string(error_message)) == "" { return bytes([]) }
	partial_bytes := []
	if rejected_spans > 0 { partial_bytes = concat(partial_bytes, pb_field_varint(1, rejected_spans)) }
	if trim(to_string(error_message)) != "" { partial_bytes = concat(partial_bytes, pb_field_text(2, error_message)) }
	return bytes(pb_field_bytes(1, partial_bytes))
}
