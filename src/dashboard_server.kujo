db := db_connect("sqlite", DB_PATH)
watchdog_ensure_schema(db)
db_execute(db, "INSERT OR IGNORE INTO backup_settings (id, enabled, interval_minutes, backup_dir, retention_count, encryption_enabled, updated_at_ms) VALUES (1, ?, ?, ?, ?, ?, ?)", [BACKUP_DEFAULT_ENABLED, BACKUP_DEFAULT_INTERVAL_MINUTES, BACKUP_DEFAULT_DIR, BACKUP_DEFAULT_RETENTION_COUNT, BACKUP_DEFAULT_ENCRYPTION_ENABLED, current_timestamp()])

print("Database ready: " + DB_PATH)

# ---------------------------------------------------------------------------
# Logging helpers
# ---------------------------------------------------------------------------

func insert_request_row(session_id, user_id, tenant_id, project_id, workflow_id, task_id, correlation_id, provider, model, request_id, status, input_tokens, output_tokens, total_tokens, cost_usd, latency_ms, finish_reason, error_code, error_message, prompt_summary, response_summary) {
	ts := to_string(current_timestamp())
	source_app := "watchdog-proxy"
	clean_error_message := redact_sensitive_text(error_message)
	clean_prompt_summary := redact_sensitive_text(prompt_summary)
	clean_response_summary := redact_sensitive_text(response_summary)
	db_execute(db, "INSERT INTO requests (session_id, user_id, tenant_id, project_id, workflow_id, task_id, correlation_id, provider, model, request_id, status, input_tokens, output_tokens, total_tokens, cost_usd, latency_ms, finish_reason, error_code, error_message, prompt_summary, response_summary, source_app, data_class, created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)", [session_id, user_id, tenant_id, project_id, workflow_id, task_id, correlation_id, provider, model, request_id, status, input_tokens, output_tokens, total_tokens, cost_usd, latency_ms, finish_reason, error_code, clean_error_message, clean_prompt_summary, clean_response_summary, source_app, "live", ts])

	rows := db_query(db, "SELECT last_insert_rowid() AS id", [])
	if len(rows) > 0 {
		return rows[0]["id"]
	}
	return 0
}

func insert_tool_call_row(request_dbid, session_id, tool_name, tool_args, tool_result, status, latency_ms) {
	ts := to_string(current_timestamp())
	args_str := tool_args
	if type(tool_args) == "dict" {
		args_str := to_json(redact_dict_shallow(tool_args))
	} else {
		args_str := redact_sensitive_text(args_str)
	}
	result_str := tool_result
	if type(tool_result) == "dict" {
		result_str := to_json(redact_dict_shallow(tool_result))
	} else {
		result_str := redact_sensitive_text(result_str)
	}
	db_execute(db, "INSERT INTO tool_calls (request_dbid, session_id, tool_name, tool_args, tool_result, status, latency_ms, source_app, data_class, created_at) VALUES (?,?,?,?,?,?,?,?,?,?)", [request_dbid, session_id, tool_name, args_str, result_str, status, latency_ms, "watchdog-proxy", "live", ts])
}

func next_step_number(session_id) {
	rows := db_query(db, "SELECT COALESCE(MAX(step_number), 0) AS n FROM agent_steps WHERE session_id = ?", [session_id])
	if len(rows) == 0 {
		return 1
	}
	return to_int_or_zero(rows[0]["n"]) + 1
}

func insert_agent_step_row(session_id, agent_id, step_type, content, metadata) {
	step_number := next_step_number(session_id)
	ts := to_string(current_timestamp())
	meta_str := metadata
	if type(metadata) == "dict" {
		meta_str := to_json(redact_dict_shallow(metadata))
	} else {
		meta_str := redact_sensitive_text(meta_str)
	}
	clean_content := truncate_str(redact_sensitive_text(content), 500)
	db_execute(db, "INSERT INTO agent_steps (session_id, agent_id, step_number, step_type, content, metadata, source_app, data_class, created_at) VALUES (?,?,?,?,?,?,?,?,?)", [session_id, agent_id, step_number, step_type, clean_content, meta_str, "watchdog-proxy", "live", ts])
}

func external_text(body, key, fallback_value, max_len) {
	value := trim(to_string(safe_dict_get(body, key, fallback_value)))
	return truncate_str(redact_sensitive_text(value), max_len)
}

func external_json_summary(value, max_len) {
	if type(value) == "dict" || type(value) == "array" {
		return truncate_str(to_json(redact_json_value(value)), max_len)
	}
	return truncate_str(redact_sensitive_text(to_string(value)), max_len)
}

func negative_token_metric_error(body) {
	containers := [body, safe_dict_get(body, "trace", {})]
	fields := ["input_tokens", "output_tokens", "total_tokens", "cached_input_tokens", "cache_write_input_tokens"]
	for container in containers {
		if type(container) == "dict" {
			for field in fields {
				if has_key(container, field) && to_int_or_zero(container[field]) < 0 {
					return field + " must be a non-negative integer"
				}
			}
		}
	}
	return ""
}

func telemetry_schema_error(body) {
	version := external_text(body, "schema_version", TELEMETRY_SCHEMA_VERSION, 80)
	if version != TELEMETRY_SCHEMA_VERSION {
		return "Unsupported telemetry schema_version: " + version
	}
	return ""
}

func canonical_policy_privacy(record) {
	incoming_privacy := safe_dict_get(record, "privacy", {})
	transformations := []
	if type(incoming_privacy) == "dict" {
		raw_transformations := safe_dict_get(incoming_privacy, "transformations", [])
		if type(raw_transformations) == "array" {
			for item in raw_transformations {
				if len(transformations) < 31 {
					value := truncate_str(redact_sensitive_text(to_string(item)), 80)
					if value != "" { transformations = push(transformations, value) }
				}
			}
		}
	}
	incoming_content := safe_dict_get(record, "content", [])
	if type(incoming_content) == "array" && len(incoming_content) > 0 && len(transformations) < 32 {
		transformations = push(transformations, "content_dropped_by_watchdog_policy")
	}
	return {
		"content_mode": "off",
		"policy_version": "watchdog.privacy.v1",
		"transformations": transformations
	}
}

func canonical_policy_scalar(value) {
	if type(value) == "string" { return redact_sensitive_text(value) }
	if type(value) == "integer" || type(value) == "float" || type(value) == "bool" || type(value) == "boolean" || type(value) == "null" { return value }
	return null
}

func canonical_policy_scalar_map(value, max_properties) {
	clean := {}
	if type(value) != "dict" { return clean }
	count := 0
	for key in keys(value) {
		if count < max_properties {
			next := value[key]
			if type(next) != "dict" && type(next) != "array" {
				clean[truncate_str(to_string(key), 160)] = canonical_policy_scalar(next)
				count = count + 1
			}
		}
	}
	return clean
}

func canonical_policy_attributes(value) {
	clean := {}
	if type(value) != "dict" { return clean }
	count := 0
	for key in keys(value) {
		if count < 128 {
			next := value[key]
			if type(next) == "array" {
				items := []
				for item in next {
					if len(items) < 32 && type(item) != "dict" && type(item) != "array" { items = push(items, canonical_policy_scalar(item)) }
				}
				clean[truncate_str(to_string(key), 160)] = items
				count = count + 1
			} else if type(next) != "dict" {
				clean[truncate_str(to_string(key), 160)] = canonical_policy_scalar(next)
				count = count + 1
			}
		}
	}
	return clean
}

func canonical_policy_timing(record, attributes) {
	if type(attributes) != "dict" { return {} }
	timing_source := to_string(safe_dict_get(attributes, "watchdog.timing.source", ""))
	if timing_source == "unavailable_buffered_transport" {
		attributes["watchdog.time_to_first_output_ms"] = null
		attributes["watchdog.output_generation_duration_ms"] = null
		attributes["watchdog.output_tokens_per_second"] = null
		return attributes
	}
	duration := safe_dict_get(attributes, "watchdog.output_generation_duration_ms", null)
	usage := safe_dict_get(record, "usage", null)
	output_tokens := null
	if type(usage) == "dict" { output_tokens = safe_dict_get(usage, "output_tokens", null) }
	if type(duration) != "null" && type(output_tokens) != "null" {
		duration_number := to_float_or_zero(duration)
		output_number := to_float_or_zero(output_tokens)
		if duration_number > 0.0 && output_number > 0.0 {
			attributes["watchdog.output_tokens_per_second"] = output_number * 1000.0 / duration_number
		} else {
			attributes["watchdog.output_tokens_per_second"] = null
		}
	}
	return attributes
}

func canonical_policy_context(record, attributes) {
	if type(attributes) != "dict" { return {} }
	window_tokens := safe_dict_get(attributes, "watchdog.context.window_tokens", null)
	usage := safe_dict_get(record, "usage", null)
	total_tokens := null
	total_semantics := ""
	if type(usage) == "dict" {
		total_tokens = safe_dict_get(usage, "total_tokens", null)
		total_semantics = to_string(safe_dict_get(usage, "total_semantics", ""))
	}
	if type(window_tokens) == "null" || type(total_tokens) == "null" || total_semantics != "input_plus_output" {
		attributes["watchdog.context.utilization_ratio"] = null
		attributes["watchdog.context.pressure"] = "unknown"
		return attributes
	}
	window_number := to_float_or_zero(window_tokens)
	total_number := to_float_or_zero(total_tokens)
	if window_number <= 0.0 || total_number < 0.0 {
		attributes["watchdog.context.utilization_ratio"] = null
		attributes["watchdog.context.pressure"] = "unknown"
		return attributes
	}
	ratio := total_number / window_number
	pressure := "normal"
	if ratio > 1.0 { pressure = "overflow" } else if ratio >= CONTEXT_CRITICAL_RATIO { pressure = "critical" } else if ratio >= CONTEXT_WARNING_RATIO { pressure = "warning" }
	attributes["watchdog.context.utilization_ratio"] = ratio
	attributes["watchdog.context.pressure"] = pressure
	return attributes
}

func canonical_policy_references(value) {
	clean := []
	if type(value) != "array" { return clean }
	for reference in value {
		if len(clean) < 24 && type(reference) == "dict" {
			clean = push(clean, {
				"type": truncate_str(to_string(safe_dict_get(reference, "type", "external")), 40),
				"id": truncate_str(redact_sensitive_text(to_string(safe_dict_get(reference, "id", ""))), 160),
				"namespace": truncate_str(to_string(safe_dict_get(reference, "namespace", "")), 80),
				"relation": truncate_str(to_string(safe_dict_get(reference, "relation", "")), 40)
			})
		}
	}
	return clean
}

func canonical_policy_usage(value) {
	if type(value) != "dict" { return null }
	return {
		"input_tokens": safe_dict_get(value, "input_tokens", null),
		"output_tokens": safe_dict_get(value, "output_tokens", null),
		"total_tokens": safe_dict_get(value, "total_tokens", null),
		"cached_input_tokens": safe_dict_get(value, "cached_input_tokens", null),
		"cache_write_input_tokens": safe_dict_get(value, "cache_write_input_tokens", null),
		"reasoning_tokens": safe_dict_get(value, "reasoning_tokens", null),
		"usage_source": redact_sensitive_text(to_string(safe_dict_get(value, "usage_source", ""))),
		"total_semantics": redact_sensitive_text(to_string(safe_dict_get(value, "total_semantics", ""))),
		"provider_usage": canonical_policy_scalar_map(safe_dict_get(value, "provider_usage", {}), 32)
	}
}

func canonical_policy_costs(value) {
	clean := []
	if type(value) != "array" { return clean }
	for cost in value {
		if len(clean) < 8 && type(cost) == "dict" {
			clean = push(clean, {
				"kind": truncate_str(to_string(safe_dict_get(cost, "kind", "unknown")), 40),
				"currency": truncate_str(to_string(safe_dict_get(cost, "currency", "USD")), 3),
				"amount": safe_dict_get(cost, "amount", null),
				"source": truncate_str(redact_sensitive_text(to_string(safe_dict_get(cost, "source", "unknown"))), 120),
				"catalog_version": safe_dict_get(cost, "catalog_version", null),
				"calculated_at": safe_dict_get(cost, "calculated_at", null),
				"components": canonical_policy_scalar_map(safe_dict_get(cost, "components", {}), 16)
			})
		}
	}
	return clean
}

func canonical_policy_error(value) {
	if type(value) != "dict" { return null }
	return {
		"class": redact_sensitive_text(to_string(safe_dict_get(value, "class", ""))),
		"category": redact_sensitive_text(to_string(safe_dict_get(value, "category", ""))),
		"code": redact_sensitive_text(to_string(safe_dict_get(value, "code", ""))),
		"retryable": safe_dict_get(value, "retryable", null),
		"message": truncate_str(redact_sensitive_text(to_string(safe_dict_get(value, "message", ""))), 1000)
	}
}

func canonical_policy_record(record) {
	clean_attributes := canonical_policy_context(record, canonical_policy_timing(record, canonical_policy_attributes(safe_dict_get(record, "attributes", {}))))
	return {
		"record_id": truncate_str(trim(to_string(safe_dict_get(record, "record_id", ""))), 160),
		"record_type": truncate_str(trim(to_string(safe_dict_get(record, "record_type", ""))), 20),
		"trace_id": truncate_str(trim(to_string(safe_dict_get(record, "trace_id", ""))), 32),
		"span_id": safe_dict_get(record, "span_id", null),
		"parent_span_id": safe_dict_get(record, "parent_span_id", null),
		"observed_at": truncate_str(trim(to_string(safe_dict_get(record, "observed_at", ""))), 80),
		"started_at": safe_dict_get(record, "started_at", null),
		"ended_at": safe_dict_get(record, "ended_at", null),
		"kind": safe_dict_get(record, "kind", null),
		"name": safe_dict_get(record, "name", null),
		"status": truncate_str(trim(to_string(safe_dict_get(record, "status", "unset"))), 20),
		"source": canonical_policy_scalar_map(safe_dict_get(record, "source", {}), 16),
		"references": canonical_policy_references(safe_dict_get(record, "references", [])),
		"attributes": clean_attributes,
		"usage": canonical_policy_usage(safe_dict_get(record, "usage", null)),
		"costs": canonical_policy_costs(safe_dict_get(record, "costs", [])),
		"error": canonical_policy_error(safe_dict_get(record, "error", null)),
		"content": [],
		"privacy": canonical_policy_privacy(record)
	}
}

func canonical_policy_batch(body) {
	producer := safe_dict_get(body, "producer", {})
	clean_producer := {
		"name": truncate_str(trim(to_string(safe_dict_get(producer, "name", "external"))), 80),
		"version": truncate_str(trim(to_string(safe_dict_get(producer, "version", "unknown"))), 40),
		"adapter_id": safe_dict_get(producer, "adapter_id", null),
		"adapter_version": safe_dict_get(producer, "adapter_version", null),
		"original_schema": safe_dict_get(producer, "original_schema", null)
	}
	clean_records := []
	records := safe_dict_get(body, "records", [])
	if type(records) == "array" {
		for record in records {
			if len(clean_records) < 100 && type(record) == "dict" {
				clean_records = push(clean_records, canonical_policy_record(record))
			}
		}
	}
	return {
		"schema_version": CANONICAL_TELEMETRY_SCHEMA_VERSION,
		"batch_id": truncate_str(trim(to_string(safe_dict_get(body, "batch_id", ""))), 160),
		"sent_at": safe_dict_get(body, "sent_at", null),
		"producer": clean_producer,
		"records": clean_records
	}
}

func jsonl_v2_cursor(sequence) {
	payload := "v2:" + to_string(sequence)
	return payload + ":" + substring(hmac_sha256(JSONL_CURSOR_SECRET, payload), 0, 24)
}

func jsonl_v2_cursor_sequence(cursor_value) {
	cursor_text := trim(to_string(cursor_value))
	if cursor_text == "" { return {"ok": true, "sequence": 0} }
	parts := split(cursor_text, ":")
	if len(parts) != 3 || parts[0] != "v2" { return {"ok": false, "sequence": 0} }
	payload := parts[0] + ":" + parts[1]
	expected := substring(hmac_sha256(JSONL_CURSOR_SECRET, payload), 0, 24)
	if parts[2] != expected { return {"ok": false, "sequence": 0} }
	sequence := to_int_or_zero(parts[1])
	if sequence < 0 { return {"ok": false, "sequence": 0} }
	return {"ok": true, "sequence": sequence}
}

func jsonl_v2_response(rows, exported_at, start_cursor) {
	lines := []
	last_sequence := start_cursor
	for row in rows {
		parsed := parse_json_safe(row["canonical_json"])
		if parsed["ok"] {
			sequence := to_int_or_zero(row["id"])
			lines = push(lines, to_json({
				"jsonl_version": JSONL_V2_VERSION,
				"schema_version": CANONICAL_TELEMETRY_SCHEMA_VERSION,
				"exported_at": exported_at,
				"producer": row["producer_name"],
				"record_id": row["record_id"],
				"sequence": sequence,
				"record": parsed["data"]
			}))
			last_sequence = sequence
		}
	}
	body := join(lines, "\n")
	next_cursor := jsonl_v2_cursor(last_sequence)
	manifest := {
		"jsonl_version": JSONL_V2_VERSION,
		"schema_version": CANONICAL_TELEMETRY_SCHEMA_VERSION,
		"exported_at": exported_at,
		"record_count": len(lines),
		"first_sequence_exclusive": start_cursor,
		"last_sequence_inclusive": last_sequence,
		"next_cursor": next_cursor,
		"sha256": sha256(body)
	}
	response := http_response(200, body)
	response = set_header(response, "Content-Type", "application/x-ndjson")
	response = set_header(response, "X-Watchdog-JSONL-Version", JSONL_V2_VERSION)
	response = set_header(response, "X-Watchdog-Next-Cursor", next_cursor)
	response = set_header(response, "X-Watchdog-Record-Count", to_string(len(lines)))
	response = set_header(response, "X-Watchdog-SHA256", manifest["sha256"])
	response = set_header(response, "X-Watchdog-Manifest", encode_base64(to_json(manifest)))
	return apply_default_security_headers(response)
}

func persist_approved_canonical_batch(approved) {
	result := watchdog_telemetry_repository_insert(db, approved)
	if result["ok"] && result["deduplicated"] == false && len(EXPORTER_PROFILE_IDS) > 0 {
		delivery := watchdog_delivery_enqueue_batch(db, EXPORTER_PROFILE_IDS, result["batch_dbid"], EXPORT_QUEUE_MAX_RECORDS, EXPORT_QUEUE_MAX_BYTES)
		result["delivery"] = delivery
		if delivery["dropped"] > 0 {
			insert_audit_event("telemetry_export_queue_drop", "system", "warning", delivery)
		}
	}
	return result
}

func persist_fast_approved_canonical_batch(approved) {
	result := watchdog_telemetry_repository_insert_fast(db, approved)
	if result["ok"] && result["deduplicated"] == false && len(EXPORTER_PROFILE_IDS) > 0 {
		result["delivery"] = watchdog_delivery_enqueue_batch(db, EXPORTER_PROFILE_IDS, result["batch_dbid"], EXPORT_QUEUE_MAX_RECORDS, EXPORT_QUEUE_MAX_BYTES)
	}
	return result
}

func persist_canonical_batch(body) {
	return persist_approved_canonical_batch(canonical_policy_batch(body))
}

func exporter_profile_configured(profile_id) {
	for configured_id in EXPORTER_PROFILE_IDS { if configured_id == profile_id { return true } }
	return false
}

func persist_v1_canonical_copy(body, source_app, session_id) {
	translation_input := body
	translation_input["source_app"] = source_app
	translation_input["session_id"] = session_id
	translated := watchdog_telemetry_v2_translate_v1(translation_input, current_timestamp())
	if translated["ok"] == false { return translated }
	return persist_canonical_batch(translated["batch"])
}

func insert_trace_bundle(request_dbid, body, source_app, session_id, data_class) {
	trace := safe_dict_get(body, "trace", {})
	has_trace_payload := has_key(body, "trace") != 0 && type(trace) == "dict"
	if type(trace) != "dict" {
		trace = {}
	}
	trace_id := external_text(trace, "trace_id", external_text(body, "trace_id", "", 160), 160)
	if trace_id == "" {
		return {"trace_id": "", "spans": 0, "events": 0, "tool_calls": 0}
	}

	ts := to_string(current_timestamp())
	schema_version := external_text(body, "schema_version", external_text(trace, "schema_version", TELEMETRY_SCHEMA_VERSION, 80), 80)
	started_at_ms := to_int_or_zero(safe_dict_get(trace, "started_at_ms", 0))
	ended_at_ms := to_int_or_zero(safe_dict_get(trace, "ended_at_ms", started_at_ms))
	duration_ms := to_int_or_zero(safe_dict_get(trace, "duration_ms", ended_at_ms - started_at_ms))
	input_tokens := to_int_or_zero(safe_dict_get(body, "input_tokens", safe_dict_get(trace, "input_tokens", 0)))
	output_tokens := to_int_or_zero(safe_dict_get(body, "output_tokens", safe_dict_get(trace, "output_tokens", 0)))
	cached_tokens := to_int_or_zero(safe_dict_get(trace, "cached_input_tokens", 0))
	cache_write_tokens := to_int_or_zero(safe_dict_get(trace, "cache_write_input_tokens", 0))
	model_name := external_text(body, "model", external_text(trace, "model", "", 160), 160)
	pricing := watchdog_cost_breakdown(model_name, input_tokens * 1.0, output_tokens * 1.0, cached_tokens * 1.0, cache_write_tokens * 1.0)
	if has_trace_payload {
		db_execute(db, "INSERT INTO traces (trace_id, schema_version, request_dbid, session_id, source_app, data_class, model, name, status, started_at_ms, ended_at_ms, duration_ms, input_tokens, output_tokens, cached_input_tokens, cache_write_input_tokens, input_cost_usd, output_cost_usd, cached_input_cost_usd, cache_write_input_cost_usd, input_rate_per_million, output_rate_per_million, cached_input_rate_per_million, cache_write_input_rate_per_million, pricing_source, pricing_kind, priced_model, attributes_json, created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?) ON CONFLICT(trace_id) DO UPDATE SET schema_version = excluded.schema_version, request_dbid = CASE WHEN traces.request_dbid = 0 THEN excluded.request_dbid ELSE traces.request_dbid END, session_id = CASE WHEN excluded.session_id <> '' THEN excluded.session_id ELSE traces.session_id END, model = CASE WHEN excluded.model <> '' THEN excluded.model ELSE traces.model END, name = CASE WHEN excluded.name <> '' THEN excluded.name ELSE traces.name END, status = excluded.status, started_at_ms = CASE WHEN traces.started_at_ms = 0 OR (excluded.started_at_ms > 0 AND excluded.started_at_ms < traces.started_at_ms) THEN excluded.started_at_ms ELSE traces.started_at_ms END, ended_at_ms = CASE WHEN excluded.ended_at_ms > traces.ended_at_ms THEN excluded.ended_at_ms ELSE traces.ended_at_ms END, duration_ms = CASE WHEN excluded.duration_ms > traces.duration_ms THEN excluded.duration_ms ELSE traces.duration_ms END, input_tokens = CASE WHEN excluded.input_tokens > traces.input_tokens THEN excluded.input_tokens ELSE traces.input_tokens END, output_tokens = CASE WHEN excluded.output_tokens > traces.output_tokens THEN excluded.output_tokens ELSE traces.output_tokens END, cached_input_tokens = CASE WHEN excluded.cached_input_tokens > traces.cached_input_tokens THEN excluded.cached_input_tokens ELSE traces.cached_input_tokens END, cache_write_input_tokens = CASE WHEN excluded.cache_write_input_tokens > traces.cache_write_input_tokens THEN excluded.cache_write_input_tokens ELSE traces.cache_write_input_tokens END, input_cost_usd = CASE WHEN excluded.input_cost_usd > traces.input_cost_usd THEN excluded.input_cost_usd ELSE traces.input_cost_usd END, output_cost_usd = CASE WHEN excluded.output_cost_usd > traces.output_cost_usd THEN excluded.output_cost_usd ELSE traces.output_cost_usd END, cached_input_cost_usd = CASE WHEN excluded.cached_input_cost_usd > traces.cached_input_cost_usd THEN excluded.cached_input_cost_usd ELSE traces.cached_input_cost_usd END, cache_write_input_cost_usd = CASE WHEN excluded.cache_write_input_cost_usd > traces.cache_write_input_cost_usd THEN excluded.cache_write_input_cost_usd ELSE traces.cache_write_input_cost_usd END, input_rate_per_million = CASE WHEN excluded.model <> '' THEN excluded.input_rate_per_million ELSE traces.input_rate_per_million END, output_rate_per_million = CASE WHEN excluded.model <> '' THEN excluded.output_rate_per_million ELSE traces.output_rate_per_million END, cached_input_rate_per_million = CASE WHEN excluded.model <> '' THEN excluded.cached_input_rate_per_million ELSE traces.cached_input_rate_per_million END, cache_write_input_rate_per_million = CASE WHEN excluded.model <> '' THEN excluded.cache_write_input_rate_per_million ELSE traces.cache_write_input_rate_per_million END, pricing_source = CASE WHEN excluded.model <> '' THEN excluded.pricing_source ELSE traces.pricing_source END, pricing_kind = CASE WHEN excluded.model <> '' THEN excluded.pricing_kind ELSE traces.pricing_kind END, priced_model = CASE WHEN excluded.model <> '' THEN excluded.priced_model ELSE traces.priced_model END, attributes_json = CASE WHEN excluded.attributes_json <> '{}' THEN excluded.attributes_json ELSE traces.attributes_json END", [trace_id, schema_version, request_dbid, session_id, source_app, data_class, model_name, external_text(trace, "name", "interactive_chat", 120), external_text(trace, "status", "success", 32), started_at_ms, ended_at_ms, duration_ms, input_tokens, output_tokens, cached_tokens, cache_write_tokens, pricing["input_cost_usd"], pricing["output_cost_usd"], pricing["cached_input_cost_usd"], pricing["cache_write_input_cost_usd"], pricing["input_rate_per_million"], pricing["output_rate_per_million"], pricing["cached_input_rate_per_million"], pricing["cache_write_input_rate_per_million"], pricing["pricing_source"], pricing["pricing_kind"], pricing["priced_model"], external_json_summary(safe_dict_get(trace, "attributes", {}), 12000), ts])
	}

	span_count := 0
	spans := safe_dict_get(body, "spans", [])
	if type(spans) == "array" {
		for span in spans {
			if span_count < 128 && type(span) == "dict" {
				span_id := external_text(span, "span_id", "", 160)
				if span_id != "" {
					span_started := to_int_or_zero(safe_dict_get(span, "started_at_ms", started_at_ms))
					span_ended := to_int_or_zero(safe_dict_get(span, "ended_at_ms", span_started))
					span_duration := to_int_or_zero(safe_dict_get(span, "duration_ms", span_ended - span_started))
					db_execute(db, "INSERT INTO trace_spans (trace_id, span_id, parent_span_id, request_dbid, session_id, source_app, data_class, span_kind, name, status, started_at_ms, ended_at_ms, duration_ms, attributes_json, created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?) ON CONFLICT(trace_id, span_id) DO UPDATE SET parent_span_id = CASE WHEN excluded.parent_span_id <> '' THEN excluded.parent_span_id ELSE trace_spans.parent_span_id END, request_dbid = CASE WHEN trace_spans.request_dbid = 0 THEN excluded.request_dbid ELSE trace_spans.request_dbid END, status = excluded.status, ended_at_ms = CASE WHEN excluded.ended_at_ms > trace_spans.ended_at_ms THEN excluded.ended_at_ms ELSE trace_spans.ended_at_ms END, duration_ms = CASE WHEN excluded.duration_ms > trace_spans.duration_ms THEN excluded.duration_ms ELSE trace_spans.duration_ms END, attributes_json = excluded.attributes_json", [trace_id, span_id, external_text(span, "parent_span_id", "", 160), request_dbid, session_id, source_app, data_class, external_text(span, "span_kind", "internal", 40), external_text(span, "name", "span", 120), external_text(span, "status", "success", 32), span_started, span_ended, span_duration, external_json_summary(safe_dict_get(span, "attributes", {}), 12000), ts])
					span_count = span_count + 1
				}
			}
		}
	}

	event_count := 0
	events := safe_dict_get(body, "events", [])
	if type(events) == "array" {
		for event in events {
			if event_count < 512 && type(event) == "dict" {
				event_id := external_text(event, "event_id", "event-" + to_string(event_count), 160)
				db_execute(db, "INSERT OR IGNORE INTO trace_events (event_id, trace_id, span_id, sequence, event_name, occurred_at_ms, attributes_json, source_app, data_class, created_at) VALUES (?,?,?,?,?,?,?,?,?,?)", [event_id, trace_id, external_text(event, "span_id", "", 160), to_int_or_zero(safe_dict_get(event, "sequence", event_count)), external_text(event, "event_name", "event", 120), to_int_or_zero(safe_dict_get(event, "occurred_at_ms", started_at_ms)), external_json_summary(safe_dict_get(event, "attributes", {}), 12000), source_app, data_class, ts])
				event_count = event_count + 1
			}
		}
	}

	tool_count := 0
	tool_calls := safe_dict_get(body, "tool_calls", [])
	if type(tool_calls) == "array" {
		for tool_call in tool_calls {
			if tool_count < 64 && type(tool_call) == "dict" {
				tool_call_id := external_text(tool_call, "tool_call_id", "", 160)
				db_execute(db, "INSERT OR IGNORE INTO tool_calls (request_dbid, session_id, tool_call_id, tool_name, tool_args, tool_result, status, latency_ms, source_app, data_class, created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?)", [request_dbid, session_id, tool_call_id, external_text(tool_call, "tool_name", "unknown", 120), external_json_summary(safe_dict_get(tool_call, "arguments", {}), 4000), external_json_summary(safe_dict_get(tool_call, "result", {}), 8000), external_text(tool_call, "status", "success", 32), to_int_or_zero(safe_dict_get(tool_call, "latency_ms", 0)), source_app, data_class, ts])
				tool_count = tool_count + 1
			}
		}
	}

	canonical_result := {"ok": true, "deduplicated": false, "records": 0}
	if data_class != "live" {
		try {
			canonical_result = persist_v1_canonical_copy(body, source_app, session_id)
		} except err {
			print("Canonical v2 compatibility write failed: " + to_string(err))
			canonical_result = {"ok": false, "error": "canonical compatibility write failed", "deduplicated": false, "records": 0}
		}
	}
	return {"trace_id": trace_id, "spans": span_count, "events": event_count, "tool_calls": tool_count, "canonical": canonical_result}
}

func proxy_canonical_source(observability) {
	source := {"watchdog.semantic_profile": "watchdog.observability.v1", "producer": "watchdog-proxy", "adapter_id": "watchdog.openai-compatible-proxy", "adapter_version": "watchdog.ingestion-adapter.v1", "original_schema": "openai-compatible"}
	fields := ["application.name", "application.version", "harness.name", "harness.version"]
	for field in fields {
		value := truncate_str(redact_sensitive_text(to_string(safe_dict_get(observability, field, ""))), 80)
		if value != "" { source[field] = value }
	}
	return source
}

func insert_proxy_model_trace(trace_id, parent_span_id, request_dbid, session_id, provider, model_name, status, status_code, started_at_ms, ended_at_ms, usage, observability) {
	has_explicit_trace := trace_id != ""
	if trace_id == "" { trace_id = "proxy-request-" + to_string(request_dbid) }
	duration_ms := ended_at_ms - started_at_ms
	if duration_ms < 0 { duration_ms = 0 }
	span_id := "proxy-model-" + to_string(request_dbid)
	completion_event_name := "stream_completed"
	if status != "success" { completion_event_name = "response_failed" }
	if has_explicit_trace { insert_trace_bundle(request_dbid, {
		"schema_version": TELEMETRY_SCHEMA_VERSION,
		"trace_id": trace_id,
		"trace": {
			"trace_id": trace_id,
			"schema_version": TELEMETRY_SCHEMA_VERSION,
			"name": "agent_run",
			"status": status,
			"started_at_ms": started_at_ms,
			"ended_at_ms": ended_at_ms,
			"duration_ms": duration_ms,
			"attributes": {"transport": "watchdog-proxy", "content_mode": CONTENT_CAPTURE_MODE}
		},
		"spans": [{
			"span_id": span_id,
			"parent_span_id": parent_span_id,
			"span_kind": "model",
			"name": "provider_round",
			"status": status,
			"started_at_ms": started_at_ms,
			"ended_at_ms": ended_at_ms,
			"duration_ms": duration_ms,
			"attributes": {
				"provider": provider,
				"model": model_name,
				"status_code": status_code,
				"input_tokens": to_int_or_zero(safe_dict_get(usage, "input_tokens", 0)),
				"output_tokens": to_int_or_zero(safe_dict_get(usage, "output_tokens", 0)),
				"request_dbid": request_dbid
			}
		}],
		"events": [{
			"event_id": span_id + "-completed",
			"span_id": span_id,
			"sequence": 0,
			"event_name": completion_event_name,
			"occurred_at_ms": ended_at_ms,
			"attributes": {"status_code": status_code}
		}]
	}, "watchdog-proxy", session_id, "live") }

	canonical_trace_id := watchdog_telemetry_v2_canonical_id(trace_id, "watchdog-proxy", 32)
	canonical_span_id := watchdog_telemetry_v2_canonical_id(span_id, "watchdog-proxy:" + trace_id, 16)
	canonical_parent_span_id := null
	if parent_span_id != "" { canonical_parent_span_id = watchdog_telemetry_v2_canonical_id(parent_span_id, "watchdog-proxy:" + trace_id, 16) }
	input_tokens := to_int_or_zero(safe_dict_get(usage, "input_tokens", 0))
	output_tokens := to_int_or_zero(safe_dict_get(usage, "output_tokens", 0))
	total_tokens := to_int_or_zero(safe_dict_get(usage, "total_tokens", input_tokens + output_tokens))
	total_semantics := "producer_reported"
	if total_tokens == input_tokens + output_tokens { total_semantics = "input_plus_output" }
	pricing := watchdog_cost_breakdown(model_name, input_tokens * 1.0, output_tokens * 1.0, 0.0, 0.0)
	cost_kind := "catalog_estimated"
	if pricing["pricing_kind"] == "unknown" { cost_kind = "unknown" }
	cost_amount := pricing["total_cost_usd"]
	if cost_kind == "unknown" { cost_amount = null }
	logical_request_id := truncate_str(trim(to_string(safe_dict_get(observability, "logical_request_id", ""))), 160)
	if logical_request_id == "" { logical_request_id = "proxy:" + to_string(request_dbid) }
	source := proxy_canonical_source(observability)
	source["source_trace_id"] = trace_id
	source["source_span_id"] = span_id
	references := [
		{"type": "session", "id": session_id, "namespace": "watchdog-proxy", "relation": "groups"},
		{"type": "request", "id": logical_request_id, "namespace": "watchdog-proxy", "relation": "attempt_of"},
		{"type": "request", "id": to_string(request_dbid), "namespace": "watchdog", "relation": "observes"}
	]
	project_id := truncate_str(trim(to_string(safe_dict_get(observability, "project_id", ""))), 160)
	if project_id != "" { references = push(references, {"type": "artifact", "id": project_id, "namespace": "watchdog-project", "relation": "groups"}) }
	retry_of_request_id := truncate_str(trim(to_string(safe_dict_get(observability, "retry_of_request_id", ""))), 160)
	if retry_of_request_id != "" { references = push(references, {"type": "request", "id": retry_of_request_id, "namespace": "watchdog-proxy", "relation": "retries"}) }
	fallback_from_request_id := truncate_str(trim(to_string(safe_dict_get(observability, "fallback_from_request_id", ""))), 160)
	if fallback_from_request_id != "" { references = push(references, {"type": "request", "id": fallback_from_request_id, "namespace": "watchdog-proxy", "relation": "fallback_from"}) }
	outcome_code := "error"
	if status == "success" { outcome_code = "success" }
	canonical_attributes := {"gen_ai.provider.name": provider, "gen_ai.request.model": model_name, "http.response.status_code": status_code, "watchdog.transport": "openai-compatible-proxy", "watchdog.duration_ms": duration_ms, "watchdog.logical_request_id": logical_request_id, "watchdog.attempt.number": safe_dict_get(observability, "attempt_number", 1), "watchdog.response.streamed": safe_dict_get(observability, "response_streamed", false), "watchdog.timing.source": safe_dict_get(observability, "timing_source", "unknown"), "watchdog.time_to_first_output_ms": null, "watchdog.output_generation_duration_ms": null, "watchdog.output_tokens_per_second": null}
	# The buffered proxy does not reinterpret response models through the current
	# catalog. Producers that resolve a limit attach its version at observation time.
	canonical_attributes["watchdog.context.window_tokens"] = null
	canonical_attributes["watchdog.context.limit_source"] = "unknown"
	canonical_attributes["watchdog.cost.evidence"] = "catalog"
	canonical_attributes["watchdog.pricing.catalog_version"] = pricing["pricing_source"]
	canonical_attributes["watchdog.pricing.calculated_at"] = watchdog_telemetry_v2_timestamp(ended_at_ms, ended_at_ms)
	if safe_dict_get(observability, "output_partial", false) == true { canonical_attributes["watchdog.output.partial"] = true }
	retry_reason_code := to_string(safe_dict_get(observability, "retry_reason_code", ""))
	if retry_reason_code != "" { canonical_attributes["watchdog.retry.reason_code"] = retry_reason_code }
	retry_decision_source := to_string(safe_dict_get(observability, "retry_decision_source", ""))
	if retry_decision_source != "" { canonical_attributes["watchdog.retry.decision_source"] = retry_decision_source }
	fallback_dimension := to_string(safe_dict_get(observability, "fallback_dimension", ""))
	if fallback_dimension != "" { canonical_attributes["watchdog.fallback.dimension"] = fallback_dimension }
	fallback_reason_code := to_string(safe_dict_get(observability, "fallback_reason_code", ""))
	if fallback_reason_code != "" { canonical_attributes["watchdog.fallback.reason_code"] = fallback_reason_code }
	canonical_record := {
		"record_id": "proxy:model:" + to_string(request_dbid),
		"record_type": "span",
		"trace_id": canonical_trace_id,
		"span_id": canonical_span_id,
		"parent_span_id": canonical_parent_span_id,
		"observed_at": watchdog_telemetry_v2_timestamp(ended_at_ms, ended_at_ms),
		"started_at": watchdog_telemetry_v2_timestamp(started_at_ms, started_at_ms),
		"ended_at": watchdog_telemetry_v2_timestamp(ended_at_ms, ended_at_ms),
		"kind": "model",
		"name": "provider_round",
		"status": watchdog_telemetry_v2_status(status),
		"source": source,
		"references": references,
		"attributes": canonical_attributes,
		"usage": {"input_tokens": input_tokens, "output_tokens": output_tokens, "total_tokens": total_tokens, "cached_input_tokens": to_int_or_zero(safe_dict_get(usage, "cached_input_tokens", 0)), "cache_write_input_tokens": to_int_or_zero(safe_dict_get(usage, "cache_write_input_tokens", 0)), "reasoning_tokens": to_int_or_zero(safe_dict_get(usage, "reasoning_tokens", 0)), "usage_source": "provider-response", "total_semantics": total_semantics, "provider_usage": safe_dict_get(usage, "provider_usage", {})},
		"costs": [{"kind": cost_kind, "currency": "USD", "amount": cost_amount, "source": pricing["pricing_source"], "catalog_version": null, "calculated_at": watchdog_telemetry_v2_timestamp(ended_at_ms, ended_at_ms), "components": {"input": pricing["input_cost_usd"], "output": pricing["output_cost_usd"]}}],
		"error": null,
		"content": [],
		"privacy": {"content_mode": "off", "policy_version": "watchdog.privacy.v1", "transformations": []}
	}
	terminal_record := {
		"record_id": "proxy:completion:" + to_string(request_dbid), "record_type": "event", "trace_id": canonical_trace_id, "span_id": canonical_span_id, "parent_span_id": null,
		"observed_at": watchdog_telemetry_v2_timestamp(ended_at_ms, ended_at_ms), "started_at": null, "ended_at": null, "kind": null,
		"name": "watchdog.operation.completed", "status": watchdog_telemetry_v2_status(status), "source": source, "references": references,
		"attributes": {"watchdog.outcome.terminal": true, "watchdog.outcome.code": outcome_code, "watchdog.logical_request_id": logical_request_id, "watchdog.attempt.number": safe_dict_get(observability, "attempt_number", 1), "http.response.status_code": status_code},
		"usage": null, "costs": [], "error": null, "content": [], "privacy": {"content_mode": "off", "policy_version": "watchdog.privacy.v1", "transformations": []}
	}
	try {
		canonical_write := persist_approved_canonical_batch({"schema_version": CANONICAL_TELEMETRY_SCHEMA_VERSION, "batch_id": "proxy:" + to_string(request_dbid), "sent_at": canonical_record["observed_at"], "producer": {"name": "watchdog-proxy", "version": "v1", "adapter_id": "watchdog.openai-compatible-proxy", "adapter_version": "watchdog.ingestion-adapter.v1", "original_schema": "openai-compatible"}, "records": [canonical_record, terminal_record]})
		if canonical_write["ok"] == false { print("Proxy canonical telemetry validation failed: " + canonical_write["error"]) }
	} except canonical_err {
		print("Proxy canonical telemetry write failed: " + to_string(canonical_err))
	}
}

func insert_external_agent_steps(request_dbid, body, source_app, session_id) {
	step_count := 0
	agent_id := external_text(body, "agent_id", source_app, 120)
	steps := safe_dict_get(body, "agent_steps", [])
	if type(steps) != "array" {
		steps = []
	}

	for step in steps {
		if step_count >= 256 || type(step) != "dict" {
			continue
		}
		step_type := external_text(step, "step_type", external_text(step, "type", "", 80), 80)
		if step_type == "" {
			continue
		}
		content := external_text(step, "title", external_text(step, "content", external_text(step, "message", "", 500), 500), 500)
		metadata := {
			"request_dbid": request_dbid,
			"task_id": external_text(body, "task_id", "", 160),
			"correlation_id": external_text(body, "correlation_id", "", 160),
			"status": external_text(step, "status", "", 40),
			"tool_name": external_text(step, "tool_name", "", 120),
			"tool_call_id": external_text(step, "tool_call_id", "", 160),
			"arguments": safe_dict_get(step, "arguments", {}),
			"result": safe_dict_get(step, "result", {}),
			"usage": safe_dict_get(step, "usage", {})
		}
		step_number := next_step_number(session_id)
		ts := to_string(current_timestamp())
		db_execute(db, "INSERT INTO agent_steps (session_id, agent_id, step_number, step_type, content, metadata, source_app, data_class, created_at) VALUES (?,?,?,?,?,?,?,?,?)", [session_id, agent_id, step_number, step_type, content, to_json(redact_dict_shallow(metadata)), source_app, "external", ts])
		step_count = step_count + 1
	}

	return step_count
}

func insert_external_derived_agent_steps(request_dbid, body, source_app, session_id) {
	step_count := 0
	agent_id := external_text(body, "agent_id", source_app, 120)
	task_id := external_text(body, "task_id", "", 160)
	correlation_id := external_text(body, "correlation_id", "", 160)

	events := safe_dict_get(body, "events", [])
	if type(events) == "array" {
		for event in events {
			if step_count >= 256 || type(event) != "dict" {
				continue
			}
			event_name := external_text(event, "event_name", "", 120)
			if event_name != "thread_started" {
				continue
			}
			step_number := next_step_number(session_id)
			ts := to_string(current_timestamp())
			db_execute(db, "INSERT INTO agent_steps (session_id, agent_id, step_number, step_type, content, metadata, source_app, data_class, created_at) VALUES (?,?,?,?,?,?,?,?,?)", [session_id, agent_id, step_number, "thread_started", "Thread started", to_json({"request_dbid": request_dbid, "task_id": task_id, "correlation_id": correlation_id, "event_name": event_name}), source_app, "external", ts])
			step_count = step_count + 1
		}
	}

	tool_rows := db_query(db, "SELECT id, tool_name, tool_args, tool_result, status, latency_ms FROM tool_calls WHERE request_dbid = ? ORDER BY id ASC LIMIT 1", [request_dbid])
	if step_count < 256 && len(tool_rows) > 0 {
		tool_row := tool_rows[0]
		step_type := truncate_str(to_string(tool_row["tool_name"]), 80)
		if step_type != "" {
			content := truncate_str(redact_sensitive_text(step_type + " completed"), 500)
			metadata := {
				"request_dbid": request_dbid,
				"task_id": task_id,
				"correlation_id": correlation_id,
				"status": truncate_str(to_string(tool_row["status"]), 40),
				"tool_name": truncate_str(to_string(tool_row["tool_name"]), 120),
				"tool_call_id": truncate_str(to_string(tool_row["id"]), 160),
				"arguments": truncate_str(to_string(tool_row["tool_args"]), 4000),
				"result": truncate_str(to_string(tool_row["tool_result"]), 8000),
				"latency_ms": to_int_or_zero(tool_row["latency_ms"])
			}
			step_number := next_step_number(session_id)
			ts := to_string(current_timestamp())
			db_execute(db, "INSERT INTO agent_steps (session_id, agent_id, step_number, step_type, content, metadata, source_app, data_class, created_at) VALUES (?,?,?,?,?,?,?,?,?)", [session_id, agent_id, step_number, step_type, content, to_json(redact_dict_shallow(metadata)), source_app, "external", ts])
			step_count = step_count + 1
		}
	}

	return step_count
}

func insert_external_request(body) {
	source_app := external_text(body, "source_app", "external", 80)
	request_id := external_text(body, "request_id", "", 160)
	if request_id == "" {
		return {"ok": false, "error": "request_id is required"}
	}

	existing := db_query(db, "SELECT id FROM requests WHERE source_app = ? AND request_id = ? LIMIT 1", [source_app, request_id])
	if len(existing) > 0 {
		return {"ok": true, "id": existing[0]["id"], "deduplicated": true}
	}

	status := to_lower(external_text(body, "status", "success", 32))
	if status != "success" && status != "error" && status != "completed" && status != "cancelled" {
		status := "error"
	}
	input_tokens := to_int_or_zero(safe_dict_get(body, "input_tokens", 0))
	output_tokens := to_int_or_zero(safe_dict_get(body, "output_tokens", 0))
	total_tokens := to_int_or_zero(safe_dict_get(body, "total_tokens", input_tokens + output_tokens))
	cached_input_tokens := to_int_or_zero(safe_dict_get(body, "cached_input_tokens", 0))
	cache_write_input_tokens := to_int_or_zero(safe_dict_get(body, "cache_write_input_tokens", 0))
	model_name := external_text(body, "model", "", 160)
	pricing := watchdog_cost_breakdown(model_name, input_tokens * 1.0, output_tokens * 1.0, cached_input_tokens * 1.0, cache_write_input_tokens * 1.0)
	cost_usd := pricing["total_cost_usd"]
	if has_key(body, "cost_usd") {
		try {
			cost_usd = parse_float(to_string(body["cost_usd"]))
		} except err {
			return {"ok": false, "error": "cost_usd must be a non-negative number"}
		}
		if cost_usd < 0 || (cost_usd - cost_usd) != 0.0 {
			return {"ok": false, "error": "cost_usd must be a non-negative number"}
		}
		pricing["pricing_kind"] = "provider_reported"
		pricing["pricing_source"] = external_text(body, "pricing_source", "provider-reported-cost", 160)
		pricing["priced_model"] = model_name
	}
	latency_ms := to_int_or_zero(safe_dict_get(body, "latency_ms", 0))
	ts := to_string(current_timestamp())

	db_execute(db, "INSERT INTO requests (session_id, user_id, tenant_id, project_id, workflow_id, task_id, correlation_id, provider, model, request_id, status, input_tokens, output_tokens, total_tokens, cached_input_tokens, cache_write_input_tokens, cost_usd, input_cost_usd, output_cost_usd, cached_input_cost_usd, cache_write_input_cost_usd, input_rate_per_million, output_rate_per_million, cached_input_rate_per_million, cache_write_input_rate_per_million, pricing_source, pricing_kind, priced_model, latency_ms, finish_reason, error_code, error_message, prompt_summary, response_summary, source_app, data_class, created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)", [external_text(body, "session_id", request_id, 160), external_text(body, "user_id", "", 120), external_text(body, "tenant_id", "", 120), external_text(body, "project_id", "", 120), external_text(body, "workflow_id", "", 120), external_text(body, "task_id", "", 160), external_text(body, "correlation_id", "", 160), external_text(body, "provider", "external", 160), model_name, request_id, status, input_tokens, output_tokens, total_tokens, cached_input_tokens, cache_write_input_tokens, cost_usd, pricing["input_cost_usd"], pricing["output_cost_usd"], pricing["cached_input_cost_usd"], pricing["cache_write_input_cost_usd"], pricing["input_rate_per_million"], pricing["output_rate_per_million"], pricing["cached_input_rate_per_million"], pricing["cache_write_input_rate_per_million"], pricing["pricing_source"], pricing["pricing_kind"], pricing["priced_model"], latency_ms, external_text(body, "finish_reason", "", 80), external_text(body, "error_code", "", 80), external_text(body, "error_message", "", 500), external_text(body, "prompt_summary", "", 500), external_text(body, "response_summary", "", 500), source_app, "external", ts])
	rows := db_query(db, "SELECT last_insert_rowid() AS id", [])
	request_dbid := 0
	if len(rows) > 0 {
		request_dbid := rows[0]["id"]
	}

	session_id := external_text(body, "session_id", request_id, 160)
	explicit_step_count := insert_external_agent_steps(request_dbid, body, source_app, session_id)
	trace_result := insert_trace_bundle(request_dbid, body, source_app, session_id, "external")
	derived_step_count := 0
	if explicit_step_count == 0 {
		derived_step_count = insert_external_derived_agent_steps(request_dbid, body, source_app, session_id)
	}
	if explicit_step_count == 0 && derived_step_count == 0 {
		fallback_step_type := external_text(body, "step_type", "request_completed", 80)
		fallback_content := external_text(body, "response_summary", "External telemetry recorded", 500)
		tool_calls := safe_dict_get(body, "tool_calls", [])
		if type(tool_calls) == "array" && len(tool_calls) > 0 && type(tool_calls[0]) == "dict" {
			first_tool := tool_calls[0]
			first_tool_name := external_text(first_tool, "tool_name", "", 80)
			if first_tool_name != "" {
				fallback_step_type = first_tool_name
				fallback_content = truncate_str(redact_sensitive_text(first_tool_name + " completed"), 500)
			}
		}
		step_number := next_step_number(session_id)
		db_execute(db, "INSERT INTO agent_steps (session_id, agent_id, step_number, step_type, content, metadata, source_app, data_class, created_at) VALUES (?,?,?,?,?,?,?,?,?)", [session_id, external_text(body, "agent_id", source_app, 120), step_number, fallback_step_type, fallback_content, to_json({"request_dbid": request_dbid, "task_id": external_text(body, "task_id", "", 160), "correlation_id": external_text(body, "correlation_id", "", 160)}), source_app, "external", ts])
	}
	return {"ok": true, "id": request_dbid, "deduplicated": false, "trace": trace_result}
}

func insert_audit_event(action, actor_key, result, metadata) {
	ts := to_string(current_timestamp())
	meta_str := metadata
	if type(metadata) == "dict" {
		meta_str := to_json(redact_dict_shallow(metadata))
	} else {
		meta_str := redact_sensitive_text(meta_str)
	}

	db_execute(db, "INSERT INTO audit_events (action, actor_key, result, metadata, created_at) VALUES (?,?,?,?,?)", [
		truncate_str(to_string(action), 80),
		truncate_str(to_string(actor_key), 160),
		truncate_str(to_string(result), 40),
		meta_str,
		ts
	])
}

# ---------------------------------------------------------------------------
# Automated database backups
# ---------------------------------------------------------------------------

BACKUP_IN_PROGRESS := false

func backup_process_success(proc) {
	if type(proc) == "dict" {
		return parse_bool_value(safe_dict_get(proc, "success", false), false)
	}
	try {
		return parse_bool_value(proc.success, false)
	} except err {
		return false
	}
}

func backup_process_exitcode(proc) {
	if type(proc) == "dict" {
		return to_int_or_zero(safe_dict_get(proc, "exitcode", 127))
	}
	try {
		return to_int_or_zero(proc.exitcode)
	} except err {
		return 127
	}
}

func backup_process_stdout(proc) {
	if type(proc) == "dict" {
		return to_string(safe_dict_get(proc, "stdout", ""))
	}
	try {
		return to_string(proc.stdout)
	} except err {
		return ""
	}
}

func backup_process_stderr(proc) {
	if type(proc) == "dict" {
		return to_string(safe_dict_get(proc, "stderr", ""))
	}
	try {
		return to_string(proc.stderr)
	} except err {
		return ""
	}
}

func bool_as_int(value) {
	if parse_bool_value(value, false) {
		return 1
	}
	return 0
}

func validate_backup_dir(raw_value) {
	dir := trim(to_string(raw_value))
	if dir == "" {
		return {"ok": false, "error": "Backup directory is required"}
	}
	if contains(dir, "\n") || contains(dir, "\r") {
		return {"ok": false, "error": "Backup directory contains unsupported control characters"}
	}
	parts := split(replace(dir, "\\", "/"), "/")
	for part in parts {
		if trim(to_string(part)) == ".." {
			return {"ok": false, "error": "Backup directory must not contain parent-directory segments"}
		}
	}
	return {"ok": true, "path": dir, "error": ""}
}

func read_backup_settings() {
	rows := db_query(db, "SELECT enabled, interval_minutes, backup_dir, retention_count, encryption_enabled, updated_at_ms FROM backup_settings WHERE id = 1 LIMIT 1", [])
	if len(rows) == 0 {
		return {
			"enabled": BACKUP_DEFAULT_ENABLED,
			"interval_minutes": BACKUP_DEFAULT_INTERVAL_MINUTES,
			"backup_dir": BACKUP_DEFAULT_DIR,
			"retention_count": BACKUP_DEFAULT_RETENTION_COUNT,
			"encryption_enabled": BACKUP_DEFAULT_ENCRYPTION_ENABLED,
			"updated_at_ms": 0
		}
	}
	row := rows[0]
	return {
		"enabled": to_int_or_zero(row["enabled"]) == 1,
		"interval_minutes": to_int_or_zero(row["interval_minutes"]),
		"backup_dir": to_string(row["backup_dir"]),
		"retention_count": to_int_or_zero(row["retention_count"]),
		"encryption_enabled": to_int_or_zero(row["encryption_enabled"]) == 1,
		"updated_at_ms": to_int_or_zero(row["updated_at_ms"])
	}
}

func backup_last_success_ms() {
	rows := db_query(db, "SELECT COALESCE(MAX(finished_at_ms),0) AS last_success_ms FROM backup_runs WHERE status = 'success'", [])
	return to_int_or_zero(rows[0]["last_success_ms"])
}

func backup_last_attempt_ms() {
	rows := db_query(db, "SELECT COALESCE(MAX(started_at_ms),0) AS last_attempt_ms FROM backup_runs", [])
	return to_int_or_zero(rows[0]["last_attempt_ms"])
}

func backup_runs(limit_value) {
	return db_query(db, "SELECT id, trigger_type, status, backup_path, checksum_path, size_bytes, encrypted, error_message, started_at_ms, finished_at_ms FROM backup_runs ORDER BY started_at_ms DESC LIMIT ?", [limit_value])
}

func normalize_backup_dir_path(raw_path) {
	next := trim(to_string(raw_path))
	while ends_with(next, "/") {
		next := substring(next, 0, len(next) - 1)
	}
	return next
}

func backup_join_path(dir_path, entry_name) {
	base := normalize_backup_dir_path(dir_path)
	if base == "" {
		return trim(to_string(entry_name))
	}
	return base + "/" + trim(to_string(entry_name))
}

func backup_file_name(path_value) {
	parts := split(replace(trim(to_string(path_value)), "\\", "/"), "/")
	if len(parts) == 0 {
		return ""
	}
	return to_string(parts[len(parts) - 1])
}

func backup_generated_file_name(name) {
	text := trim(to_string(name))
	if !starts_with(text, "watchdog-backup-") {
		return false
	}
	if ends_with(text, ".sha256") {
		return false
	}
	return ends_with(text, ".db") || ends_with(text, ".db.enc")
}

func backup_started_label_from_name(name) {
	text := trim(to_string(name))
	prefix := "watchdog-backup-"
	if !starts_with(text, prefix) {
		return ""
	}
	if len(text) < len(prefix) + 16 {
		return ""
	}
	ts := substring(text, len(prefix), len(text))
	marker := split(ts, "-")
	if len(marker) == 0 {
		return ""
	}
	stamp := to_string(marker[0])
	if len(stamp) < 16 {
		return ""
	}
	return substring(stamp, 0, 4) + "-" + substring(stamp, 4, 6) + "-" + substring(stamp, 6, 8) + " " + substring(stamp, 9, 11) + ":" + substring(stamp, 11, 13) + ":" + substring(stamp, 13, 15) + " UTC"
}

func backup_run_with_presence(row) {
	backup_path := to_string(safe_dict_get(row, "backup_path", ""))
	checksum_path := to_string(safe_dict_get(row, "checksum_path", ""))
	status := to_string(safe_dict_get(row, "status", ""))
	backup_exists := backup_path != "" && file_exists(backup_path) && !path_is_dir(backup_path)
	checksum_exists := checksum_path != "" && file_exists(checksum_path) && !path_is_dir(checksum_path)
	enriched := {}
	for key in keys(row) {
		enriched[key] = row[key]
	}
	enriched["backup_exists"] = backup_exists
	enriched["checksum_exists"] = checksum_exists
	enriched["is_active"] = status == "success" && backup_exists
	enriched["missing_from_folder"] = status == "success" && backup_path != "" && !backup_exists
	enriched["started_label"] = ""
	enriched["discovered_from_folder"] = false
	return enriched
}

func backup_runs_with_presence(limit_value) {
	rows := backup_runs(limit_value)
	enriched := []
	for row in rows {
		enriched := push(enriched, backup_run_with_presence(row))
	}
	return enriched
}

func backup_folder_active_runs(backup_dir, runs) {
	dir_path := normalize_backup_dir_path(backup_dir)
	if dir_path == "" || !file_exists(dir_path) || !path_is_dir(dir_path) {
		return []
	}
	names := sort(list_dir(dir_path))
	active := []
	i := len(names) - 1
	while i >= 0 {
		name := to_string(names[i])
		full_path := backup_join_path(dir_path, name)
		if backup_generated_file_name(name) && file_exists(full_path) && !path_is_dir(full_path) {
			matched_run := null
			for run in runs {
				run_path := to_string(safe_dict_get(run, "backup_path", ""))
				if run_path == full_path {
					matched_run = run
					break
				}
			}
			if type(matched_run) == "dict" {
				active := push(active, matched_run)
			} else {
				checksum_exists := file_exists(full_path + ".sha256")
				if checksum_exists {
					checksum_exists = !path_is_dir(full_path + ".sha256")
				}
				active := push(active, {
					"id": 0,
					"trigger_type": "folder",
					"status": "success",
					"backup_path": full_path,
					"checksum_path": full_path + ".sha256",
					"size_bytes": file_size(full_path),
					"encrypted": ends_with(name, ".enc"),
					"error_message": "",
					"started_at_ms": 0,
					"finished_at_ms": 0,
					"backup_exists": true,
					"checksum_exists": checksum_exists,
					"is_active": true,
					"missing_from_folder": false,
					"started_label": backup_started_label_from_name(name),
					"discovered_from_folder": true
				})
			}
		}
		i := i - 1
	}
	return active
}

func backup_status_payload() {
	settings := read_backup_settings()
	last_success_ms := backup_last_success_ms()
	next_due_at_ms := 0
	runs := backup_runs_with_presence(100)
	active_runs := backup_folder_active_runs(settings["backup_dir"], runs)
	archived_runs := []
	for run in runs {
		run_path := to_string(safe_dict_get(run, "backup_path", ""))
		found_active := false
		if run_path != "" {
			for active_run in active_runs {
				active_path := to_string(safe_dict_get(active_run, "backup_path", ""))
				if active_path == run_path {
					found_active = true
					break
				}
			}
		}
		if run_path == "" || !found_active {
			archived_runs := push(archived_runs, run)
		}
	}
	if settings["enabled"] {
		next_due_at_ms = last_success_ms + (settings["interval_minutes"] * 60 * 1000)
		if last_success_ms == 0 {
			next_due_at_ms = current_timestamp()
		}
	}
	return {
		"settings": settings,
		"encryption_key_configured": BACKUP_ENCRYPTION_KEY_FILE != "",
		"backup_in_progress": BACKUP_IN_PROGRESS,
		"last_success_at_ms": last_success_ms,
		"next_due_at_ms": next_due_at_ms,
		"runs": runs,
		"active_runs": active_runs,
		"archived_runs": archived_runs,
		"limits": {
			"min_interval_minutes": MIN_BACKUP_INTERVAL_MINUTES,
			"max_interval_minutes": MAX_BACKUP_INTERVAL_MINUTES,
			"max_retention_count": 3650
		}
	}
}

func create_backup_run(trigger_type) {
	if BACKUP_IN_PROGRESS {
		return {"ok": false, "error": "A Watchdog backup is already in progress"}
	}
	BACKUP_IN_PROGRESS = true
	started_ms := current_timestamp()
	settings := read_backup_settings()
	run_id := 0

	if settings["encryption_enabled"] && BACKUP_ENCRYPTION_KEY_FILE == "" {
		error_message := "Backup encryption is enabled but WDG_BACKUP_ENCRYPTION_KEY_FILE is not configured"
		db_execute(db, "INSERT INTO backup_runs (trigger_type, status, error_message, started_at_ms, finished_at_ms) VALUES (?, 'failed', ?, ?, ?)", [trigger_type, error_message, started_ms, current_timestamp()])
		id_rows := db_query(db, "SELECT last_insert_rowid() AS id", [])
		run_id = to_int_or_zero(id_rows[0]["id"])
		insert_audit_event("backup_operation", "system", "failed", {"trigger": trigger_type, "reason": "encryption_key_not_configured"})
		BACKUP_IN_PROGRESS = false
		return {"ok": false, "error": error_message}
	}

	args := [NODE_BIN, BACKUP_SCRIPT_PATH, "--db", DB_PATH, "--out-dir", settings["backup_dir"], "--retention-count", to_string(settings["retention_count"])]
	result_path := ".watchdog-backup-result-" + to_string(current_timestamp()) + "-" + to_string(random_int(100000, 999999)) + ".json"
	args := push(args, "--result-file")
	args := push(args, result_path)
	if settings["encryption_enabled"] {
		args := push(args, "--encryption-key-file")
		args := push(args, BACKUP_ENCRYPTION_KEY_FILE)
		args := push(args, "--openssl-bin")
		args := push(args, OPENSSL_BIN)
	}

	proc := null
	try {
		proc = spawn_process(args)
	} except err {
		proc = {"success": false, "exitcode": 127, "stdout": "", "stderr": to_string(err)}
	}

	stdout_text := trim(backup_process_stdout(proc))
	if file_exists(result_path) {
		try {
			stdout_text = trim(read_file(result_path))
			delete_file(result_path)
		} except cleanup_err {
			# Result cleanup is best-effort; backup success is determined below.
		}
	}
	parsed := parse_json_safe(stdout_text)
	if backup_process_success(proc) && backup_process_exitcode(proc) == 0 && parsed["ok"] && type(parsed["data"]) == "dict" && parse_bool_value(safe_dict_get(parsed["data"], "ok", false), false) {
		data := parsed["data"]
		finished_ms := current_timestamp()
		backup_path := truncate_str(to_string(safe_dict_get(data, "path", "")), 1000)
		checksum_path := truncate_str(to_string(safe_dict_get(data, "checksum_path", "")), 1000)
		size_bytes := to_int_or_zero(safe_dict_get(data, "size_bytes", 0))
		encrypted := bool_as_int(safe_dict_get(data, "encrypted", false))
		db_execute(db, "INSERT INTO backup_runs (trigger_type, status, backup_path, checksum_path, size_bytes, encrypted, started_at_ms, finished_at_ms) VALUES (?, 'success', ?, ?, ?, ?, ?, ?)", [trigger_type, backup_path, checksum_path, size_bytes, encrypted, started_ms, finished_ms])
		id_rows := db_query(db, "SELECT last_insert_rowid() AS id", [])
		run_id = to_int_or_zero(id_rows[0]["id"])
		insert_audit_event("backup_operation", "system", "success", {"trigger": trigger_type, "encrypted": encrypted == 1, "size_bytes": size_bytes})
		BACKUP_IN_PROGRESS = false
		return {"ok": true, "run_id": run_id, "backup_path": backup_path, "checksum_path": checksum_path, "size_bytes": size_bytes, "encrypted": encrypted == 1}
	}

	error_message := "Backup helper failed"
	if parsed["ok"] && type(parsed["data"]) == "dict" {
		error_message = to_string(safe_dict_get(parsed["data"], "error", error_message))
	} else {
		stderr_text := trim(backup_process_stderr(proc))
		if stderr_text != "" {
			error_message = stderr_text
		} else if stdout_text != "" {
			error_message = stdout_text
		}
	}
	error_message = truncate_str(redact_sensitive_text(error_message), 500)
	db_execute(db, "INSERT INTO backup_runs (trigger_type, status, error_message, started_at_ms, finished_at_ms) VALUES (?, 'failed', ?, ?, ?)", [trigger_type, error_message, started_ms, current_timestamp()])
	id_rows := db_query(db, "SELECT last_insert_rowid() AS id", [])
	run_id = to_int_or_zero(id_rows[0]["id"])
	insert_audit_event("backup_operation", "system", "failed", {"trigger": trigger_type, "reason": error_message})
	BACKUP_IN_PROGRESS = false
	return {"ok": false, "run_id": run_id, "error": error_message}
}

func maybe_run_scheduled_backup() {
	settings := read_backup_settings()
	if !settings["enabled"] || BACKUP_IN_PROGRESS {
		return {"ok": true, "ran": false}
	}
	now_ms := current_timestamp()
	last_success_ms := backup_last_success_ms()
	last_attempt_ms := backup_last_attempt_ms()
	interval_ms := settings["interval_minutes"] * 60 * 1000
	if last_success_ms > 0 && now_ms - last_success_ms < interval_ms {
		return {"ok": true, "ran": false}
	}
	if last_attempt_ms > last_success_ms && now_ms - last_attempt_ms < (15 * 60 * 1000) {
		return {"ok": true, "ran": false}
	}
	result := create_backup_run("scheduled")
	return {"ok": result["ok"], "ran": true, "result": result}
}

# ---------------------------------------------------------------------------
# HTTP helpers
# ---------------------------------------------------------------------------

func apply_default_security_headers(response) {
	response := set_header(response, "X-Content-Type-Options", "nosniff")
	response := set_header(response, "X-Frame-Options", "DENY")
	response := set_header(response, "Referrer-Policy", "no-referrer")
	response := set_header(response, "Cache-Control", "no-store")
	return response
}

func api_ok(data) {
	response := apply_default_security_headers(json_response(200, {"ok": true, "data": data}))
	response := set_header(response, "X-Watchdog-API-Version", API_CONTRACT_VERSION)
	return response
}

func api_error(status_code, message) {
	response := apply_default_security_headers(json_response(status_code, {"ok": false, "error": message}))
	response := set_header(response, "X-Watchdog-API-Version", API_CONTRACT_VERSION)
	return response
}

func api_error_code(status_code, error_code, detail) {
	response := apply_default_security_headers(json_response(status_code, {"ok": false, "error": error_code, "detail": detail}))
	response := set_header(response, "X-Watchdog-API-Version", API_CONTRACT_VERSION)
	return response
}

func forward_response(status_code, body_text, content_type, upstream_headers) {
	response := http_response(status_code, body_text)
	if content_type != "" {
		response := set_header(response, "Content-Type", content_type)
	}
	retry_after := get_header(upstream_headers, "Retry-After")
	if retry_after != "" {
		response := set_header(response, "Retry-After", retry_after)
	}
	request_id := get_header(upstream_headers, "X-Request-Id")
	if request_id != "" {
		response := set_header(response, "X-Request-Id", request_id)
	}
	response := set_header(response, "X-Watchdog-Proxy", "kujo-watchdog")
	return apply_default_security_headers(response)
}

func export_rows_as_jsonl(request_rows, tool_rows, step_rows, trace_rows, span_rows, event_rows) {
	lines := []

	i := 0
	while i < len(request_rows) {
		lines := push(lines, to_json({
			"kind": "request",
			"data": request_rows[i]
		}))
		i := i + 1
	}

	i := 0
	while i < len(tool_rows) {
		lines := push(lines, to_json({
			"kind": "tool_call",
			"data": tool_rows[i]
		}))
		i := i + 1
	}

	i := 0
	while i < len(step_rows) {
		lines := push(lines, to_json({
			"kind": "agent_step",
			"data": step_rows[i]
		}))
		i := i + 1
	}

	i := 0
	while i < len(trace_rows) {
		lines := push(lines, to_json({"kind": "trace", "data": trace_rows[i]}))
		i := i + 1
	}
	i := 0
	while i < len(span_rows) {
		lines := push(lines, to_json({"kind": "trace_span", "data": span_rows[i]}))
		i := i + 1
	}
	i := 0
	while i < len(event_rows) {
		lines := push(lines, to_json({"kind": "trace_event", "data": event_rows[i]}))
		i := i + 1
	}

	body := ""
	i := 0
	while i < len(lines) {
		if i > 0 {
			body := body + "\n"
		}
		body := body + to_string(lines[i])
		i := i + 1
	}

	response := http_response(200, body)
	response := set_header(response, "Content-Type", "application/x-ndjson")
	return apply_default_security_headers(response)
}

func resolve_session_id(req, parsed_payload) {
	headers := safe_dict_get(req, "headers", {})
	session_id := get_header(headers, "x-observe-session-id")
	if session_id != "" {
		return normalize_identifier(session_id)
	}

	if type(parsed_payload) == "dict" {
		session_id := string_dict_get(parsed_payload, "session_id", "")
		if session_id != "" {
			return normalize_identifier(session_id)
		}
	}

	return normalize_identifier("session_" + to_string(current_timestamp()))
}

