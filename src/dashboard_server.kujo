server := server.route("GET", "/api/admin/diagnostics", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}

	migration_rows := db_query(db, "SELECT key, applied_at FROM schema_migrations ORDER BY key ASC", [])
	request_rows := db_query(db, "SELECT COUNT(*) AS n FROM requests", [])
	tool_rows := db_query(db, "SELECT COUNT(*) AS n FROM tool_calls", [])
	step_rows := db_query(db, "SELECT COUNT(*) AS n FROM agent_steps", [])
	audit_rows := db_query(db, "SELECT COUNT(*) AS n FROM audit_events", [])
	trace_rows := db_query(db, "SELECT COUNT(*) AS n FROM traces", [])
	span_rows := db_query(db, "SELECT COUNT(*) AS n FROM trace_spans", [])
	event_rows := db_query(db, "SELECT COUNT(*) AS n FROM trace_events", [])
	backup_run_rows := db_query(db, "SELECT COUNT(*) AS n FROM backup_runs", [])
	backup_settings := read_backup_settings()

	diagnostics := {
		"runtime": {
			"port": PORT,
			"db_path": DB_PATH,
			"proxy_config_path": PROXY_CONFIG_PATH,
			"proxy_config_visibility": PROXY_CONFIG_VISIBILITY,
			"api_auth_mode": API_AUTH_MODE,
			"api_auth_token_present": API_AUTH_TOKEN != "",
			"proxy_auth_mode": PROXY_AUTHZ_MODE,
			"proxy_auth_token_present": PROXY_AUTHZ_TOKEN != "",
			"rate_limit_mode": RATE_LIMIT_MODE,
			"rate_limit_max_requests": RATE_LIMIT_MAX_REQUESTS,
			"rate_limit_window_secs": RATE_LIMIT_WINDOW_SECS,
			"rate_limit_max_buckets": RATE_LIMIT_MAX_BUCKETS,
			"rate_limit_bucket_ttl_secs": RATE_LIMIT_BUCKET_TTL_SECS,
			"redaction_mode": REDACTION_MODE,
			"identifier_max_len": IDENTIFIER_MAX_LEN,
			"export_max_rows": EXPORT_MAX_ROWS,
			"backup_enabled": backup_settings["enabled"],
			"backup_interval_minutes": backup_settings["interval_minutes"],
			"backup_encryption_enabled": backup_settings["encryption_enabled"],
			"backup_encryption_key_configured": BACKUP_ENCRYPTION_KEY_FILE != ""
		},
		"migrations": migration_rows,
		"db_stats": {
			"requests": to_int_or_zero(request_rows[0]["n"]),
			"tool_calls": to_int_or_zero(tool_rows[0]["n"]),
			"agent_steps": to_int_or_zero(step_rows[0]["n"]),
			"audit_events": to_int_or_zero(audit_rows[0]["n"]),
			"traces": to_int_or_zero(trace_rows[0]["n"]),
			"trace_spans": to_int_or_zero(span_rows[0]["n"]),
			"trace_events": to_int_or_zero(event_rows[0]["n"]),
			"backup_runs": to_int_or_zero(backup_run_rows[0]["n"])
		}
	}

	return api_ok(diagnostics)
})

server := server.route("GET", "/api/admin/backups", func(req) {
