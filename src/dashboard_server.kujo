# External telemetry intake for trusted local applications that do not route
# their provider traffic through the Watchdog proxy (for example Codex CLI).
server := server.route("POST", "/api/telemetry/requests", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}
	maybe_run_scheduled_backup()

	body_parse := parse_json_with_limit(to_string(safe_dict_get(req, "body", "{}")), MAX_PARSE_BODY_BYTES)
	if !body_parse["ok"] || type(body_parse["data"]) != "dict" {
		return api_error(400, "Request body must be a JSON object")
	}
	schema_error := telemetry_schema_error(body_parse["data"])
	if schema_error != "" {
		return api_error(400, schema_error)
	}
	metric_error := negative_token_metric_error(body_parse["data"])
	if metric_error != "" {
		return api_error(400, metric_error)
	}
	try {
		result := insert_external_request(body_parse["data"])
		if !result["ok"] {
			return api_error(400, result["error"])
		}
		insert_audit_event("external_telemetry_intake", resolve_audit_actor_key(req, "api"), "success", {
			"request_dbid": result["id"],
			"deduplicated": result["deduplicated"],
			"source_app": external_text(body_parse["data"], "source_app", "external", 80)
		})
		return api_ok(result)
	} except err {
		print("External telemetry intake failed: " + to_string(err))
		return api_error(500, "External telemetry intake failed")
	}
})

# Append spans/events to an existing trace without requiring another model
# request row. This keeps each producer independently usable while preserving
# one optional, provider-neutral telemetry contract.
server := server.route("POST", "/api/telemetry/traces", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}
	maybe_run_scheduled_backup()
	body_parse := parse_json_with_limit(to_string(safe_dict_get(req, "body", "{}")), MAX_PARSE_BODY_BYTES)
	if !body_parse["ok"] || type(body_parse["data"]) != "dict" {
		return api_error(400, "Request body must be a JSON object")
	}
	body := body_parse["data"]
	schema_error := telemetry_schema_error(body)
	if schema_error != "" {
		return api_error(400, schema_error)
	}
	metric_error := negative_token_metric_error(body)
	if metric_error != "" {
		return api_error(400, metric_error)
	}
	trace_id := external_text(body, "trace_id", "", 160)
	trace := safe_dict_get(body, "trace", {})
	if trace_id == "" && type(trace) == "dict" {
		trace_id = external_text(trace, "trace_id", "", 160)
	}
	if trace_id == "" {
		return api_error(400, "trace_id is required")
	}
	source_app := external_text(body, "source_app", "external", 80)
	session_id := external_text(body, "session_id", "", 160)
	result := insert_trace_bundle(to_int_or_zero(safe_dict_get(body, "request_dbid", 0)), body, source_app, session_id, "external")
	return api_ok(result)
})

# Canonical ingestion is separate from dashboard/internal API routes. Adapters
# submit normalized records; Watchdog applies privacy policy before persistence.
server := server.route("POST", "/telemetry/v2/batches", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}
	maybe_run_scheduled_backup()
	body_parse := parse_json_with_limit(to_string(safe_dict_get(req, "body", "{}")), MAX_PARSE_BODY_BYTES)
	if !body_parse["ok"] || type(body_parse["data"]) != "dict" {
		return api_error(400, "Request body must be a canonical telemetry batch object")
	}
	body := body_parse["data"]
	if external_text(body, "schema_version", "", 80) != CANONICAL_TELEMETRY_SCHEMA_VERSION {
		return api_error(400, "Unsupported canonical telemetry schema_version")
	}
	approved := canonical_policy_batch(body)
	validation := watchdog_telemetry_repository_validate(approved)
	if validation["ok"] == false {
		if safe_dict_get(validation, "error_code", "") == "invalid_semantics" { return api_error_code(400, "invalid_semantics", validation["error"]) }
		return api_error(400, validation["error"])
	}
	try {
		result := persist_canonical_batch(body)
		if result["ok"] == false && safe_dict_get(result, "error_code", "") == "record_identity_conflict" {
			insert_audit_event("canonical_telemetry_intake", resolve_audit_actor_key(req, "api"), "conflict", {"batch_id": external_text(body, "batch_id", "", 160), "producer": external_text(safe_dict_get(body, "producer", {}), "name", "external", 80), "error_code": "record_identity_conflict"})
			return api_error(409, "record_identity_conflict")
		}
		insert_audit_event("canonical_telemetry_intake", resolve_audit_actor_key(req, "api"), "success", {
			"batch_id": external_text(body, "batch_id", "", 160),
			"producer": external_text(safe_dict_get(body, "producer", {}), "name", "external", 80),
			"records": result["records"],
			"deduplicated": result["deduplicated"]
		})
		return api_ok(result)
	} except err {
		print("Canonical telemetry intake failed: " + to_string(err))
		return api_error(500, "Canonical telemetry intake failed")
	}
})

server := server.route("GET", "/api/telemetry/v2/records", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}
	limit_value := request_query_int(req, "limit", 200, 1, 500)
	cursor := request_query_int(req, "before", 2147483647, 1, 2147483647)
	conditions := ["id < ?"]
	params := [cursor]
	trace_id := request_query_text(req, "trace_id", "")
	if trace_id != "" {
		conditions = push(conditions, "trace_id = ?")
		params = push(params, trace_id)
	}
	kind := request_query_text(req, "kind", "")
	if kind != "" {
		conditions = push(conditions, "kind = ?")
		params = push(params, kind)
	}
	producer := request_query_text(req, "producer", "")
	if producer != "" {
		conditions = push(conditions, "producer_name = ?")
		params = push(params, producer)
	}
	params = push(params, limit_value)
	rows := db_query(db, "SELECT id, canonical_json FROM telemetry_records_v2 WHERE " + join(conditions, " AND ") + " ORDER BY id DESC LIMIT ?", params)
	records := []
	next_cursor := null
	for row in rows {
		parsed := parse_json_safe(row["canonical_json"])
		if parsed["ok"] {
			records = push(records, {"ingest_sequence": row["id"], "record": parsed["data"]})
			next_cursor = row["id"]
		}
	}
	return api_ok({"schema_version": CANONICAL_TELEMETRY_SCHEMA_VERSION, "records": records, "next_before": next_cursor})
})

server := server.route("GET", "/telemetry/v2/jsonl", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] { return api_error(auth["status"], auth["error"]) }
	cursor_result := jsonl_v2_cursor_sequence(request_query_text(req, "cursor", ""))
	if cursor_result["ok"] == false { return api_error(400, "Invalid JSONL v2 cursor") }
	limit_value := request_query_int(req, "limit", 500, 1, 5000)
	rows := db_query(db, "SELECT id, producer_name, record_id, canonical_json FROM telemetry_records_v2 WHERE id > ? ORDER BY id ASC LIMIT ?", [cursor_result["sequence"], limit_value])
	return jsonl_v2_response(rows, to_string(current_timestamp()), cursor_result["sequence"])
})

server := server.route("POST", "/telemetry/v2/jsonl/replay", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] { return api_error(auth["status"], auth["error"]) }
	body := to_string(safe_dict_get(req, "body", ""))
	if utf8_byte_length(body) > MAX_PARSE_BODY_BYTES { return api_error(400, "JSONL replay body exceeds configured parse limit") }
	lines := split(body, "\n")
	accepted := 0
	deduplicated := 0
	for line in lines {
		text := trim(line)
		if text != "" {
			if accepted + deduplicated >= 100 { return api_error(400, "JSONL replay accepts at most 100 records") }
			parsed := parse_json_safe(text)
			if parsed["ok"] == false || type(parsed["data"]) != "dict" { return api_error(400, "Invalid JSONL replay line") }
			envelope := parsed["data"]
			if safe_dict_get(envelope, "jsonl_version", "") != JSONL_V2_VERSION || safe_dict_get(envelope, "schema_version", "") != CANONICAL_TELEMETRY_SCHEMA_VERSION {
				return api_error(400, "Unsupported JSONL replay version")
			}
			record := safe_dict_get(envelope, "record", null)
			if type(record) != "dict" { return api_error(400, "JSONL replay line is missing record") }
			producer_name := truncate_str(trim(to_string(safe_dict_get(envelope, "producer", "jsonl-replay"))), 80)
			batch := {
				"schema_version": CANONICAL_TELEMETRY_SCHEMA_VERSION,
				"batch_id": "replay:" + substring(sha256(text), 0, 32),
				"sent_at": null,
				"producer": {"name": producer_name, "version": "jsonl-v2", "adapter_id": "watchdog.jsonl-replay", "adapter_version": "watchdog.ingestion-adapter.v1", "original_schema": JSONL_V2_VERSION},
				"records": [record]
			}
			result := persist_canonical_batch(batch)
			if result["ok"] == false {
				if safe_dict_get(result, "error_code", "") == "record_identity_conflict" { return api_error(409, "record_identity_conflict") }
				return api_error(400, result["error"])
			}
			if result["deduplicated"] { deduplicated = deduplicated + 1 } else { accepted = accepted + 1 }
		}
	}
	return api_ok({"accepted": accepted, "deduplicated": deduplicated, "jsonl_version": JSONL_V2_VERSION})
})

server := server.route("POST", "/telemetry/v2/otlp/v1/traces", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] { return api_error(auth["status"], auth["error"]) }
	headers := safe_dict_get(req, "headers", {})
	content_type := to_lower(get_header(headers, "Content-Type"))
	content_encoding := to_lower(trim(get_header(headers, "Content-Encoding")))
	if content_encoding != "" && content_encoding != "identity" && content_encoding != "gzip" {
		return api_error(415, "Unsupported OTLP content encoding")
	}
	is_protobuf := contains(content_type, "application/x-protobuf") > 0
	is_json := contains(content_type, "application/json") > 0
	if is_protobuf == false && is_json == false {
		response := api_error(415, "Guarded OTLP ingest accepts OTLP/HTTP JSON or Protobuf")
		response = set_header(response, "Accept-Post", "application/json, application/x-protobuf")
		return response
	}
	body_text := to_string(safe_dict_get(req, "body", "{}"))
	body_bytes := safe_dict_get(req, "body_bytes", bytes([]))
	if type(body_bytes) != "bytes" { return api_error(400, "OTLP request body is unavailable") }
	if content_encoding == "gzip" {
		try { body_bytes = gzip_decompress(body_bytes, MAX_PARSE_BODY_BYTES) } except err { return api_error(400, "Invalid or over-limit OTLP gzip body") }
		try { body_text = decode_base64_utf8(encode_base64(body_bytes)) } except err { body_text = "" }
	}
	payload := null
	original_schema := "otlp-json"
	body_hash_input := body_text
	if is_protobuf {
		if len(body_bytes) > MAX_PARSE_BODY_BYTES { return api_error(400, "OTLP Protobuf body exceeds configured parse limit") }
		decoded := watchdog_otlp_protobuf_decode(body_bytes)
		if decoded["ok"] == false { return api_error(400, "Invalid OTLP Protobuf trace request") }
		payload = decoded["payload"]
		original_schema = "otlp-protobuf"
		body_hash_input = encode_base64(body_bytes)
	} else {
		parsed := parse_json_with_limit(body_text, MAX_PARSE_BODY_BYTES)
		if parsed["ok"] == false || type(parsed["data"]) != "dict" { return api_error(400, "Invalid OTLP JSON trace request") }
		payload = parsed["data"]
	}
	mapped := watchdog_otlp_ingest_map(payload)
	if mapped["ok"] == false { return api_error(400, mapped["error"]) }
	batch := {
		"schema_version": CANONICAL_TELEMETRY_SCHEMA_VERSION,
		"batch_id": "otlp:" + substring(sha256(body_hash_input), 0, 32),
		"sent_at": null,
		"producer": {"name": mapped["producer"], "version": "unknown", "adapter_id": "watchdog.otlp-ingest", "adapter_version": "watchdog.ingestion-adapter.v1", "original_schema": original_schema},
		"records": mapped["records"]
	}
	try {
		result := persist_canonical_batch(batch)
		insert_audit_event("guarded_otlp_trace_intake", resolve_audit_actor_key(req, "api"), "success", {"producer": mapped["producer"], "accepted_records": result["records"], "rejected_spans": mapped["rejected"]})
		message := ""
		if mapped["rejected"] > 0 { message = "Generic, invalid, or over-limit spans were rejected" }
		response := null
		if is_protobuf {
			response = http_response(200, watchdog_otlp_protobuf_encode_response(mapped["rejected"], message))
			response = set_header(response, "Content-Type", "application/x-protobuf")
		} else {
			response = json_response(200, {"partialSuccess": {"rejectedSpans": mapped["rejected"], "errorMessage": message}})
		}
		return apply_default_security_headers(response)
	} except err {
		print("Guarded OTLP intake failed: " + to_string(err))
		return api_error(500, "Guarded OTLP intake failed")
	}
})

