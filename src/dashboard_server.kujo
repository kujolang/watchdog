print("Database ready: " + DB_PATH)

# ---------------------------------------------------------------------------
# Logging helpers
# ---------------------------------------------------------------------------

func insert_request_row(session_id, user_id, tenant_id, project_id, workflow_id, task_id, correlation_id, provider, model, request_id, status, input_tokens, output_tokens, total_tokens, cost_usd, latency_ms, finish_reason, error_code, error_message, prompt_summary, response_summary) {
	ts := to_string(current_timestamp())
	source_app := "watchdog-proxy"
	if trim(project_id) != "" { source_app = trim(project_id) }
	clean_error_message := redact_sensitive_text(error_message)
	clean_prompt_summary := redact_sensitive_text(prompt_summary)
	clean_response_summary := redact_sensitive_text(response_summary)
	db_execute(db, "INSERT INTO requests (session_id, user_id, tenant_id, project_id, workflow_id, task_id, correlation_id, provider, model, request_id, status, input_tokens, output_tokens, total_tokens, cost_usd, latency_ms, finish_reason, error_code, error_message, prompt_summary, response_summary, source_app, data_class, created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)", [session_id, user_id, tenant_id, project_id, workflow_id, task_id, correlation_id, provider, model, request_id, status, input_tokens, output_tokens, total_tokens, cost_usd, latency_ms, finish_reason, error_code, clean_error_message, clean_prompt_summary, clean_response_summary, source_app, "live", ts])

	rows := db_query(db, "SELECT last_insert_rowid() AS id", [])
	if len(rows) > 0 {
		return rows[0]["id"]
	}
	return 0
}

func insert_tool_call_row(request_dbid, session_id, tool_name, tool_args, tool_result, status, latency_ms) {
	ts := to_string(current_timestamp())
	args_str := tool_args
	if type(tool_args) == "dict" {
		args_str := to_json(redact_dict_shallow(tool_args))
	} else {
		args_str := redact_sensitive_text(args_str)
	}
	result_str := tool_result
	if type(tool_result) == "dict" {
		result_str := to_json(redact_dict_shallow(tool_result))
	} else {
		result_str := redact_sensitive_text(result_str)
	}
	db_execute(db, "INSERT INTO tool_calls (request_dbid, session_id, tool_name, tool_args, tool_result, status, latency_ms, source_app, data_class, created_at) VALUES (?,?,?,?,?,?,?,?,?,?)", [request_dbid, session_id, tool_name, args_str, result_str, status, latency_ms, "watchdog-proxy", "live", ts])
}

func next_step_number(session_id) {
	rows := db_query(db, "SELECT COALESCE(MAX(step_number), 0) AS n FROM agent_steps WHERE session_id = ?", [session_id])
	if len(rows) == 0 {
		return 1
	}
	return to_int_or_zero(rows[0]["n"]) + 1
}

func insert_agent_step_row(session_id, agent_id, step_type, content, metadata) {
	step_number := next_step_number(session_id)
	ts := to_string(current_timestamp())
	meta_str := metadata
	if type(metadata) == "dict" {
		meta_str := to_json(redact_dict_shallow(metadata))
	} else {
		meta_str := redact_sensitive_text(meta_str)
	}
	clean_content := truncate_str(redact_sensitive_text(content), 500)
	db_execute(db, "INSERT INTO agent_steps (session_id, agent_id, step_number, step_type, content, metadata, source_app, data_class, created_at) VALUES (?,?,?,?,?,?,?,?,?)", [session_id, agent_id, step_number, step_type, clean_content, meta_str, "watchdog-proxy", "live", ts])
}

func external_text(body, key, fallback_value, max_len) {
	value := trim(to_string(safe_dict_get(body, key, fallback_value)))
	return truncate_str(redact_sensitive_text(value), max_len)
}

func external_json_summary(value, max_len) {
	serialized := value
	if type(value) == "dict" || type(value) == "array" {
		serialized = to_json(value)
	}
	return truncate_str(redact_sensitive_text(to_string(serialized)), max_len)
}

func insert_trace_bundle(request_dbid, body, source_app, session_id, data_class) {
	trace := safe_dict_get(body, "trace", {})
	has_trace_payload := has_key(body, "trace") != 0 && type(trace) == "dict"
	if type(trace) != "dict" {
		trace = {}
	}
	trace_id := external_text(trace, "trace_id", external_text(body, "trace_id", "", 160), 160)
	if trace_id == "" {
		return {"trace_id": "", "spans": 0, "events": 0, "tool_calls": 0}
	}

	ts := to_string(current_timestamp())
	started_at_ms := to_int_or_zero(safe_dict_get(trace, "started_at_ms", 0))
	ended_at_ms := to_int_or_zero(safe_dict_get(trace, "ended_at_ms", started_at_ms))
	duration_ms := to_int_or_zero(safe_dict_get(trace, "duration_ms", ended_at_ms - started_at_ms))
	input_tokens := to_int_or_zero(safe_dict_get(body, "input_tokens", safe_dict_get(trace, "input_tokens", 0)))
	output_tokens := to_int_or_zero(safe_dict_get(body, "output_tokens", safe_dict_get(trace, "output_tokens", 0)))
	cached_tokens := to_int_or_zero(safe_dict_get(trace, "cached_input_tokens", 0))
	cache_write_tokens := to_int_or_zero(safe_dict_get(trace, "cache_write_input_tokens", 0))
	model_name := external_text(body, "model", external_text(trace, "model", "", 160), 160)
	rates := watchdog_cost_per_million(model_name)
	pricing_source := ""
	input_cost := 0.0
	output_cost := 0.0
	if watchdog_has_known_pricing(model_name) {
		pricing_source = "watchdog-direct-provider-table"
		input_cost = (input_tokens / 1000000.0) * rates["input"]
		output_cost = (output_tokens / 1000000.0) * rates["output"]
	}
	if has_trace_payload {
		db_execute(db, "INSERT INTO traces (trace_id, request_dbid, session_id, source_app, data_class, name, status, started_at_ms, ended_at_ms, duration_ms, input_tokens, output_tokens, cached_input_tokens, cache_write_input_tokens, input_cost_usd, output_cost_usd, input_rate_per_million, output_rate_per_million, pricing_source, attributes_json, created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?) ON CONFLICT(trace_id) DO UPDATE SET status = excluded.status, ended_at_ms = CASE WHEN excluded.ended_at_ms > traces.ended_at_ms THEN excluded.ended_at_ms ELSE traces.ended_at_ms END, duration_ms = CASE WHEN excluded.ended_at_ms > traces.ended_at_ms THEN excluded.ended_at_ms - traces.started_at_ms ELSE traces.duration_ms END, input_tokens = traces.input_tokens + excluded.input_tokens, output_tokens = traces.output_tokens + excluded.output_tokens, cached_input_tokens = traces.cached_input_tokens + excluded.cached_input_tokens, cache_write_input_tokens = traces.cache_write_input_tokens + excluded.cache_write_input_tokens, input_cost_usd = traces.input_cost_usd + excluded.input_cost_usd, output_cost_usd = traces.output_cost_usd + excluded.output_cost_usd, attributes_json = excluded.attributes_json", [trace_id, request_dbid, session_id, source_app, data_class, external_text(trace, "name", "interactive_chat", 120), external_text(trace, "status", "success", 32), started_at_ms, ended_at_ms, duration_ms, input_tokens, output_tokens, cached_tokens, cache_write_tokens, input_cost, output_cost, rates["input"], rates["output"], pricing_source, external_json_summary(safe_dict_get(trace, "attributes", {}), 12000), ts])
	}

	span_count := 0
	spans := safe_dict_get(body, "spans", [])
	if type(spans) == "array" {
		for span in spans {
			if span_count < 128 && type(span) == "dict" {
				span_id := external_text(span, "span_id", "", 160)
				if span_id != "" {
					span_started := to_int_or_zero(safe_dict_get(span, "started_at_ms", started_at_ms))
					span_ended := to_int_or_zero(safe_dict_get(span, "ended_at_ms", span_started))
					span_duration := to_int_or_zero(safe_dict_get(span, "duration_ms", span_ended - span_started))
					db_execute(db, "INSERT OR IGNORE INTO trace_spans (trace_id, span_id, parent_span_id, request_dbid, session_id, source_app, data_class, span_kind, name, status, started_at_ms, ended_at_ms, duration_ms, attributes_json, created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)", [trace_id, span_id, external_text(span, "parent_span_id", "", 160), request_dbid, session_id, source_app, data_class, external_text(span, "span_kind", "internal", 40), external_text(span, "name", "span", 120), external_text(span, "status", "success", 32), span_started, span_ended, span_duration, external_json_summary(safe_dict_get(span, "attributes", {}), 12000), ts])
					span_count = span_count + 1
				}
			}
		}
	}

	event_count := 0
	events := safe_dict_get(body, "events", [])
	if type(events) == "array" {
		for event in events {
			if event_count < 512 && type(event) == "dict" {
				event_id := external_text(event, "event_id", "event-" + to_string(event_count), 160)
				db_execute(db, "INSERT OR IGNORE INTO trace_events (event_id, trace_id, span_id, sequence, event_name, occurred_at_ms, attributes_json, source_app, data_class, created_at) VALUES (?,?,?,?,?,?,?,?,?,?)", [event_id, trace_id, external_text(event, "span_id", "", 160), to_int_or_zero(safe_dict_get(event, "sequence", event_count)), external_text(event, "event_name", "event", 120), to_int_or_zero(safe_dict_get(event, "occurred_at_ms", started_at_ms)), external_json_summary(safe_dict_get(event, "attributes", {}), 12000), source_app, data_class, ts])
				event_count = event_count + 1
			}
		}
	}

	tool_count := 0
	tool_calls := safe_dict_get(body, "tool_calls", [])
	if type(tool_calls) == "array" {
		for tool_call in tool_calls {
			if tool_count < 64 && type(tool_call) == "dict" {
				db_execute(db, "INSERT INTO tool_calls (request_dbid, session_id, tool_name, tool_args, tool_result, status, latency_ms, source_app, data_class, created_at) VALUES (?,?,?,?,?,?,?,?,?,?)", [request_dbid, session_id, external_text(tool_call, "tool_name", "unknown", 120), external_json_summary(safe_dict_get(tool_call, "arguments", {}), 4000), external_json_summary(safe_dict_get(tool_call, "result", {}), 8000), external_text(tool_call, "status", "success", 32), to_int_or_zero(safe_dict_get(tool_call, "latency_ms", 0)), source_app, data_class, ts])
				tool_count = tool_count + 1
			}
		}
	}

	return {"trace_id": trace_id, "spans": span_count, "events": event_count, "tool_calls": tool_count}
}

func insert_external_request(body) {
	source_app := external_text(body, "source_app", "external", 80)
	request_id := external_text(body, "request_id", "", 160)
	if request_id == "" {
		return {"ok": false, "error": "request_id is required"}
	}

	existing := db_query(db, "SELECT id FROM requests WHERE source_app = ? AND request_id = ? LIMIT 1", [source_app, request_id])
	if len(existing) > 0 {
		return {"ok": true, "id": existing[0]["id"], "deduplicated": true}
	}

	status := to_lower(external_text(body, "status", "success", 32))
	if status != "success" && status != "error" && status != "completed" && status != "cancelled" {
		status := "error"
	}
	input_tokens := to_int_or_zero(safe_dict_get(body, "input_tokens", 0))
	output_tokens := to_int_or_zero(safe_dict_get(body, "output_tokens", 0))
	total_tokens := to_int_or_zero(safe_dict_get(body, "total_tokens", input_tokens + output_tokens))
	model_name := external_text(body, "model", "", 160)
	cost_usd := safe_dict_get(body, "cost_usd", 0.0)
	if has_key(body, "cost_usd") == 0 && watchdog_has_known_pricing(model_name) {
		cost_usd = watchdog_estimate_cost(model_name, input_tokens * 1.0, output_tokens * 1.0)
	}
	latency_ms := to_int_or_zero(safe_dict_get(body, "latency_ms", 0))
	ts := to_string(current_timestamp())

	db_execute(db, "INSERT INTO requests (session_id, user_id, tenant_id, project_id, workflow_id, task_id, correlation_id, provider, model, request_id, status, input_tokens, output_tokens, total_tokens, cost_usd, latency_ms, finish_reason, error_code, error_message, prompt_summary, response_summary, source_app, data_class, created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)", [external_text(body, "session_id", request_id, 160), external_text(body, "user_id", "", 120), external_text(body, "tenant_id", "", 120), external_text(body, "project_id", "", 120), external_text(body, "workflow_id", "", 120), external_text(body, "task_id", "", 160), external_text(body, "correlation_id", "", 160), external_text(body, "provider", "external", 160), model_name, request_id, status, input_tokens, output_tokens, total_tokens, cost_usd, latency_ms, external_text(body, "finish_reason", "", 80), external_text(body, "error_code", "", 80), external_text(body, "error_message", "", 500), external_text(body, "prompt_summary", "", 500), external_text(body, "response_summary", "", 500), source_app, "external", ts])
	rows := db_query(db, "SELECT last_insert_rowid() AS id", [])
	request_dbid := 0
	if len(rows) > 0 {
		request_dbid := rows[0]["id"]
	}

	session_id := external_text(body, "session_id", request_id, 160)
	step_number := next_step_number(session_id)
	db_execute(db, "INSERT INTO agent_steps (session_id, agent_id, step_number, step_type, content, metadata, source_app, data_class, created_at) VALUES (?,?,?,?,?,?,?,?,?)", [session_id, external_text(body, "agent_id", source_app, 120), step_number, external_text(body, "step_type", "request_completed", 80), external_text(body, "response_summary", "External telemetry recorded", 500), to_json({"request_dbid": request_dbid, "task_id": external_text(body, "task_id", "", 160), "correlation_id": external_text(body, "correlation_id", "", 160)}), source_app, "external", ts])
	trace_result := insert_trace_bundle(request_dbid, body, source_app, session_id, "external")
	return {"ok": true, "id": request_dbid, "deduplicated": false, "trace": trace_result}
}

func insert_audit_event(action, actor_key, result, metadata) {
	ts := to_string(current_timestamp())
	meta_str := metadata
	if type(metadata) == "dict" {
		meta_str := to_json(redact_dict_shallow(metadata))
	} else {
		meta_str := redact_sensitive_text(meta_str)
	}

	db_execute(db, "INSERT INTO audit_events (action, actor_key, result, metadata, created_at) VALUES (?,?,?,?,?)", [
		truncate_str(to_string(action), 80),
		truncate_str(to_string(actor_key), 160),
		truncate_str(to_string(result), 40),
		meta_str,
		ts
	])
}

# ---------------------------------------------------------------------------
# Automated database backups
# ---------------------------------------------------------------------------

BACKUP_IN_PROGRESS := false

func backup_process_success(proc) {
	if type(proc) == "dict" {
		return parse_bool_value(safe_dict_get(proc, "success", false), false)
	}
	try {
		return parse_bool_value(proc.success, false)
	} except err {
		return false
	}
}

func backup_process_exitcode(proc) {
	if type(proc) == "dict" {
		return to_int_or_zero(safe_dict_get(proc, "exitcode", 127))
	}
	try {
		return to_int_or_zero(proc.exitcode)
	} except err {
		return 127
	}
}

func backup_process_stdout(proc) {
	if type(proc) == "dict" {
		return to_string(safe_dict_get(proc, "stdout", ""))
	}
	try {
		return to_string(proc.stdout)
	} except err {
		return ""
	}
}

func backup_process_stderr(proc) {
	if type(proc) == "dict" {
		return to_string(safe_dict_get(proc, "stderr", ""))
	}
	try {
		return to_string(proc.stderr)
	} except err {
		return ""
	}
}

func bool_as_int(value) {
	if parse_bool_value(value, false) {
		return 1
	}
	return 0
}

func validate_backup_dir(raw_value) {
	dir := trim(to_string(raw_value))
	if dir == "" {
		return {"ok": false, "error": "Backup directory is required"}
	}
	if contains(dir, "\n") || contains(dir, "\r") {
		return {"ok": false, "error": "Backup directory contains unsupported control characters"}
	}
	parts := split(replace(dir, "\\", "/"), "/")
	for part in parts {
		if trim(to_string(part)) == ".." {
			return {"ok": false, "error": "Backup directory must not contain parent-directory segments"}
		}
	}
	return {"ok": true, "path": dir, "error": ""}
}

func read_backup_settings() {
	rows := db_query(db, "SELECT enabled, interval_minutes, backup_dir, retention_count, encryption_enabled, updated_at_ms FROM backup_settings WHERE id = 1 LIMIT 1", [])
	if len(rows) == 0 {
		return {
			"enabled": BACKUP_DEFAULT_ENABLED,
			"interval_minutes": BACKUP_DEFAULT_INTERVAL_MINUTES,
			"backup_dir": BACKUP_DEFAULT_DIR,
			"retention_count": BACKUP_DEFAULT_RETENTION_COUNT,
			"encryption_enabled": BACKUP_DEFAULT_ENCRYPTION_ENABLED,
			"updated_at_ms": 0
		}
	}
	row := rows[0]
	return {
		"enabled": to_int_or_zero(row["enabled"]) == 1,
		"interval_minutes": to_int_or_zero(row["interval_minutes"]),
		"backup_dir": to_string(row["backup_dir"]),
		"retention_count": to_int_or_zero(row["retention_count"]),
		"encryption_enabled": to_int_or_zero(row["encryption_enabled"]) == 1,
		"updated_at_ms": to_int_or_zero(row["updated_at_ms"])
	}
}

func backup_last_success_ms() {
	rows := db_query(db, "SELECT COALESCE(MAX(finished_at_ms),0) AS last_success_ms FROM backup_runs WHERE status = 'success'", [])
	return to_int_or_zero(rows[0]["last_success_ms"])
}

func backup_last_attempt_ms() {
	rows := db_query(db, "SELECT COALESCE(MAX(started_at_ms),0) AS last_attempt_ms FROM backup_runs", [])
	return to_int_or_zero(rows[0]["last_attempt_ms"])
}

func backup_runs(limit_value) {
	return db_query(db, "SELECT id, trigger_type, status, backup_path, checksum_path, size_bytes, encrypted, error_message, started_at_ms, finished_at_ms FROM backup_runs ORDER BY started_at_ms DESC LIMIT ?", [limit_value])
}

func backup_status_payload() {
	settings := read_backup_settings()
	last_success_ms := backup_last_success_ms()
	next_due_at_ms := 0
	if settings["enabled"] {
		next_due_at_ms = last_success_ms + (settings["interval_minutes"] * 60 * 1000)
		if last_success_ms == 0 {
			next_due_at_ms = current_timestamp()
		}
	}
	return {
		"settings": settings,
		"encryption_key_configured": BACKUP_ENCRYPTION_KEY_FILE != "",
		"backup_in_progress": BACKUP_IN_PROGRESS,
		"last_success_at_ms": last_success_ms,
		"next_due_at_ms": next_due_at_ms,
		"runs": backup_runs(25),
		"limits": {
			"min_interval_minutes": MIN_BACKUP_INTERVAL_MINUTES,
			"max_interval_minutes": MAX_BACKUP_INTERVAL_MINUTES,
			"max_retention_count": 3650
		}
	}
}

func create_backup_run(trigger_type) {
	if BACKUP_IN_PROGRESS {
		return {"ok": false, "error": "A Watchdog backup is already in progress"}
	}
	BACKUP_IN_PROGRESS = true
	started_ms := current_timestamp()
	settings := read_backup_settings()
	run_id := 0

	if settings["encryption_enabled"] && BACKUP_ENCRYPTION_KEY_FILE == "" {
		error_message := "Backup encryption is enabled but WDG_BACKUP_ENCRYPTION_KEY_FILE is not configured"
		db_execute(db, "INSERT INTO backup_runs (trigger_type, status, error_message, started_at_ms, finished_at_ms) VALUES (?, 'failed', ?, ?, ?)", [trigger_type, error_message, started_ms, current_timestamp()])
		id_rows := db_query(db, "SELECT last_insert_rowid() AS id", [])
		run_id = to_int_or_zero(id_rows[0]["id"])
		insert_audit_event("backup_operation", "system", "failed", {"trigger": trigger_type, "reason": "encryption_key_not_configured"})
		BACKUP_IN_PROGRESS = false
		return {"ok": false, "error": error_message}
	}

	args := [NODE_BIN, BACKUP_SCRIPT_PATH, "--db", DB_PATH, "--out-dir", settings["backup_dir"], "--retention-count", to_string(settings["retention_count"])]
	result_path := ".watchdog-backup-result-" + to_string(current_timestamp()) + "-" + to_string(random_int(100000, 999999)) + ".json"
	args := push(args, "--result-file")
	args := push(args, result_path)
	if settings["encryption_enabled"] {
		args := push(args, "--encryption-key-file")
		args := push(args, BACKUP_ENCRYPTION_KEY_FILE)
		args := push(args, "--openssl-bin")
		args := push(args, OPENSSL_BIN)
	}

	proc := null
	try {
		proc = spawn_process(args)
	} except err {
		proc = {"success": false, "exitcode": 127, "stdout": "", "stderr": to_string(err)}
	}

	stdout_text := trim(backup_process_stdout(proc))
	if file_exists(result_path) {
		try {
			stdout_text = trim(read_file(result_path))
			delete_file(result_path)
		} except cleanup_err {
			# Result cleanup is best-effort; backup success is determined below.
		}
	}
	parsed := parse_json_safe(stdout_text)
	if backup_process_success(proc) && backup_process_exitcode(proc) == 0 && parsed["ok"] && type(parsed["data"]) == "dict" && parse_bool_value(safe_dict_get(parsed["data"], "ok", false), false) {
		data := parsed["data"]
		finished_ms := current_timestamp()
		backup_path := truncate_str(to_string(safe_dict_get(data, "path", "")), 1000)
		checksum_path := truncate_str(to_string(safe_dict_get(data, "checksum_path", "")), 1000)
		size_bytes := to_int_or_zero(safe_dict_get(data, "size_bytes", 0))
		encrypted := bool_as_int(safe_dict_get(data, "encrypted", false))
		db_execute(db, "INSERT INTO backup_runs (trigger_type, status, backup_path, checksum_path, size_bytes, encrypted, started_at_ms, finished_at_ms) VALUES (?, 'success', ?, ?, ?, ?, ?, ?)", [trigger_type, backup_path, checksum_path, size_bytes, encrypted, started_ms, finished_ms])
		id_rows := db_query(db, "SELECT last_insert_rowid() AS id", [])
		run_id = to_int_or_zero(id_rows[0]["id"])
		insert_audit_event("backup_operation", "system", "success", {"trigger": trigger_type, "encrypted": encrypted == 1, "size_bytes": size_bytes})
		BACKUP_IN_PROGRESS = false
		return {"ok": true, "run_id": run_id, "backup_path": backup_path, "checksum_path": checksum_path, "size_bytes": size_bytes, "encrypted": encrypted == 1}
	}

	error_message := "Backup helper failed"
	if parsed["ok"] && type(parsed["data"]) == "dict" {
		error_message = to_string(safe_dict_get(parsed["data"], "error", error_message))
	} else {
		stderr_text := trim(backup_process_stderr(proc))
		if stderr_text != "" {
			error_message = stderr_text
		} else if stdout_text != "" {
			error_message = stdout_text
		}
	}
	error_message = truncate_str(redact_sensitive_text(error_message), 500)
	db_execute(db, "INSERT INTO backup_runs (trigger_type, status, error_message, started_at_ms, finished_at_ms) VALUES (?, 'failed', ?, ?, ?)", [trigger_type, error_message, started_ms, current_timestamp()])
	id_rows := db_query(db, "SELECT last_insert_rowid() AS id", [])
	run_id = to_int_or_zero(id_rows[0]["id"])
	insert_audit_event("backup_operation", "system", "failed", {"trigger": trigger_type, "reason": error_message})
	BACKUP_IN_PROGRESS = false
	return {"ok": false, "run_id": run_id, "error": error_message}
}

func maybe_run_scheduled_backup() {
	settings := read_backup_settings()
	if !settings["enabled"] || BACKUP_IN_PROGRESS {
		return {"ok": true, "ran": false}
	}
	now_ms := current_timestamp()
	last_success_ms := backup_last_success_ms()
	last_attempt_ms := backup_last_attempt_ms()
	interval_ms := settings["interval_minutes"] * 60 * 1000
	if last_success_ms > 0 && now_ms - last_success_ms < interval_ms {
		return {"ok": true, "ran": false}
	}
	if last_attempt_ms > last_success_ms && now_ms - last_attempt_ms < (15 * 60 * 1000) {
		return {"ok": true, "ran": false}
	}
	result := create_backup_run("scheduled")
	return {"ok": result["ok"], "ran": true, "result": result}
}

# ---------------------------------------------------------------------------
# HTTP helpers
# ---------------------------------------------------------------------------

func apply_default_security_headers(response) {
	response := set_header(response, "X-Content-Type-Options", "nosniff")
	response := set_header(response, "X-Frame-Options", "DENY")
	response := set_header(response, "Referrer-Policy", "no-referrer")
	response := set_header(response, "Cache-Control", "no-store")
	return response
}

func api_ok(data) {
	response := apply_default_security_headers(json_response(200, {"ok": true, "data": data}))
	response := set_header(response, "X-Watchdog-API-Version", API_CONTRACT_VERSION)
	return response
}

func api_error(status_code, message) {
	response := apply_default_security_headers(json_response(status_code, {"ok": false, "error": message}))
	response := set_header(response, "X-Watchdog-API-Version", API_CONTRACT_VERSION)
	return response
}

func forward_response(status_code, body_text, content_type) {
	response := http_response(status_code, body_text)
	if content_type != "" {
		response := set_header(response, "Content-Type", content_type)
	}
	response := set_header(response, "X-Watchdog-Proxy", "kujo-watchdog")
	return apply_default_security_headers(response)
}

func export_rows_as_jsonl(request_rows, tool_rows, step_rows, trace_rows, span_rows, event_rows) {
	lines := []

	i := 0
	while i < len(request_rows) {
		lines := push(lines, to_json({
			"kind": "request",
			"data": request_rows[i]
		}))
		i := i + 1
	}

	i := 0
	while i < len(tool_rows) {
		lines := push(lines, to_json({
			"kind": "tool_call",
			"data": tool_rows[i]
		}))
		i := i + 1
	}

	i := 0
	while i < len(step_rows) {
		lines := push(lines, to_json({
			"kind": "agent_step",
			"data": step_rows[i]
		}))
		i := i + 1
	}

	i := 0
	while i < len(trace_rows) {
		lines := push(lines, to_json({"kind": "trace", "data": trace_rows[i]}))
		i := i + 1
	}
	i := 0
	while i < len(span_rows) {
		lines := push(lines, to_json({"kind": "trace_span", "data": span_rows[i]}))
		i := i + 1
	}
	i := 0
	while i < len(event_rows) {
		lines := push(lines, to_json({"kind": "trace_event", "data": event_rows[i]}))
		i := i + 1
	}

	body := ""
	i := 0
	while i < len(lines) {
		if i > 0 {
			body := body + "\n"
		}
		body := body + to_string(lines[i])
		i := i + 1
	}

	response := http_response(200, body)
	response := set_header(response, "Content-Type", "application/x-ndjson")
	return apply_default_security_headers(response)
}

func resolve_session_id(req, parsed_payload) {
	headers := safe_dict_get(req, "headers", {})
	session_id := get_header(headers, "x-observe-session-id")
	if session_id != "" {
		return normalize_identifier(session_id)
	}

	if type(parsed_payload) == "dict" {
		session_id := string_dict_get(parsed_payload, "session_id", "")
		if session_id != "" {
			return normalize_identifier(session_id)
		}
	}

	return normalize_identifier("session_" + to_string(current_timestamp()))
}

