server := server.route("GET", "/api/audit-events", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}

	page := request_query_int(req, "page", 1, 1, 1000000)
	page_size := request_query_int(req, "page_size", 200, 1, 500)
	offset := (page - 1) * page_size

	conditions := []
	params := []

	action := request_query_text(req, "action", "")
	if action != "" {
		conditions := push(conditions, "action = ?")
		params := push(params, action)
	}

	result := request_query_text(req, "result", "")
	if result != "" {
		conditions := push(conditions, "result = ?")
		params := push(params, result)
	}

	time_filter := append_time_range_conditions(req, conditions, params, "created_at")
	conditions := time_filter["conditions"]
	params := time_filter["params"]

	sql := "SELECT id, action, actor_key, result, metadata, created_at FROM audit_events"
	sql := sql + where_clause_from_conditions(conditions)
	sql := sql + " ORDER BY created_at DESC LIMIT ? OFFSET ?"
	params := push(params, page_size)
	params := push(params, offset)

