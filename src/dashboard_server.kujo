	}
	maybe_run_scheduled_backup()
	return api_ok(backup_status_payload())
})

server := server.route("PUT", "/api/admin/backups/settings", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}
	body_parse := parse_json_with_limit(to_string(safe_dict_get(req, "body", "{}")), MAX_PARSE_BODY_BYTES)
	if !body_parse["ok"] || type(body_parse["data"]) != "dict" {
		return api_error(400, "Request body must be a JSON object")
	}
	body := body_parse["data"]
	current := read_backup_settings()
	enabled := parse_bool_value(safe_dict_get(body, "enabled", current["enabled"]), current["enabled"])
	interval_minutes := to_int_or_zero(safe_dict_get(body, "interval_minutes", current["interval_minutes"]))
	retention_count := to_int_or_zero(safe_dict_get(body, "retention_count", current["retention_count"]))
	encryption_enabled := parse_bool_value(safe_dict_get(body, "encryption_enabled", current["encryption_enabled"]), current["encryption_enabled"])
	backup_dir_check := validate_backup_dir(safe_dict_get(body, "backup_dir", current["backup_dir"]))
	if !backup_dir_check["ok"] {
		return api_error(400, backup_dir_check["error"])
	}
	if interval_minutes < MIN_BACKUP_INTERVAL_MINUTES || interval_minutes > MAX_BACKUP_INTERVAL_MINUTES {
		return api_error(400, "Backup interval must be between " + to_string(MIN_BACKUP_INTERVAL_MINUTES) + " and " + to_string(MAX_BACKUP_INTERVAL_MINUTES) + " minutes")
	}
	if retention_count < 1 || retention_count > 3650 {
		return api_error(400, "Backup retention count must be between 1 and 3650")
	}
	if encryption_enabled && BACKUP_ENCRYPTION_KEY_FILE == "" {
		return api_error(400, "Configure WDG_BACKUP_ENCRYPTION_KEY_FILE before enabling encrypted backups")
	}
	db_execute(db, "UPDATE backup_settings SET enabled = ?, interval_minutes = ?, backup_dir = ?, retention_count = ?, encryption_enabled = ?, updated_at_ms = ? WHERE id = 1", [bool_as_int(enabled), interval_minutes, backup_dir_check["path"], retention_count, bool_as_int(encryption_enabled), current_timestamp()])
	insert_audit_event("backup_settings_update", resolve_audit_actor_key(req, "api"), "success", {"enabled": enabled, "interval_minutes": interval_minutes, "retention_count": retention_count, "encryption_enabled": encryption_enabled})
	return api_ok(backup_status_payload())
})

server := server.route("POST", "/api/admin/backups/run", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}
	result := create_backup_run("manual")
	if !result["ok"] {
		return api_error(500, result["error"])
	}
	return api_ok({"run": result, "status": backup_status_payload()})
})

server := server.route("POST", "/api/admin/prune", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}

	body_text := to_string(safe_dict_get(req, "body", "{}"))
	body_parse := parse_json_safe(body_text)
	body := {}
	if body_parse["ok"] {
		if type(body_parse["data"]) == "dict" {
			body := body_parse["data"]
		}
	}

	before_ms := 0
	if has_key(body, "before_ms") {
		before_ms := to_int_or_zero(body["before_ms"])
	}
	if before_ms <= 0 {
		before_ms := request_query_int(req, "before_ms", 0, 0, 9223372036854775807)
	}
	if before_ms <= 0 {
		insert_audit_event("prune_operation", resolve_audit_actor_key(req, "api"), "invalid_request", {
			"reason": "before_ms_invalid"
		})
		return api_error(400, "before_ms is required and must be a positive integer")
	}

	dry_run := true
	if has_key(body, "dry_run") {
		dry_run := parse_bool_value(body["dry_run"], true)
	} else {
		dry_run := parse_bool_value(request_query_text(req, "dry_run", "true"), true)
	}

	request_rows := db_query(db, "SELECT COUNT(*) AS n FROM requests WHERE CAST(created_at AS INTEGER) < ?", [before_ms])
	tool_rows := db_query(db, "SELECT COUNT(*) AS n FROM tool_calls WHERE CAST(created_at AS INTEGER) < ?", [before_ms])
	step_rows := db_query(db, "SELECT COUNT(*) AS n FROM agent_steps WHERE CAST(created_at AS INTEGER) < ?", [before_ms])
	trace_rows := db_query(db, "SELECT COUNT(*) AS n FROM traces WHERE started_at_ms < ?", [before_ms])
	span_rows := db_query(db, "SELECT COUNT(*) AS n FROM trace_spans WHERE started_at_ms < ?", [before_ms])
	event_rows := db_query(db, "SELECT COUNT(*) AS n FROM trace_events WHERE occurred_at_ms < ?", [before_ms])

	counts := {
		"requests": request_rows[0]["n"],
		"tool_calls": tool_rows[0]["n"],
		"agent_steps": step_rows[0]["n"],
		"traces": trace_rows[0]["n"],
		"trace_spans": span_rows[0]["n"],
		"trace_events": event_rows[0]["n"]
	}

	if !dry_run {
		db_execute(db, "DELETE FROM trace_events WHERE occurred_at_ms < ?", [before_ms])
		db_execute(db, "DELETE FROM trace_spans WHERE started_at_ms < ?", [before_ms])
		db_execute(db, "DELETE FROM traces WHERE started_at_ms < ?", [before_ms])
		db_execute(db, "DELETE FROM tool_calls WHERE CAST(created_at AS INTEGER) < ?", [before_ms])
		db_execute(db, "DELETE FROM agent_steps WHERE CAST(created_at AS INTEGER) < ?", [before_ms])
		db_execute(db, "DELETE FROM requests WHERE CAST(created_at AS INTEGER) < ?", [before_ms])
	}

	insert_audit_event("prune_operation", resolve_audit_actor_key(req, "api"), "success", {
		"before_ms": before_ms,
		"dry_run": dry_run,
		"affected": counts
	})

	return api_ok({
		"before_ms": before_ms,
		"dry_run": dry_run,
		"affected": counts
	})
})

server := server.route("POST", "/api/admin/prune-fixtures", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}

	body_parse := parse_json_safe(to_string(safe_dict_get(req, "body", "{}")))
	body := {}
	if body_parse["ok"] && type(body_parse["data"]) == "dict" {
		body := body_parse["data"]
	}
	dry_run := parse_bool_value(safe_dict_get(body, "dry_run", true), true)
	request_rows := db_query(db, "SELECT COUNT(*) AS n FROM requests WHERE data_class = 'fixture'", [])
	tool_rows := db_query(db, "SELECT COUNT(*) AS n FROM tool_calls WHERE data_class = 'fixture'", [])
	step_rows := db_query(db, "SELECT COUNT(*) AS n FROM agent_steps WHERE data_class = 'fixture'", [])
	trace_rows := db_query(db, "SELECT COUNT(*) AS n FROM traces WHERE data_class = 'fixture'", [])
	span_rows := db_query(db, "SELECT COUNT(*) AS n FROM trace_spans WHERE data_class = 'fixture'", [])
	event_rows := db_query(db, "SELECT COUNT(*) AS n FROM trace_events WHERE data_class = 'fixture'", [])
	counts := {"requests": request_rows[0]["n"], "tool_calls": tool_rows[0]["n"], "agent_steps": step_rows[0]["n"], "traces": trace_rows[0]["n"], "trace_spans": span_rows[0]["n"], "trace_events": event_rows[0]["n"]}
	if !dry_run {
		db_execute(db, "DELETE FROM trace_events WHERE data_class = 'fixture'", [])
		db_execute(db, "DELETE FROM trace_spans WHERE data_class = 'fixture'", [])
		db_execute(db, "DELETE FROM traces WHERE data_class = 'fixture'", [])
		db_execute(db, "DELETE FROM tool_calls WHERE data_class = 'fixture'", [])
		db_execute(db, "DELETE FROM agent_steps WHERE data_class = 'fixture'", [])
		db_execute(db, "DELETE FROM requests WHERE data_class = 'fixture'", [])
	}
	insert_audit_event("fixture_prune_operation", resolve_audit_actor_key(req, "api"), "success", {"dry_run": dry_run, "affected": counts})
	return api_ok({"dry_run": dry_run, "affected": counts})
})

server := server.route("GET", "/api/export", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}

	export_format := to_lower(request_query_text(req, "format", "json"))
	if export_format != "json" && export_format != "jsonl" && export_format != "ndjson" {
		return api_error(400, "Unsupported export format. Use json, jsonl, or ndjson")
	}
	max_rows := request_query_int(req, "max_rows", EXPORT_MAX_ROWS, 1, MAX_EXPORT_MAX_ROWS)
	if max_rows > MAX_EXPORT_MAX_ROWS {
		max_rows := MAX_EXPORT_MAX_ROWS
	}
	cursor := request_query_int(req, "cursor", 0, 0, 2147483647)
	chunk_size := request_query_int(req, "chunk_size", max_rows, 1, MAX_EXPORT_MAX_ROWS)
	if chunk_size > max_rows {
		chunk_size := max_rows
	}
	session_id := request_query_text(req, "session_id", "")
	tenant_id := request_query_text(req, "tenant_id", "")
	project_id := request_query_text(req, "project_id", "")
	since_ms := request_query_int(req, "since_ms", 0, 0, 9223372036854775807)
	until_ms := request_query_int(req, "until_ms", 0, 0, 9223372036854775807)

	request_conditions := []
	request_params := []

	if session_id != "" {
		request_conditions := push(request_conditions, "session_id = ?")
		request_params := push(request_params, session_id)
	}
	if tenant_id != "" {
		request_conditions := push(request_conditions, "tenant_id = ?")
		request_params := push(request_params, tenant_id)
	}
	if project_id != "" {
		request_conditions := push(request_conditions, "project_id = ?")
		request_params := push(request_params, project_id)
	}
	if since_ms > 0 {
		request_conditions := push(request_conditions, "CAST(created_at AS INTEGER) >= ?")
		request_params := push(request_params, since_ms)
	}
	if until_ms > 0 {
		request_conditions := push(request_conditions, "CAST(created_at AS INTEGER) <= ?")
		request_params := push(request_params, until_ms)
	}

	request_sql := "SELECT * FROM requests" + where_clause_from_conditions(request_conditions) + " ORDER BY created_at DESC LIMIT ? OFFSET ?"
	request_params := push(request_params, chunk_size)
	request_params := push(request_params, cursor)
	reqs := db_query(db, request_sql, request_params)

	tool_conditions := []
	tool_params := []
	if session_id != "" {
		tool_conditions := push(tool_conditions, "session_id = ?")
		tool_params := push(tool_params, session_id)
	}
	if since_ms > 0 {
		tool_conditions := push(tool_conditions, "CAST(created_at AS INTEGER) >= ?")
		tool_params := push(tool_params, since_ms)
	}
	if until_ms > 0 {
		tool_conditions := push(tool_conditions, "CAST(created_at AS INTEGER) <= ?")
		tool_params := push(tool_params, until_ms)
	}

	tool_sql := "SELECT * FROM tool_calls" + where_clause_from_conditions(tool_conditions) + " ORDER BY created_at DESC LIMIT ? OFFSET ?"
	tool_params := push(tool_params, chunk_size)
	tool_params := push(tool_params, cursor)
	tools := db_query(db, tool_sql, tool_params)

	step_conditions := []
	step_params := []
	if session_id != "" {
		step_conditions := push(step_conditions, "session_id = ?")
		step_params := push(step_params, session_id)
	}
	if since_ms > 0 {
		step_conditions := push(step_conditions, "CAST(created_at AS INTEGER) >= ?")
		step_params := push(step_params, since_ms)
	}
	if until_ms > 0 {
		step_conditions := push(step_conditions, "CAST(created_at AS INTEGER) <= ?")
		step_params := push(step_params, until_ms)
	}

	step_sql := "SELECT * FROM agent_steps" + where_clause_from_conditions(step_conditions) + " ORDER BY session_id, step_number LIMIT ? OFFSET ?"
	step_params := push(step_params, chunk_size)
	step_params := push(step_params, cursor)
	steps := db_query(db, step_sql, step_params)

	trace_conditions := []
	trace_params := []
	if session_id != "" {
		trace_conditions := push(trace_conditions, "session_id = ?")
		trace_params := push(trace_params, session_id)
	}
	if since_ms > 0 {
		trace_conditions := push(trace_conditions, "started_at_ms >= ?")
		trace_params := push(trace_params, since_ms)
	}
	if until_ms > 0 {
		trace_conditions := push(trace_conditions, "started_at_ms <= ?")
		trace_params := push(trace_params, until_ms)
	}
	trace_sql := "SELECT * FROM traces" + where_clause_from_conditions(trace_conditions) + " ORDER BY started_at_ms DESC LIMIT ? OFFSET ?"
	trace_params := push(trace_params, chunk_size)
	trace_params := push(trace_params, cursor)
	traces := db_query(db, trace_sql, trace_params)
	span_conditions := []
	span_params := []
	if session_id != "" {
		span_conditions := push(span_conditions, "session_id = ?")
		span_params := push(span_params, session_id)
	}
	if since_ms > 0 {
		span_conditions := push(span_conditions, "started_at_ms >= ?")
		span_params := push(span_params, since_ms)
	}
	if until_ms > 0 {
		span_conditions := push(span_conditions, "started_at_ms <= ?")
		span_params := push(span_params, until_ms)
	}
	span_sql := "SELECT * FROM trace_spans" + where_clause_from_conditions(span_conditions) + " ORDER BY started_at_ms DESC LIMIT ? OFFSET ?"
	span_params := push(span_params, chunk_size)
	span_params := push(span_params, cursor)
	spans := db_query(db, span_sql, span_params)
	event_conditions := []
	event_params := []
	if session_id != "" {
		event_conditions := push(event_conditions, "trace_id IN (SELECT trace_id FROM traces WHERE session_id = ?)")
		event_params := push(event_params, session_id)
	}
	if since_ms > 0 {
		event_conditions := push(event_conditions, "occurred_at_ms >= ?")
		event_params := push(event_params, since_ms)
	}
	if until_ms > 0 {
		event_conditions := push(event_conditions, "occurred_at_ms <= ?")
		event_params := push(event_params, until_ms)
	}
	event_sql := "SELECT * FROM trace_events" + where_clause_from_conditions(event_conditions) + " ORDER BY occurred_at_ms DESC LIMIT ? OFFSET ?"
	event_params := push(event_params, chunk_size)
	event_params := push(event_params, cursor)
	events := db_query(db, event_sql, event_params)

	has_more := false
	if len(reqs) == chunk_size || len(tools) == chunk_size || len(steps) == chunk_size || len(traces) == chunk_size || len(spans) == chunk_size || len(events) == chunk_size {
		has_more := true
	}

	next_cursor := -1
	if has_more {
		next_cursor := cursor + chunk_size
	}

	if export_format == "jsonl" || export_format == "ndjson" {
		response := export_rows_as_jsonl(reqs, tools, steps, traces, spans, events)
		response := set_header(response, "X-Watchdog-Cursor", to_string(cursor))
		response := set_header(response, "X-Watchdog-Chunk-Size", to_string(chunk_size))
		response := set_header(response, "X-Watchdog-Next-Cursor", to_string(next_cursor))
		response := set_header(response, "X-Watchdog-Has-More", to_string(has_more))
		return response
	}

	return api_ok({
		"exported_at": to_string(current_timestamp()),
		"filters": {
			"session_id": session_id,
			"tenant_id": tenant_id,
			"project_id": project_id,
			"max_rows": max_rows,
			"cursor": cursor,
			"chunk_size": chunk_size,
			"since_ms": since_ms,
			"until_ms": until_ms,
			"format": export_format
		},
		"chunk": {
			"cursor": cursor,
			"chunk_size": chunk_size,
			"next_cursor": next_cursor,
			"has_more": has_more
		},
		"requests": reqs,
		"tool_calls": tools,
		"agent_steps": steps,
		"traces": traces,
		"trace_spans": spans,
		"trace_events": events
	})
})

print_lines([
	"",
	"Watchdog:        http://localhost:" + to_string(PORT),
	"API stats:       http://localhost:" + to_string(PORT) + "/api/stats",
	"Proxy config:    http://localhost:" + to_string(PORT) + "/api/proxy-config",
	"Proxy endpoint:  http://localhost:" + to_string(PORT) + "/proxy/v1/chat/completions",
	"",
	"Press Ctrl+C to stop.",
	""
])

server.listen()
