	if data_class != "" {
		conditions := push(conditions, "data_class = ?")
		params := push(params, data_class)
	}

	since_ms := request_query_int(req, "since_ms", 0, 0, 9223372036854775807)
	if since_ms > 0 {
		conditions := push(conditions, "CAST(created_at AS INTEGER) >= ?")
		params := push(params, since_ms)
	}

	until_ms := request_query_int(req, "until_ms", 0, 0, 9223372036854775807)
	if until_ms > 0 {
		conditions := push(conditions, "CAST(created_at AS INTEGER) <= ?")
		params := push(params, until_ms)
	}

	sql := "SELECT id, session_id, user_id, tenant_id, project_id, workflow_id, task_id, correlation_id, provider, model, request_id, status, input_tokens, output_tokens, total_tokens, cost_usd, latency_ms, finish_reason, error_code, error_message, prompt_summary, response_summary, source_app, data_class, created_at FROM requests"
	sql := sql + where_clause_from_conditions(conditions)
	sql := sql + " ORDER BY created_at DESC LIMIT ? OFFSET ?"
	params := push(params, page_size)
	params := push(params, offset)

	rows := db_query(db, sql, params)
	return api_ok(rows)
})

