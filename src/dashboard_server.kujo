func valid_traceparent(raw_value) {
	text := to_lower(trim(to_string(raw_value)))
	parts := split(text, "-")
	if len(parts) != 4 { return false }
	if len(parts[0]) != 2 || parts[0] == "ff" { return false }
	if watchdog_telemetry_v2_is_hex_id(parts[1], 32) == false { return false }
	if watchdog_telemetry_v2_is_hex_id(parts[2], 16) == false { return false }
	if len(parts[3]) != 2 { return false }
	i := 0
	while i < 2 {
		if contains("0123456789abcdef", substring(parts[3], i, i + 1)) == 0 { return false }
		i = i + 1
	}
	return true
}

func traceparent_parts(req) {
	headers := safe_dict_get(req, "headers", {})
	value := to_lower(trim(get_header(headers, "traceparent")))
	if valid_traceparent(value) == false { return [] }
	return split(value, "-")
}

func resolve_trace_id(req, parsed_payload) {
	headers := safe_dict_get(req, "headers", {})
	trace_parts := traceparent_parts(req)
	if len(trace_parts) == 4 { return trace_parts[1] }
	trace_id := get_header(headers, "x-observe-trace-id")
	if trace_id != "" {
		return normalize_identifier(trace_id)
	}

	if type(parsed_payload) == "dict" {
