# External telemetry intake for trusted local applications that do not route
# their provider traffic through the Watchdog proxy (for example Codex CLI).
server := server.route("POST", "/api/telemetry/requests", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}
	maybe_run_scheduled_backup()

	body_parse := parse_json_safe(to_string(safe_dict_get(req, "body", "{}")))
	if !body_parse["ok"] || type(body_parse["data"]) != "dict" {
		return api_error(400, "Request body must be a JSON object")
	}
	try {
		result := insert_external_request(body_parse["data"])
		if !result["ok"] {
			return api_error(400, result["error"])
		}
		insert_audit_event("external_telemetry_intake", resolve_audit_actor_key(req, "api"), "success", {
			"request_dbid": result["id"],
			"deduplicated": result["deduplicated"],
			"source_app": external_text(body_parse["data"], "source_app", "external", 80)
		})
		return api_ok(result)
	} except err {
		print("External telemetry intake failed: " + to_string(err))
		return api_error(500, "External telemetry intake failed")
	}
})

# Append spans/events to an existing trace without requiring another model
# request row. This keeps each producer independently usable while preserving
# one optional, provider-neutral telemetry contract.
server := server.route("POST", "/api/telemetry/traces", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}
	maybe_run_scheduled_backup()
	body_parse := parse_json_safe(to_string(safe_dict_get(req, "body", "{}")))
	if !body_parse["ok"] || type(body_parse["data"]) != "dict" {
		return api_error(400, "Request body must be a JSON object")
	}
	body := body_parse["data"]
	trace_id := external_text(body, "trace_id", "", 160)
	trace := safe_dict_get(body, "trace", {})
	if trace_id == "" && type(trace) == "dict" {
		trace_id = external_text(trace, "trace_id", "", 160)
	}
	if trace_id == "" {
		return api_error(400, "trace_id is required")
	}
	source_app := external_text(body, "source_app", "external", 80)
	session_id := external_text(body, "session_id", "", 160)
	result := insert_trace_bundle(to_int_or_zero(safe_dict_get(body, "request_dbid", 0)), body, source_app, session_id, "external")
	return api_ok(result)
})

# Existing dashboard APIs
server := server.route("GET", "/api/stats", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}
	maybe_run_scheduled_backup()

	total_rows := db_query(db, "SELECT COUNT(*) AS n FROM requests", [])
	error_rows := db_query(db, "SELECT COUNT(*) AS n FROM requests WHERE status = 'error'", [])
	cost_rows := db_query(db, "SELECT COALESCE(SUM(cost_usd),0) AS total FROM requests", [])
	lat_rows := db_query(db, "SELECT COALESCE(AVG(latency_ms),0) AS avg FROM requests WHERE status = 'success'", [])
	tok_rows := db_query(db, "SELECT COALESCE(SUM(total_tokens),0) AS total FROM requests", [])
	sess_rows := db_query(db, "SELECT COUNT(DISTINCT session_id) AS n FROM requests", [])
	tc_rows := db_query(db, "SELECT COUNT(*) AS n FROM tool_calls", [])
	step_rows := db_query(db, "SELECT COUNT(*) AS n FROM agent_steps", [])
	trace_rows := db_query(db, "SELECT COUNT(*) AS n FROM traces", [])
	span_rows := db_query(db, "SELECT COUNT(*) AS n FROM trace_spans", [])
	event_rows := db_query(db, "SELECT COUNT(*) AS n FROM trace_events", [])

	total := total_rows[0]["n"]
	errors := error_rows[0]["n"]
	cost := cost_rows[0]["total"]
	avg_lat := lat_rows[0]["avg"]
	tokens := tok_rows[0]["total"]
	sess_n := sess_rows[0]["n"]
	tc_n := tc_rows[0]["n"]
	steps_n := step_rows[0]["n"]
	trace_n := trace_rows[0]["n"]
	span_n := span_rows[0]["n"]
	event_n := event_rows[0]["n"]

	error_rate := 0.0
	if total > 0 {
		error_rate := (errors * 100.0) / total
	}

	return api_ok({
		"total_requests": total,
		"total_errors": errors,
		"error_rate_pct": error_rate,
		"total_cost_usd": cost,
		"avg_latency_ms": avg_lat,
		"total_tokens": tokens,
		"total_sessions": sess_n,
		"total_tool_calls": tc_n,
		"total_agent_steps": steps_n,
		"total_traces": trace_n,
		"total_trace_spans": span_n,
		"total_trace_events": event_n
	})
})

