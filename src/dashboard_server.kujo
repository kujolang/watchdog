server := server.route("GET", "/api/insights", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}

	run_key_sql := "COALESCE(NULLIF(task_id,''), NULLIF(workflow_id,''), NULLIF(session_id,''), NULLIF(request_id,''), CAST(id AS TEXT))"
	run_base_sql := "SELECT " + run_key_sql + " AS run_key, MAX(session_id) AS session_id, MAX(workflow_id) AS workflow_id, MAX(task_id) AS task_id, COUNT(*) AS request_rounds, SUM(CASE WHEN status='error' THEN 1 ELSE 0 END) AS error_count, MAX(error_code) AS last_error_code, COALESCE(SUM(total_tokens),0) AS total_tokens, COALESCE(SUM(cost_usd),0) AS total_cost_usd, COALESCE(AVG(latency_ms),0) AS avg_latency_ms, MAX(latency_ms) AS max_latency_ms, MAX(created_at) AS last_seen FROM requests GROUP BY " + run_key_sql
	completion_events_sql := "(SELECT COUNT(*) FROM trace_events te JOIN traces tr ON tr.trace_id = te.trace_id WHERE tr.session_id = rb.session_id AND lower(te.event_name) IN ('task_completed','workflow_completed','run_completed','task_succeeded','workflow_succeeded'))"
	failure_events_sql := "(SELECT COUNT(*) FROM trace_events te JOIN traces tr ON tr.trace_id = te.trace_id WHERE tr.session_id = rb.session_id AND lower(te.event_name) IN ('task_failed','workflow_failed','run_failed','task_cancelled','workflow_cancelled','response_failed'))"
	retry_events_sql := "(SELECT COUNT(*) FROM trace_events te JOIN traces tr ON tr.trace_id = te.trace_id WHERE tr.session_id = rb.session_id AND lower(te.event_name) LIKE '%retry%')"
	failure_stage_sql := "COALESCE((SELECT te.event_name FROM trace_events te JOIN traces tr ON tr.trace_id = te.trace_id WHERE tr.session_id = rb.session_id AND (lower(te.event_name) LIKE '%fail%' OR lower(te.event_name) LIKE '%error%' OR lower(te.event_name) LIKE '%cancel%') ORDER BY te.occurred_at_ms DESC LIMIT 1), NULLIF(rb.last_error_code,''), CASE WHEN rb.error_count > 0 THEN 'request_error' ELSE '' END)"
	run_rows := db_query(db, "SELECT rb.run_key, rb.workflow_id, rb.task_id, rb.request_rounds, rb.error_count, rb.total_tokens, rb.total_cost_usd, rb.avg_latency_ms, rb.max_latency_ms, rb.last_seen, (SELECT COUNT(*) FROM tool_calls tc WHERE tc.session_id = rb.session_id) AS tool_count, " + retry_events_sql + " AS retry_signals, " + completion_events_sql + " AS completion_signals, " + failure_events_sql + " AS failure_signals, " + failure_stage_sql + " AS failure_stage, CASE WHEN (" + failure_events_sql + ") > 0 OR rb.error_count > 0 THEN 'failed' WHEN (" + completion_events_sql + ") > 0 THEN 'completed' ELSE 'success_signal' END AS observed_outcome FROM (" + run_base_sql + ") rb ORDER BY rb.last_seen DESC LIMIT 100", [])
	run_summary_rows := db_query(db, "SELECT COUNT(*) AS total_runs, SUM(CASE WHEN error_count = 0 THEN 1 ELSE 0 END) AS success_signal_runs, SUM(CASE WHEN error_count > 0 THEN 1 ELSE 0 END) AS failed_runs, COALESCE(SUM(total_cost_usd),0) AS total_cost_usd, COALESCE(SUM(CASE WHEN error_count = 0 THEN total_cost_usd ELSE 0 END),0) AS successful_cost_usd FROM (" + run_base_sql + ") rb", [])
	explicit_completion_rows := db_query(db, "SELECT COUNT(DISTINCT tr.session_id) AS completed_sessions FROM trace_events te JOIN traces tr ON tr.trace_id = te.trace_id WHERE lower(te.event_name) IN ('task_completed','workflow_completed','run_completed','task_succeeded','workflow_succeeded')", [])

	tool_rows := db_query(db, "SELECT tc.tool_name, COUNT(*) AS call_count, SUM(CASE WHEN tc.status='success' THEN 1 ELSE 0 END) AS success_count, SUM(CASE WHEN tc.status='success' THEN 0 ELSE 1 END) AS error_count, COALESCE(AVG(tc.latency_ms),0) AS avg_latency_ms, MAX(tc.latency_ms) AS max_latency_ms, COALESCE(SUM(tc.latency_ms),0) AS total_latency_ms, COUNT(DISTINCT tc.session_id) AS session_count, COUNT(DISTINCT CASE WHEN r.status='error' THEN tc.session_id END) AS failed_session_count, COUNT(DISTINCT CASE WHEN r.status!='error' THEN tc.session_id END) AS successful_session_count FROM tool_calls tc LEFT JOIN requests r ON r.id = tc.request_dbid GROUP BY tc.tool_name ORDER BY call_count DESC LIMIT 100", [])

	waterfall_rows := db_query(db, "SELECT span_kind, COUNT(*) AS span_count, COALESCE(SUM(duration_ms),0) AS total_duration_ms, COALESCE(AVG(duration_ms),0) AS avg_duration_ms, MAX(duration_ms) AS max_duration_ms FROM trace_spans GROUP BY span_kind ORDER BY total_duration_ms DESC", [])
	latency_summary_rows := db_query(db, "SELECT COUNT(*) AS trace_count, COALESCE(SUM(duration_ms),0) AS total_trace_duration_ms, COALESCE(AVG(duration_ms),0) AS avg_trace_duration_ms, COALESCE((SELECT SUM(duration_ms) FROM trace_spans),0) AS total_span_duration_ms FROM traces", [])
	sequence_rows := db_query(db, "SELECT a.step_type AS from_step, b.step_type AS to_step, COUNT(*) AS transition_count, COUNT(DISTINCT CASE WHEN r.status='error' THEN a.session_id END) AS failed_session_count, COUNT(DISTINCT CASE WHEN r.status!='error' THEN a.session_id END) AS successful_session_count FROM agent_steps a JOIN agent_steps b ON b.session_id = a.session_id AND b.step_number = a.step_number + 1 LEFT JOIN requests r ON r.session_id = a.session_id WHERE a.step_type != '' AND b.step_type != '' GROUP BY a.step_type, b.step_type ORDER BY transition_count DESC LIMIT 50", [])
	context_summary_rows := db_query(db, "SELECT COUNT(*) AS trace_count, COALESCE(AVG(input_tokens),0) AS avg_input_tokens, COALESCE(MAX(input_tokens),0) AS max_input_tokens, COALESCE(AVG(cached_input_tokens),0) AS avg_cached_input_tokens, COALESCE(AVG(output_tokens),0) AS avg_output_tokens, COALESCE(AVG(duration_ms),0) AS avg_duration_ms, (SELECT COUNT(DISTINCT tr.session_id) FROM trace_events te JOIN traces tr ON tr.trace_id = te.trace_id WHERE lower(te.event_name) IN ('context_compacted','context_trimmed','memory_compacted','summarization_completed')) AS compaction_sessions FROM traces", [])
	context_trend_rows := db_query(db, "SELECT CAST(started_at_ms / 3600000 AS INTEGER) AS hour_bucket, COALESCE(AVG(input_tokens),0) AS avg_input_tokens, MAX(input_tokens) AS max_input_tokens, COALESCE(AVG(cached_input_tokens),0) AS avg_cached_input_tokens, COUNT(*) AS trace_count FROM traces GROUP BY hour_bucket ORDER BY hour_bucket ASC LIMIT 72", [])
	context_growth_rows := db_query(db, "SELECT session_id, COUNT(*) AS trace_count, MIN(input_tokens) AS first_input_tokens, MAX(input_tokens) AS max_input_tokens, MAX(input_tokens) - MIN(input_tokens) AS input_growth_tokens, COALESCE(AVG(input_tokens),0) AS avg_input_tokens FROM traces WHERE session_id != '' GROUP BY session_id ORDER BY input_growth_tokens DESC LIMIT 50", [])
	run_summary := run_summary_rows[0]
	run_summary["explicit_completion_sessions"] := explicit_completion_rows[0]["completed_sessions"]

	return api_ok({
		"run_outcomes": {
			"summary": run_summary,
			"runs": run_rows
		},
		"tool_effectiveness": tool_rows,
		"latency_waterfall": {"by_kind": waterfall_rows, "summary": latency_summary_rows[0]},
		"workflow_sequences": sequence_rows,
		"context_pressure": {
			"summary": context_summary_rows[0],
			"trend": context_trend_rows,
			"growth": context_growth_rows
		}
	})
})

server := server.route("GET", "/api/charts/requests-over-time", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}

	conditions := []
	params := []
	tenant_id := request_query_text(req, "tenant_id", "")
	if tenant_id != "" {
		conditions := push(conditions, "tenant_id = ?")
		params := push(params, tenant_id)
	}
	project_id := request_query_text(req, "project_id", "")
	if project_id != "" {
		conditions := push(conditions, "project_id = ?")
		params := push(params, project_id)
	}
	sql := "SELECT CAST(CAST(created_at AS INTEGER) / 3600000 AS INTEGER) AS hour_bucket, COUNT(*) AS total, SUM(CASE WHEN status='error' THEN 1 ELSE 0 END) AS errors FROM requests"
	sql := sql + where_clause_from_conditions(conditions)
	sql := sql + " GROUP BY hour_bucket ORDER BY hour_bucket ASC LIMIT 72"
	rows := db_query(db, sql, params)
	return api_ok(rows)
})

