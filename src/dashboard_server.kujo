# Watchdog + OpenAI-Compatible Proxy
# Compatibility entrypoint mirrored from src/dashboard_server.kujo.
#
# Run:
#   /path/to/kujo run --interpreter dashboard_server.kujo
#
# Default Watchdog URL:
#   http://localhost:7700
#
# Proxy URL pattern:
#   http://localhost:7700/proxy/v1/<resource>/<action>
#
# Example for chat completions:
#   POST http://localhost:7700/proxy/v1/chat/completions

from watchdog_shared import watchdog_estimate_cost, watchdog_ensure_schema
from watchdog_shared import watchdog_has_known_pricing
from watchdog_shared import watchdog_cost_per_million

DEFAULT_PORT := 7700
DEFAULT_DB_PATH := "data/watchdog.db"
DEFAULT_PROXY_CONFIG_PATH := "watchdog_proxy_config.json"
DEFAULT_UPSTREAM_BASE_URL := "https://api.openai.com/v1"
DEFAULT_AUTH_MODE := "passthrough"
DEFAULT_PROXY_CONFIG_VISIBILITY := "safe"
DEFAULT_API_AUTH_MODE := "off"
DEFAULT_PROXY_AUTHZ_MODE := "off"
DEFAULT_DEPLOYMENT_PROFILE := "local"
DEFAULT_ALLOW_INSECURE_STARTUP := "false"
DEFAULT_PROXY_AUTHZ_ALLOWLIST := "/healthz,/readyz"
DEFAULT_CHARTJS_LOCAL_PATH := "vendor/chart.umd.min.js"
DEFAULT_PROXY_TIMEOUT_SECS := 120
DEFAULT_MAX_PROXY_BODY_BYTES := 1048576
DEFAULT_MAX_PARSE_BODY_BYTES := 524288
DEFAULT_REDACTION_MODE := "basic"
DEFAULT_REDACT_TERMS := "api_key,authorization,bearer,password,secret,token,sk-"
DEFAULT_RATE_LIMIT_MODE := "off"
DEFAULT_RATE_LIMIT_MAX_REQUESTS := 60
DEFAULT_RATE_LIMIT_WINDOW_SECS := 60
DEFAULT_RATE_LIMIT_MAX_BUCKETS := 5000
DEFAULT_RATE_LIMIT_BUCKET_TTL_SECS := 600
DEFAULT_IDENTIFIER_MAX_LEN := 128
DEFAULT_EXPORT_MAX_ROWS := 10000
MAX_EXPORT_MAX_ROWS := 50000
DEFAULT_BACKUP_ENABLED := "true"
DEFAULT_BACKUP_INTERVAL_MINUTES := 1440
DEFAULT_BACKUP_DIR := "data/backups"
DEFAULT_BACKUP_RETENTION_COUNT := 30
DEFAULT_BACKUP_ENCRYPTION_ENABLED := "false"
DEFAULT_BACKUP_SCRIPT_PATH := "scripts/watchdog_backup.js"
DEFAULT_NODE_BIN := "node"
DEFAULT_OPENSSL_BIN := "openssl"
MIN_BACKUP_INTERVAL_MINUTES := 15
MAX_BACKUP_INTERVAL_MINUTES := 43200
API_CONTRACT_VERSION := "v1"
API_CONTRACT_STATUS := "stable"

func env_or(key, fallback_value) {
	v := env(key)
	if type(v) == "null" {
		return fallback_value
	}
	v := trim(to_string(v))
	if v == "" {
		return fallback_value
	}
	return v
}

func env_or_many(keys, fallback_value) {
	i := 0
	while i < len(keys) {
		key := to_string(keys[i])
		v := env(key)
		if type(v) != "null" {
			text := trim(to_string(v))
			if text != "" {
				return text
			}
		}
		i := i + 1
	}
	return fallback_value
}

func parse_int_env_many(keys, fallback_value) {
	raw := env_or_many(keys, "")
	if raw == "" {
		return fallback_value
	}
	try {
		parsed := parse_int(raw)
		return parsed
	} except err {
		return fallback_value
	}
}

func positive_int_or_fallback(raw_value, fallback_value) {
	if raw_value <= 0 {
		return fallback_value
	}
	return raw_value
}

func parse_csv_terms(raw_text) {
	terms := []
	parts := split(to_string(raw_text), ",")
	i := 0
	while i < len(parts) {
		part := trim(to_lower(to_string(parts[i])))
		if part != "" {
			terms := push(terms, part)
		}
		i := i + 1
	}
	return terms
}

func normalize_base_url(raw) {
	next := trim(to_string(raw))
	if next == "" {
		return DEFAULT_UPSTREAM_BASE_URL
	}
	while ends_with(next, "/") {
		next := substring(next, 0, len(next) - 1)
	}
	return next
}

func safe_dict_get(dict_value, key, fallback_value) {
	if type(dict_value) != "dict" {
		return fallback_value
	}
	if has_key(dict_value, key) {
		return dict_value[key]
	}
	return fallback_value
}

func string_dict_get(dict_value, key, fallback_value) {
	if type(dict_value) != "dict" {
		return fallback_value
	}
	if has_key(dict_value, key) {
		return to_string(dict_value[key])
	}
	return fallback_value
}

func parse_json_safe(text_value) {
	text := to_string(text_value)
	if len(trim(text)) == 0 {
		return {
			"ok": false,
			"data": null,
			"error": "empty body"
		}
	}

	parsed := null
	parse_error := null
	try {
		parsed := parse_json(text)
	} except err {
		parse_error := err
	}

	if type(parse_error) != "null" {
		return {
			"ok": false,
			"data": null,
			"error": to_string(parse_error)
		}
	}

	return {
		"ok": true,
		"data": parsed,
		"error": ""
	}
}

func parse_json_with_limit(text_value, max_bytes) {
	text := to_string(text_value)
	if len(text) > max_bytes {
		return {
			"ok": false,
			"data": null,
			"error": "json body exceeds configured parse limit"
		}
	}
	return parse_json_safe(text)
}

func get_header(headers, key_name) {
	if type(headers) != "dict" {
		return ""
	}
	if has_key(headers, key_name) {
		return to_string(headers[key_name])
	}

	needle := to_lower(key_name)
	for key in keys(headers) {
		if to_lower(to_string(key)) == needle {
			return to_string(headers[key])
		}
	}

	return ""
}

func truncate_str(value, max_len) {
	next := to_string(value)
	if len(next) <= max_len {
		return next
	}
	return substring(next, 0, max_len) + "..."
}

func safe_prompt_summary(messages) {
	if type(messages) != "array" {
		return ""
	}
	if len(messages) == 0 {
		return ""
	}

	last := messages[len(messages) - 1]
	if type(last) != "dict" {
		return ""
	}

	content := string_dict_get(last, "content", "")
	return truncate_str(content, 120)
}

func to_int_or_zero(value) {
	try {
		return parse_int(to_string(value))
	} except err {
		return 0
	}
}

func request_query_map(req) {
	query := safe_dict_get(req, "query", null)
	if type(query) == "dict" {
		return query
	}

	query := safe_dict_get(req, "query_params", null)
	if type(query) == "dict" {
		return query
	}

	return {}
}

func request_query_text(req, key, fallback_value) {
	query := request_query_map(req)
	if has_key(query, key) {
		return trim(to_string(query[key]))
	}
	return fallback_value
}

func request_query_int(req, key, fallback_value, min_value, max_value) {
	raw := request_query_text(req, key, "")
	if raw == "" {
		return fallback_value
	}

	parsed := fallback_value
	try {
		parsed := parse_int(raw)
	} except err {
		return fallback_value
	}

	if parsed < min_value {
		return min_value
	}
	if parsed > max_value {
		return max_value
	}
	return parsed
}

func unsafe_proxy_component_reason(raw_value, component_name) {
	text := trim(to_string(raw_value))
	if text == "" {
		return ""
	}

	lower_text := to_lower(text)
	if starts_with(text, "/") || contains(text, "\\") {
		return component_name + " contains a path separator"
	}
	if text == "." || text == ".." || contains(text, "..") {
		return component_name + " contains a relative path segment"
	}
	if contains(text, "?") || contains(text, "#") {
		return component_name + " contains query or fragment text"
	}
	if contains(lower_text, "%2f") || contains(lower_text, "%5c") || contains(lower_text, "%2e") {
		return component_name + " contains encoded path traversal characters"
	}
	if contains(lower_text, "://") {
		return component_name + " contains URL scheme text"
	}

	return ""
}

func validate_proxy_path(resource, action) {
	resource_reason := unsafe_proxy_component_reason(resource, "resource")
	if resource_reason != "" {
		return {
			"ok": false,
			"error": "Unsafe proxy path: " + resource_reason
		}
	}

	parts := split(to_string(action), "/")
	i := 0
	while i < len(parts) {
		part := trim(to_string(parts[i]))
		if part != "" {
			part_reason := unsafe_proxy_component_reason(part, "path segment")
			if part_reason != "" {
				return {
					"ok": false,
					"error": "Unsafe proxy path: " + part_reason
				}
			}
		}
		i := i + 1
	}

	return {
		"ok": true,
		"error": ""
	}
}

func unsafe_proxy_query_component_reason(raw_value, component_name) {
	text := trim(to_string(raw_value))
	if text == "" {
		return ""
	}
	if contains(text, "&") || contains(text, "=") || contains(text, "?") || contains(text, "#") {
		return component_name + " contains query delimiter text"
	}
	if contains(text, "\n") || contains(text, "\r") || contains(text, " ") || contains(text, "\t") {
		return component_name + " contains whitespace"
	}
	if contains(text, "\\") {
		return component_name + " contains a path separator"
	}
	return ""
}

func append_proxy_query_pair(query_text, key, value) {
	pair := to_string(key) + "=" + to_string(value)
	if query_text == "" {
		return "?" + pair
	}
	return query_text + "&" + pair
}

func build_proxy_query_suffix(req) {
	query := request_query_map(req)
	out := ""

	for key in keys(query) {
		key_text := trim(to_string(key))
		key_reason := unsafe_proxy_query_component_reason(key_text, "query key")
		if key_reason != "" {
			return {
				"ok": false,
				"query": "",
				"error": "Unsafe proxy query: " + key_reason
			}
		}

		value := query[key]
		if type(value) == "array" {
			i := 0
			while i < len(value) {
				value_text := trim(to_string(value[i]))
				value_reason := unsafe_proxy_query_component_reason(value_text, "query value")
				if value_reason != "" {
					return {
						"ok": false,
						"query": "",
						"error": "Unsafe proxy query: " + value_reason
					}
				}
				out := append_proxy_query_pair(out, key_text, value_text)
				i := i + 1
			}
		} else {
			value_text := trim(to_string(value))
			value_reason := unsafe_proxy_query_component_reason(value_text, "query value")
			if value_reason != "" {
				return {
					"ok": false,
					"query": "",
					"error": "Unsafe proxy query: " + value_reason
				}
			}
			out := append_proxy_query_pair(out, key_text, value_text)
		}
	}

	return {
		"ok": true,
		"query": out,
		"error": ""
	}
}

func where_clause_from_conditions(conditions) {
	if len(conditions) == 0 {
		return ""
	}

	out := " WHERE "
	i := 0
	while i < len(conditions) {
		if i > 0 {
			out := out + " AND "
		}
		out := out + to_string(conditions[i])
		i := i + 1
	}

	return out
}

func parse_bool_value(raw_value, fallback_value) {
	if type(raw_value) == "bool" {
		return raw_value
	}

	text := to_lower(trim(to_string(raw_value)))
	if text == "true" || text == "1" || text == "yes" || text == "on" {
		return true
	}
	if text == "false" || text == "0" || text == "no" || text == "off" {
		return false
	}

	return fallback_value
}

func normalize_identifier(raw_value) {
	text := trim(to_string(raw_value))
	if text == "" {
		return ""
	}
	if len(text) <= IDENTIFIER_MAX_LEN {
		return text
	}
	return substring(text, 0, IDENTIFIER_MAX_LEN)
}

func normalize_api_auth_mode(raw_mode) {
	mode := to_lower(trim(to_string(raw_mode)))
	if mode == "token" {
		return "token"
	}
	return "off"
}

func normalize_proxy_authz_mode(raw_mode) {
	mode := to_lower(trim(to_string(raw_mode)))
	if mode == "token" {
		return "token"
	}
	return "off"
}

func normalize_deployment_profile(raw_profile) {
	profile := to_lower(trim(to_string(raw_profile)))
	if profile == "production" || profile == "prod" {
		return "production"
	}
	return "local"
}

func join_policy_errors(errors) {
	if len(errors) == 0 {
		return ""
	}

	out := ""
	i := 0
	while i < len(errors) {
		if i > 0 {
			out := out + " | "
		}
		out := out + to_string(errors[i])
		i := i + 1
	}

	return out
}

func bearer_token_from_auth_header(auth_header) {
	text := trim(to_string(auth_header))
	if text == "" {
		return ""
	}
	needle := "bearer "
	if starts_with(to_lower(text), needle) {
		return trim(substring(text, len(needle), len(text)))
	}
	return ""
}

func resolve_api_token_from_request(req) {
	headers := safe_dict_get(req, "headers", {})
	token := trim(get_header(headers, "X-Watchdog-Token"))
	if token != "" {
		return token
	}

	auth_header := get_header(headers, "Authorization")
	return bearer_token_from_auth_header(auth_header)
}

func resolve_proxy_token_from_request(req) {
	headers := safe_dict_get(req, "headers", {})
	token := trim(get_header(headers, "X-Watchdog-Proxy-Token"))
	if token != "" {
		return token
	}

	auth_header := get_header(headers, "Authorization")
	return bearer_token_from_auth_header(auth_header)
}

func resolve_audit_actor_key(req, scope) {
	headers := safe_dict_get(req, "headers", {})
	session_id := normalize_identifier(get_header(headers, "X-Observe-Session-Id"))
	if session_id != "" {
		return "session:" + session_id
	}

	if scope == "api" {
		api_token := resolve_api_token_from_request(req)
		if api_token != "" {
			return "api_token:present"
		}
		return "api_token:missing"
	}

	if scope == "proxy" {
		proxy_token := resolve_proxy_token_from_request(req)
		if proxy_token != "" {
			return "proxy_token:present"
		}
		return "proxy_token:missing"
	}

	return rate_limit_key(req)
}

func require_api_auth(req) {
	rate_decision := check_rate_limit(req)
	if !rate_decision["allowed"] {
		return rate_decision
	}

	if API_AUTH_MODE != "token" {
		return {
			"allowed": true,
			"status": 200,
			"error": ""
		}
	}

	if API_AUTH_TOKEN == "" {
		insert_audit_event("api_auth_failure", resolve_audit_actor_key(req, "api"), "misconfigured", {
			"status": 500,
			"reason": "missing_api_auth_token"
		})
		return {
			"allowed": false,
			"status": 500,
			"error": "API auth mode is token but WDG_API_AUTH_TOKEN is empty"
		}
	}

	presented_token := resolve_api_token_from_request(req)
	if presented_token == "" {
		insert_audit_event("api_auth_failure", resolve_audit_actor_key(req, "api"), "denied", {
			"status": 401,
			"reason": "missing_api_token"
		})
		return {
			"allowed": false,
			"status": 401,
			"error": "Unauthorized: missing API token"
		}
	}

	if presented_token != API_AUTH_TOKEN {
		insert_audit_event("api_auth_failure", resolve_audit_actor_key(req, "api"), "denied", {
			"status": 403,
			"reason": "invalid_api_token"
		})
		return {
			"allowed": false,
			"status": 403,
			"error": "Forbidden: invalid API token"
		}
	}

	return {
		"allowed": true,
		"status": 200,
		"error": ""
	}
}

func path_in_allowlist(path_value) {
	path_text := to_lower(trim(to_string(path_value)))
	if path_text == "" {
		return false
	}

	i := 0
	while i < len(PROXY_AUTHZ_ALLOWLIST) {
		entry := trim(to_string(PROXY_AUTHZ_ALLOWLIST[i]))
		if entry != "" {
			if path_text == to_lower(entry) {
				return true
			}
		}
		i := i + 1
	}

	return false
}

func require_proxy_auth(req, path_value) {
	if path_in_allowlist(path_value) {
		return {
			"allowed": true,
			"status": 200,
			"error": ""
		}
	}

	if PROXY_AUTHZ_MODE != "token" {
		return {
			"allowed": true,
			"status": 200,
			"error": ""
		}
	}

	if PROXY_AUTHZ_TOKEN == "" {
		insert_audit_event("proxy_auth_failure", resolve_audit_actor_key(req, "proxy"), "misconfigured", {
			"status": 500,
			"reason": "missing_proxy_auth_token",
			"path": path_value
		})
		return {
			"allowed": false,
			"status": 500,
			"error": "Proxy auth mode is token but WDG_PROXY_AUTHZ_TOKEN is empty"
		}
	}

	presented_token := resolve_proxy_token_from_request(req)
	if presented_token == "" {
		insert_audit_event("proxy_auth_failure", resolve_audit_actor_key(req, "proxy"), "denied", {
			"status": 401,
			"reason": "missing_proxy_token",
			"path": path_value
		})
		return {
			"allowed": false,
			"status": 401,
			"error": "Unauthorized: missing proxy token"
		}
	}

	if presented_token != PROXY_AUTHZ_TOKEN {
		insert_audit_event("proxy_auth_failure", resolve_audit_actor_key(req, "proxy"), "denied", {
			"status": 403,
			"reason": "invalid_proxy_token",
			"path": path_value
		})
		return {
			"allowed": false,
			"status": 403,
			"error": "Forbidden: invalid proxy token"
		}
	}

	return {
		"allowed": true,
		"status": 200,
		"error": ""
	}
}

func rate_limit_key(req) {
	headers := safe_dict_get(req, "headers", {})
	session_id := trim(get_header(headers, "X-Observe-Session-Id"))
	if session_id != "" {
		return "session:" + session_id
	}

	forwarded_for := trim(get_header(headers, "X-Forwarded-For"))
	if forwarded_for != "" {
		parts := split(forwarded_for, ",")
		if len(parts) > 0 {
			ip := trim(to_string(parts[0]))
			if ip != "" {
				return "ip:" + ip
			}
		}
	}

	real_ip := trim(get_header(headers, "X-Real-IP"))
	if real_ip != "" {
		return "ip:" + real_ip
	}

	host := trim(get_header(headers, "Host"))
	if host != "" {
		return "host:" + host
	}

	return "anonymous"
}

func normalize_rate_limit_buckets(now_ms) {
	ttl_ms := RATE_LIMIT_BUCKET_TTL_SECS * 1000
	db_execute(db, "DELETE FROM rate_limit_buckets WHERE last_seen_ms < ?", [now_ms - ttl_ms])
}

func check_rate_limit(req) {
	if RATE_LIMIT_MODE != "basic" {
		return {
			"allowed": true,
			"status": 200,
			"error": ""
		}
	}

	if RATE_LIMIT_MAX_REQUESTS <= 0 {
		return {
			"allowed": true,
			"status": 200,
			"error": ""
		}
	}

	window_ms := RATE_LIMIT_WINDOW_SECS * 1000
	now_ms := current_timestamp()
	normalize_rate_limit_buckets(now_ms)
	bucket_key := rate_limit_key(req)
	bucket_rows := db_query(db, "SELECT window_start_ms, request_count FROM rate_limit_buckets WHERE bucket_key = ? LIMIT 1", [bucket_key])

	if len(bucket_rows) == 0 {
		if RATE_LIMIT_MAX_BUCKETS > 0 {
			count_rows := db_query(db, "SELECT COUNT(*) AS n FROM rate_limit_buckets", [])
			bucket_count := to_int_or_zero(count_rows[0]["n"])
			while bucket_count >= RATE_LIMIT_MAX_BUCKETS {
				db_execute(db, "DELETE FROM rate_limit_buckets WHERE bucket_key = (SELECT bucket_key FROM rate_limit_buckets ORDER BY last_seen_ms ASC, bucket_key ASC LIMIT 1)", [])
				bucket_count := bucket_count - 1
			}
		}
		db_execute(db, "INSERT OR REPLACE INTO rate_limit_buckets (bucket_key, window_start_ms, request_count, last_seen_ms) VALUES (?, ?, ?, ?)", [bucket_key, now_ms, 1, now_ms])
		return {
			"allowed": true,
			"status": 200,
			"error": ""
		}
	}

	bucket := bucket_rows[0]
	window_start := to_int_or_zero(safe_dict_get(bucket, "window_start_ms", now_ms))
	count := to_int_or_zero(safe_dict_get(bucket, "request_count", 0))
	if now_ms - window_start >= window_ms {
		db_execute(db, "INSERT OR REPLACE INTO rate_limit_buckets (bucket_key, window_start_ms, request_count, last_seen_ms) VALUES (?, ?, ?, ?)", [bucket_key, now_ms, 1, now_ms])
		return {
			"allowed": true,
			"status": 200,
			"error": ""
		}
	}

	next_count := count + 1
	db_execute(db, "INSERT OR REPLACE INTO rate_limit_buckets (bucket_key, window_start_ms, request_count, last_seen_ms) VALUES (?, ?, ?, ?)", [bucket_key, window_start, next_count, now_ms])

	if next_count > RATE_LIMIT_MAX_REQUESTS {
		return {
			"allowed": false,
			"status": 429,
			"error": "Too Many Requests: rate limit exceeded."
		}
	}

	return {
		"allowed": true,
		"status": 200,
		"error": ""
	}
}

func enforce_rate_limit(req) {
	decision := check_rate_limit(req)
	if !decision["allowed"] {
		return api_error(decision["status"], decision["error"])
	}
	return null
}

func redaction_enabled() {
	return REDACTION_MODE != "off"
}

func string_has_sensitive_term(value) {
	text := to_lower(to_string(value))
	i := 0
	while i < len(REDACT_TERMS) {
		term := to_string(REDACT_TERMS[i])
		if term != "" && contains(text, term) {
			return true
		}
		i := i + 1
	}
	return false
}

func redact_sensitive_text(value) {
	text := to_string(value)
	if !redaction_enabled() {
		return text
	}
	if string_has_sensitive_term(text) {
		return "[REDACTED_SENSITIVE_CONTENT]"
	}
	return text
}

func redact_sensitive_value_for_key(key, value) {
	if !redaction_enabled() {
		return value
	}

	key_text := to_lower(to_string(key))
	if string_has_sensitive_term(key_text) {
		return "[REDACTED]"
	}

	if type(value) == "string" {
		return redact_sensitive_text(value)
	}

	if type(value) == "dict" {
		return redact_dict_shallow(value)
	}

	return value
}

func redact_dict_shallow(input_map) {
	if type(input_map) != "dict" {
		return input_map
	}

	clean := {}
	for key in keys(input_map) {
		clean[key] := redact_sensitive_value_for_key(key, input_map[key])
	}
	return clean
}

func parse_stream_events(sse_text) {
	events := []
	lines := split(to_string(sse_text), "\n")
	i := 0
	while i < len(lines) {
		line := trim(lines[i])
		if starts_with(line, "data:") {
			payload_text := trim(replace(line, "data:", ""))
			if payload_text == "[DONE]" {
				break
			}
			if payload_text != "" {
				parsed := parse_json_safe(payload_text)
				if parsed["ok"] {
					events := push(events, parsed["data"])
				}
			}
		}
		i := i + 1
	}
	return events
}

func usage_from_json_data(data) {
	usage_map := safe_dict_get(data, "usage", {})
	if type(usage_map) != "dict" {
		return {"input_tokens": 0, "output_tokens": 0, "total_tokens": 0}
	}

	input_tokens := to_int_or_zero(safe_dict_get(usage_map, "prompt_tokens", 0))
	output_tokens := to_int_or_zero(safe_dict_get(usage_map, "completion_tokens", 0))
	total_tokens := to_int_or_zero(safe_dict_get(usage_map, "total_tokens", input_tokens + output_tokens))

	return {
		"input_tokens": input_tokens,
		"output_tokens": output_tokens,
		"total_tokens": total_tokens
	}
}

func usage_from_stream_events(events) {
	usage := {"input_tokens": 0, "output_tokens": 0, "total_tokens": 0}
	i := 0
	while i < len(events) {
		event := events[i]
		if type(event) == "dict" {
			event_usage := safe_dict_get(event, "usage", null)
			if type(event_usage) == "dict" {
				usage["input_tokens"] := to_int_or_zero(safe_dict_get(event_usage, "prompt_tokens", usage["input_tokens"]))
				usage["output_tokens"] := to_int_or_zero(safe_dict_get(event_usage, "completion_tokens", usage["output_tokens"]))
				usage["total_tokens"] := to_int_or_zero(safe_dict_get(event_usage, "total_tokens", usage["input_tokens"] + usage["output_tokens"]))
			}
		}
		i := i + 1
	}
	return usage
}

func response_summary_from_json_data(data) {
	choices := safe_dict_get(data, "choices", [])
	if type(choices) != "array" || len(choices) == 0 {
		return ""
	}

	first := choices[0]
	if type(first) != "dict" {
		return ""
	}

	message := safe_dict_get(first, "message", null)
	if type(message) == "dict" {
		content := safe_dict_get(message, "content", "")
		if type(content) == "string" {
			return truncate_str(content, 120)
		}
		if type(content) == "array" {
			joined := ""
			i := 0
			while i < len(content) {
				part := content[i]
				joined := joined + to_string(part)
				i := i + 1
			}
			return truncate_str(joined, 120)
		}
	}

	return ""
}

func response_summary_from_stream_events(events) {
	joined := ""
	i := 0
	while i < len(events) {
		event := events[i]
		if type(event) == "dict" {
			choices := safe_dict_get(event, "choices", [])
			if type(choices) == "array" && len(choices) > 0 {
				choice := choices[0]
				if type(choice) == "dict" {
					delta := safe_dict_get(choice, "delta", null)
					if type(delta) == "dict" {
						content := safe_dict_get(delta, "content", "")
						if type(content) == "string" {
							joined := joined + content
						}
					}
				}
			}
		}
		i := i + 1
	}
	return truncate_str(joined, 120)
}

func finish_reason_from_json_data(data) {
	choices := safe_dict_get(data, "choices", [])
	if type(choices) != "array" || len(choices) == 0 {
		return ""
	}
	first := choices[0]
	if type(first) != "dict" {
		return ""
	}
	return to_string(safe_dict_get(first, "finish_reason", ""))
}

func finish_reason_from_stream_events(events) {
	reason := ""
	i := 0
	while i < len(events) {
		event := events[i]
		if type(event) == "dict" {
			choices := safe_dict_get(event, "choices", [])
			if type(choices) == "array" && len(choices) > 0 {
				first := choices[0]
				if type(first) == "dict" {
					next_reason := to_string(safe_dict_get(first, "finish_reason", ""))
					if next_reason != "" {
						reason := next_reason
					}
				}
			}
		}
		i := i + 1
	}
	return reason
}

func model_from_stream_events(events, fallback_model) {
	model := fallback_model
	i := 0
	while i < len(events) {
		event := events[i]
		if type(event) == "dict" {
			next_model := to_string(safe_dict_get(event, "model", ""))
			if next_model != "" {
				model := next_model
			}
		}
		i := i + 1
	}
	return model
}

func request_id_from_stream_events(events) {
	request_id := ""
	for event in events {
		if type(event) == "dict" {
			next_id := to_string(safe_dict_get(event,"id",""))
			if next_id != "" { request_id = next_id }
		}
	}
	return request_id
}

func merge_config_maps(base_cfg, override_cfg) {
	out := {}
	for k in keys(base_cfg) {
		out[k] := base_cfg[k]
	}
	if type(override_cfg) == "dict" {
		for k in keys(override_cfg) {
			out[k] := override_cfg[k]
		}
	}
	return out
}

func read_proxy_config_file(config_path) {
	if !file_exists(config_path) {
		return {}
	}
	text := read_file(config_path)
	parsed := parse_json_safe(text)
	if !parsed["ok"] {
		return {}
	}
	data := parsed["data"]
	if type(data) != "dict" {
		return {}
	}
	return data
}

func effective_proxy_config(config_path) {
	defaults := {
		"upstream_base_url": DEFAULT_UPSTREAM_BASE_URL,
		"auth_mode": DEFAULT_AUTH_MODE,
		"upstream_api_key": "",
		"upstream_api_key_env": ""
	}

	file_cfg := read_proxy_config_file(config_path)
	cfg := merge_config_maps(defaults, file_cfg)

	env_upstream := env_or_many(["WDG_UPSTREAM_BASE_URL"], "")
	if env_upstream != "" {
		cfg["upstream_base_url"] := env_upstream
	}

	env_auth_mode := env_or_many(["WDG_PROXY_AUTH_MODE"], "")
	if env_auth_mode != "" {
		cfg["auth_mode"] := env_auth_mode
	}

	env_api_key := env_or_many(["WDG_UPSTREAM_API_KEY"], "")
	if env_api_key != "" {
		cfg["upstream_api_key"] := env_api_key
	}

	env_api_key_env := env_or_many(["WDG_UPSTREAM_API_KEY_ENV"], "")
	if env_api_key_env != "" {
		cfg["upstream_api_key_env"] := env_api_key_env
	}

	cfg["upstream_base_url"] := normalize_base_url(string_dict_get(cfg, "upstream_base_url", DEFAULT_UPSTREAM_BASE_URL))

	auth_mode := to_lower(trim(string_dict_get(cfg, "auth_mode", DEFAULT_AUTH_MODE)))
	if auth_mode != "override" {
		auth_mode := "passthrough"
	}
	cfg["auth_mode"] := auth_mode

	return cfg
}

func effective_upstream_profiles(config_path) {
	profiles := {
		"default": effective_proxy_config(config_path)
	}
	file_cfg := read_proxy_config_file(config_path)
	raw_profiles := safe_dict_get(file_cfg, "upstream_profiles", {})
	if type(raw_profiles) != "dict" {
		return profiles
	}

	for profile_name in keys(raw_profiles) {
		name := trim(to_string(profile_name))
		profile_cfg := raw_profiles[profile_name]
		if name == "" || type(profile_cfg) != "dict" {
			continue
		}

		cfg := merge_config_maps({
			"upstream_base_url": DEFAULT_UPSTREAM_BASE_URL,
			"auth_mode": DEFAULT_AUTH_MODE,
			"upstream_api_key": "",
			"upstream_api_key_env": ""
		}, profile_cfg)
		cfg["upstream_base_url"] := normalize_base_url(string_dict_get(cfg, "upstream_base_url", DEFAULT_UPSTREAM_BASE_URL))
		auth_mode := to_lower(trim(string_dict_get(cfg, "auth_mode", DEFAULT_AUTH_MODE)))
		if auth_mode != "override" {
			auth_mode := "passthrough"
		}
		cfg["auth_mode"] := auth_mode
		profiles[name] := cfg
	}

	return profiles
}

func effective_named_upstream_profile(config_path, profile_name) {
	file_cfg := read_proxy_config_file(config_path)
	raw_profiles := safe_dict_get(file_cfg, "upstream_profiles", {})
	if type(raw_profiles) != "dict" || !has_key(raw_profiles, profile_name) {
		return {}
	}
	profile_cfg := raw_profiles[profile_name]
	if type(profile_cfg) != "dict" {
		return {}
	}
	cfg := merge_config_maps({
		"upstream_base_url": DEFAULT_UPSTREAM_BASE_URL,
		"auth_mode": DEFAULT_AUTH_MODE,
		"upstream_api_key": "",
		"upstream_api_key_env": ""
	}, profile_cfg)
	cfg["upstream_base_url"] := normalize_base_url(string_dict_get(cfg, "upstream_base_url", DEFAULT_UPSTREAM_BASE_URL))
	auth_mode := to_lower(trim(string_dict_get(cfg, "auth_mode", DEFAULT_AUTH_MODE)))
	if auth_mode != "override" {
		auth_mode := "passthrough"
	}
	cfg["auth_mode"] := auth_mode
	return cfg
}

func select_upstream_profile(req) {
	headers := safe_dict_get(req, "headers", {})
	profile_name := trim(get_header(headers, "X-Watchdog-Upstream-Profile"))
	if profile_name == "" {
		profile_name := "default"
	}
	profiles := effective_upstream_profiles(PROXY_CONFIG_PATH)
	if !has_key(profiles, profile_name) {
		return {
			"ok": false,
			"error": "Unknown Watchdog upstream profile: " + profile_name
		}
	}
	return {
		"ok": true,
		"name": profile_name,
		"config": profiles[profile_name]
	}
}

func resolve_override_api_key(cfg) {
	raw := string_dict_get(cfg, "upstream_api_key", "")
	if raw != "" {
		return raw
	}
	env_name := string_dict_get(cfg, "upstream_api_key_env", "")
	if env_name == "" {
		return ""
	}
	return env_or(env_name, "")
}

PORT := parse_int_env_many(["WDG_PORT"], DEFAULT_PORT)
DB_PATH := env_or_many(["WDG_DB_PATH"], DEFAULT_DB_PATH)
PROXY_CONFIG_PATH := env_or_many(["WDG_PROXY_CONFIG_PATH"], DEFAULT_PROXY_CONFIG_PATH)
PROXY_CONFIG_VISIBILITY := to_lower(env_or_many(["WDG_PROXY_CONFIG_VISIBILITY"], DEFAULT_PROXY_CONFIG_VISIBILITY))
API_AUTH_MODE := normalize_api_auth_mode(env_or_many(["WDG_API_AUTH_MODE"], DEFAULT_API_AUTH_MODE))
API_AUTH_TOKEN := trim(env_or_many(["WDG_API_AUTH_TOKEN"], ""))
PROXY_AUTHZ_MODE := normalize_proxy_authz_mode(env_or_many(["WDG_PROXY_AUTHZ_MODE"], DEFAULT_PROXY_AUTHZ_MODE))
PROXY_AUTHZ_TOKEN := trim(env_or_many(["WDG_PROXY_AUTHZ_TOKEN"], ""))
DEPLOYMENT_PROFILE := normalize_deployment_profile(env_or_many(["WDG_DEPLOYMENT_PROFILE"], DEFAULT_DEPLOYMENT_PROFILE))
ALLOW_INSECURE_STARTUP := parse_bool_value(env_or_many(["WDG_ALLOW_INSECURE_STARTUP"], DEFAULT_ALLOW_INSECURE_STARTUP), false)
DASHBOARD_CHARTJS_LOCAL_PATH := env_or_many(["WDG_CHARTJS_LOCAL_PATH"], DEFAULT_CHARTJS_LOCAL_PATH)
PROXY_AUTHZ_ALLOWLIST := parse_csv_terms(env_or_many(["WDG_PROXY_AUTHZ_ALLOWLIST"], DEFAULT_PROXY_AUTHZ_ALLOWLIST))
PROXY_TIMEOUT_SECS := parse_int_env_many(["WDG_PROXY_TIMEOUT_SECS"], DEFAULT_PROXY_TIMEOUT_SECS)
MAX_PROXY_BODY_BYTES := parse_int_env_many(["WDG_MAX_PROXY_BODY_BYTES"], DEFAULT_MAX_PROXY_BODY_BYTES)
MAX_PARSE_BODY_BYTES := parse_int_env_many(["WDG_MAX_PARSE_BODY_BYTES"], DEFAULT_MAX_PARSE_BODY_BYTES)
REDACTION_MODE := to_lower(env_or_many(["WDG_REDACTION_MODE"], DEFAULT_REDACTION_MODE))
REDACT_TERMS := parse_csv_terms(env_or_many(["WDG_REDACT_TERMS"], DEFAULT_REDACT_TERMS))
RATE_LIMIT_MODE := to_lower(env_or_many(["WDG_RATE_LIMIT_MODE"], DEFAULT_RATE_LIMIT_MODE))
RATE_LIMIT_MAX_REQUESTS := parse_int_env_many(["WDG_RATE_LIMIT_MAX_REQUESTS"], DEFAULT_RATE_LIMIT_MAX_REQUESTS)
RATE_LIMIT_WINDOW_SECS := parse_int_env_many(["WDG_RATE_LIMIT_WINDOW_SECS"], DEFAULT_RATE_LIMIT_WINDOW_SECS)
RATE_LIMIT_MAX_BUCKETS := positive_int_or_fallback(parse_int_env_many(["WDG_RATE_LIMIT_MAX_BUCKETS"], DEFAULT_RATE_LIMIT_MAX_BUCKETS), DEFAULT_RATE_LIMIT_MAX_BUCKETS)
RATE_LIMIT_BUCKET_TTL_SECS := positive_int_or_fallback(parse_int_env_many(["WDG_RATE_LIMIT_BUCKET_TTL_SECS"], DEFAULT_RATE_LIMIT_BUCKET_TTL_SECS), DEFAULT_RATE_LIMIT_BUCKET_TTL_SECS)
IDENTIFIER_MAX_LEN := positive_int_or_fallback(parse_int_env_many(["WDG_IDENTIFIER_MAX_LEN"], DEFAULT_IDENTIFIER_MAX_LEN), DEFAULT_IDENTIFIER_MAX_LEN)
EXPORT_MAX_ROWS := positive_int_or_fallback(parse_int_env_many(["WDG_EXPORT_MAX_ROWS"], DEFAULT_EXPORT_MAX_ROWS), DEFAULT_EXPORT_MAX_ROWS)
BACKUP_DEFAULT_ENABLED := parse_bool_value(env_or_many(["WDG_BACKUP_ENABLED"], DEFAULT_BACKUP_ENABLED), true)
BACKUP_DEFAULT_INTERVAL_MINUTES := positive_int_or_fallback(parse_int_env_many(["WDG_BACKUP_INTERVAL_MINUTES"], DEFAULT_BACKUP_INTERVAL_MINUTES), DEFAULT_BACKUP_INTERVAL_MINUTES)
BACKUP_DEFAULT_DIR := env_or_many(["WDG_BACKUP_DIR"], DEFAULT_BACKUP_DIR)
BACKUP_DEFAULT_RETENTION_COUNT := positive_int_or_fallback(parse_int_env_many(["WDG_BACKUP_RETENTION_COUNT"], DEFAULT_BACKUP_RETENTION_COUNT), DEFAULT_BACKUP_RETENTION_COUNT)
BACKUP_DEFAULT_ENCRYPTION_ENABLED := parse_bool_value(env_or_many(["WDG_BACKUP_ENCRYPTION_ENABLED"], DEFAULT_BACKUP_ENCRYPTION_ENABLED), false)
BACKUP_ENCRYPTION_KEY_FILE := env_or_many(["WDG_BACKUP_ENCRYPTION_KEY_FILE"], "")
BACKUP_SCRIPT_PATH := env_or_many(["WDG_BACKUP_SCRIPT_PATH"], DEFAULT_BACKUP_SCRIPT_PATH)
NODE_BIN := env_or_many(["WDG_NODE_BIN"], DEFAULT_NODE_BIN)
OPENSSL_BIN := env_or_many(["WDG_OPENSSL_BIN"], DEFAULT_OPENSSL_BIN)

func print_lines(line_values) {
	for line in line_values {
		print(to_string(line))
	}
}

func kv(label, value) {
	print(to_string(label) + ": " + to_string(value))
}

print_lines(["=== Watchdog ===", ""])
kv("Port", PORT)
kv("Database", DB_PATH)
kv("Proxy config", PROXY_CONFIG_PATH)
kv("API auth mode", API_AUTH_MODE)
kv("Proxy auth mode", PROXY_AUTHZ_MODE)
kv("Deployment profile", DEPLOYMENT_PROFILE)
kv("Dashboard local Chart.js path", DASHBOARD_CHARTJS_LOCAL_PATH)
kv("Proxy timeout seconds", PROXY_TIMEOUT_SECS)
kv("Max proxy body bytes", MAX_PROXY_BODY_BYTES)
kv("Max parse body bytes", MAX_PARSE_BODY_BYTES)
kv("Telemetry redaction mode", REDACTION_MODE)
kv("Rate limit mode", RATE_LIMIT_MODE)
kv("Rate limit max requests", RATE_LIMIT_MAX_REQUESTS)
kv("Rate limit window seconds", RATE_LIMIT_WINDOW_SECS)
kv("Rate limit max buckets", RATE_LIMIT_MAX_BUCKETS)
kv("Rate limit bucket ttl seconds", RATE_LIMIT_BUCKET_TTL_SECS)
kv("Identifier max length", IDENTIFIER_MAX_LEN)
kv("Export max rows", EXPORT_MAX_ROWS)
kv("Backup default enabled", BACKUP_DEFAULT_ENABLED)
kv("Backup default interval minutes", BACKUP_DEFAULT_INTERVAL_MINUTES)
kv("Backup default directory", BACKUP_DEFAULT_DIR)
kv("Backup encryption key configured", BACKUP_ENCRYPTION_KEY_FILE != "")
if API_AUTH_MODE != "token" {
	print_lines([
		"Warning: API auth is disabled and Kujo http_server listens on all interfaces.",
		"Use local-only networking, firewall rules, or a reverse proxy before non-local exposure."
	])
}

startup_policy_errors := []
if DEPLOYMENT_PROFILE == "production" {
	if API_AUTH_MODE != "token" {
		startup_policy_errors := push(startup_policy_errors, "WDG_API_AUTH_MODE must be token in production")
	}
	if API_AUTH_TOKEN == "" {
		startup_policy_errors := push(startup_policy_errors, "WDG_API_AUTH_TOKEN must be set in production")
	}
	if PROXY_AUTHZ_MODE != "token" {
		startup_policy_errors := push(startup_policy_errors, "WDG_PROXY_AUTHZ_MODE must be token in production")
	}
	if PROXY_AUTHZ_TOKEN == "" {
		startup_policy_errors := push(startup_policy_errors, "WDG_PROXY_AUTHZ_TOKEN must be set in production")
	}
}

if len(startup_policy_errors) > 0 {
	policy_message := join_policy_errors(startup_policy_errors)
	if ALLOW_INSECURE_STARTUP {
		print_lines([
			"Warning: production startup policy override enabled via WDG_ALLOW_INSECURE_STARTUP.",
			"Startup policy violations: " + policy_message
		])
	} else {
		print("FATAL: production startup policy violations: " + policy_message)
		parse_int("watchdog_startup_policy_failure")
	}
}
print("")

