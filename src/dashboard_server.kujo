		}
	}

	return ""
}

func joined_proxy_action(params) {
	action := string_dict_get(params, "action", "")
	subaction := string_dict_get(params, "subaction", "")
	tail := string_dict_get(params, "tail", "")

	parts := []
	if action != "" {
		parts := push(parts, action)
	}
	if subaction != "" {
		parts := push(parts, subaction)
	}
	if tail != "" {
		parts := push(parts, tail)
	}

	out := ""
	i := 0
	while i < len(parts) {
		if i > 0 {
			out := out + "/"
		}
		out := out + to_string(parts[i])
		i := i + 1
	}

	return out
}

func proxy_route_dispatch(req) {
	maybe_run_scheduled_backup()
	rate_limit_response := enforce_rate_limit(req)
	if type(rate_limit_response) != "null" {
		return rate_limit_response
	}

	params := safe_dict_get(req, "params", {})
	resource := string_dict_get(params, "resource", "")
	action := joined_proxy_action(params)
	proxy_path := "/proxy/v1/" + trim(to_string(resource))
	if trim(to_string(action)) != "" {
		proxy_path := proxy_path + "/" + trim(to_string(action))
	}

	proxy_auth := require_proxy_auth(req, proxy_path)
	if !proxy_auth["allowed"] {
		return api_error(proxy_auth["status"], proxy_auth["error"])
	}

	return proxy_forward(req, resource, action)
}

func proxy_forward_named_upstream(req, resource, action, profile_name) {
	file_cfg := read_proxy_config_file(PROXY_CONFIG_PATH)
	raw_profiles := safe_dict_get(file_cfg, "upstream_profiles", {})
	profile_cfg := safe_dict_get(raw_profiles, profile_name, null)
	if type(profile_cfg) != "dict" {
		error_message := "Unknown Watchdog upstream profile: " + profile_name
		insert_audit_event("proxy_profile_rejected", resolve_audit_actor_key(req, "proxy"), "denied", {
			"reason": error_message
		})
		return api_error(400, error_message)
	}
	cfg := merge_config_maps({"upstream_base_url": DEFAULT_UPSTREAM_BASE_URL, "auth_mode": DEFAULT_AUTH_MODE, "upstream_api_key": "", "upstream_api_key_env": ""}, profile_cfg)
	cfg["upstream_base_url"] := normalize_base_url(string_dict_get(cfg, "upstream_base_url", DEFAULT_UPSTREAM_BASE_URL))
	return proxy_forward_with_config(req, resource, action, cfg, profile_name)
}

func proxy_forward(req, resource, action) {
	headers_in := safe_dict_get(req, "headers", {})
	profile_name := trim(get_header(headers_in, "X-Watchdog-Upstream-Profile"))
	if profile_name != "" && profile_name != "default" {
		return proxy_forward_named_upstream(req, resource, action, profile_name)
	}
	return proxy_forward_with_config(req, resource, action, effective_proxy_config(PROXY_CONFIG_PATH), "default")
}

func proxy_forward_with_config(req, resource, action, cfg, upstream_profile) {
	headers_in := safe_dict_get(req, "headers", {})

	resource_clean := trim(to_string(resource))
	action_clean := trim(to_string(action))
	if resource_clean == "" {
		return api_error(400, "Missing proxy resource path")
	}

	path_suffix := "/" + resource_clean
	if action_clean != "" {
		path_suffix := path_suffix + "/" + action_clean
	}

	request_body := to_string(safe_dict_get(req, "body", ""))
	started_ms := current_timestamp()
	method := to_string(safe_dict_get(req, "method", "POST"))
	content_type_in := get_header(headers_in, "Content-Type")
	if content_type_in == "" {
		content_type_in := "application/json"
	}

	path_validation := validate_proxy_path(resource_clean, action_clean)
	query_suffix := ""
	if path_validation["ok"] {
		query_validation := build_proxy_query_suffix(req)
		if !query_validation["ok"] {
			path_validation := {
				"ok": false,
				"error": query_validation["error"]
			}
		} else {
			query_suffix := to_string(query_validation["query"])
		}
	}

	upstream_url := string_dict_get(cfg, "upstream_base_url", DEFAULT_UPSTREAM_BASE_URL) + path_suffix + query_suffix
	forwarded_path := path_suffix + query_suffix

	if !path_validation["ok"] {
		session_id_hint := resolve_session_id(req, null)
		user_id_hint := resolve_user_id(req, null)
		tenant_id_hint := resolve_tenant_id(req, null)
		project_id_hint := resolve_project_id(req, null)
		workflow_id_hint := resolve_workflow_id(req, null)
		task_id_hint := resolve_task_id(req, null)
		correlation_id_hint := resolve_correlation_id(req, null)
		agent_id_hint := "proxy:" + resource_clean
		latency_ms := current_timestamp() - started_ms
		error_message := to_string(path_validation["error"])
		request_dbid := insert_request_row(session_id_hint, user_id_hint, tenant_id_hint, project_id_hint, workflow_id_hint, task_id_hint, correlation_id_hint, upstream_profile, "", "", "error", 0, 0, 0, 0.0, latency_ms, "", "unsafe_proxy_path", error_message, "", "")
		insert_tool_call_row(request_dbid, session_id_hint, "proxy_forward", {
			"method": method,
			"path": forwarded_path,
			"upstream_profile": upstream_profile,
			"upstream_url": upstream_url
		}, {
			"error": error_message
		}, "error", latency_ms)
		insert_agent_step_row(session_id_hint, agent_id_hint, "proxy_failed", "Rejected unsafe proxy path or query.", {
			"path": forwarded_path,
			"error": error_message
		})
		insert_audit_event("proxy_path_rejected", resolve_audit_actor_key(req, "proxy"), "denied", {
			"path": forwarded_path,
			"reason": error_message
		})
		return api_error(400, error_message)
	}

	request_body_bytes := utf8_byte_length(request_body)
	if request_body_bytes > MAX_PROXY_BODY_BYTES {
		session_id_hint := resolve_session_id(req, null)
		user_id_hint := resolve_user_id(req, null)
		tenant_id_hint := resolve_tenant_id(req, null)
		project_id_hint := resolve_project_id(req, null)
		workflow_id_hint := resolve_workflow_id(req, null)
		task_id_hint := resolve_task_id(req, null)
		correlation_id_hint := resolve_correlation_id(req, null)
		agent_id_hint := "proxy:" + resource_clean
		latency_ms := current_timestamp() - started_ms
		error_message := "Proxy request body exceeds configured max bytes: " + to_string(MAX_PROXY_BODY_BYTES)
		request_dbid := insert_request_row(session_id_hint, user_id_hint, tenant_id_hint, project_id_hint, workflow_id_hint, task_id_hint, correlation_id_hint, upstream_profile, "", "", "error", 0, 0, 0, 0.0, latency_ms, "", "payload_too_large", error_message, "", "")
		insert_tool_call_row(request_dbid, session_id_hint, "proxy_forward", {
			"method": method,
			"path": forwarded_path,
			"upstream_profile": upstream_profile,
			"upstream_url": upstream_url
		}, {
			"error": error_message
		}, "error", latency_ms)
		insert_agent_step_row(session_id_hint, agent_id_hint, "proxy_failed", "Proxy request body exceeded configured max bytes.", {
			"path": forwarded_path,
			"max_proxy_body_bytes": MAX_PROXY_BODY_BYTES,
			"request_body_bytes": request_body_bytes
		})
		return api_error(413, error_message)
	}

	decoder_kind := "opaque"
	if to_lower(resource_clean) == "chat" && to_lower(action_clean) == "completions" { decoder_kind = "chat_completions" }
	payload_obj := null
	payload_parse := {"ok": true, "data": null, "error": ""}
	if decoder_kind == "chat_completions" { payload_parse = parse_json_with_limit(request_body, MAX_PARSE_BODY_BYTES) }
	if payload_parse["ok"] {
		if type(payload_parse["data"]) == "dict" { payload_obj = payload_parse["data"] }
	} else {
		if len(trim(request_body)) > 0 && contains(to_lower(content_type_in), "application/json") {
			session_id_hint := resolve_session_id(req, null)
			user_id_hint := resolve_user_id(req, null)
			tenant_id_hint := resolve_tenant_id(req, null)
			project_id_hint := resolve_project_id(req, null)
			workflow_id_hint := resolve_workflow_id(req, null)
			task_id_hint := resolve_task_id(req, null)
			correlation_id_hint := resolve_correlation_id(req, null)
			agent_id_hint := "proxy:" + resource_clean
			latency_ms := current_timestamp() - started_ms
			error_code := "invalid_json"
			status_code := 400
			error_message := "Invalid JSON body"
			if payload_parse["error"] == "json body exceeds configured parse limit" {
				error_code := "json_parse_limit"
				status_code := 413
				error_message := "JSON body exceeds configured parse limit: " + to_string(MAX_PARSE_BODY_BYTES)
			}

			request_dbid := insert_request_row(session_id_hint, user_id_hint, tenant_id_hint, project_id_hint, workflow_id_hint, task_id_hint, correlation_id_hint, upstream_profile, "", "", "error", 0, 0, 0, 0.0, latency_ms, "", error_code, error_message, "", "")
			insert_tool_call_row(request_dbid, session_id_hint, "proxy_forward", {
				"method": method,
				"path": forwarded_path,
				"upstream_profile": upstream_profile,
				"upstream_url": upstream_url
			}, {
				"error": error_message
			}, "error", latency_ms)
			insert_agent_step_row(session_id_hint, agent_id_hint, "proxy_failed", "Proxy request JSON parsing failed.", {
				"path": forwarded_path,
				"error": error_message
			})
			return api_error(status_code, error_message)
		}
	}

	session_id := resolve_session_id(req, payload_obj)
	user_id := resolve_user_id(req, payload_obj)
	tenant_id := resolve_tenant_id(req, payload_obj)
	project_id := resolve_project_id(req, payload_obj)
	workflow_id := resolve_workflow_id(req, payload_obj)
	task_id := resolve_task_id(req, payload_obj)
	correlation_id := resolve_correlation_id(req, payload_obj)
	trace_id := resolve_trace_id(req, payload_obj)
	parent_span_id := resolve_parent_span_id(req, payload_obj)
	proxy_observability := resolve_proxy_observability(req)
	proxy_observability["project_id"] = project_id
	if proxy_observability["error"] != "" { return api_error_code(400, "invalid_semantics", proxy_observability["error"]) }
	agent_id := "proxy:" + resource_clean

	prompt_summary := ""
	model_name := ""
	if type(payload_obj) == "dict" {
		model_name := string_dict_get(payload_obj, "model", "")
		prompt_summary := safe_prompt_summary(safe_dict_get(payload_obj, "messages", []))
	}

	insert_agent_step_row(session_id, agent_id, "proxy_received", "Received proxy request for " + forwarded_path, {
		"method": method,
		"decoder": decoder_kind,
		"request_body_bytes": request_body_bytes,
		"upstream_profile": upstream_profile,
		"upstream_url": upstream_url,
		"auth_mode": cfg["auth_mode"]
	})

	headers_out := {}
	headers_out["Content-Type"] := content_type_in

	if cfg["auth_mode"] == "override" {
		override_key := resolve_override_api_key(cfg)
		if override_key == "" {
			latency_ms := current_timestamp() - started_ms
			request_dbid := insert_request_row(session_id, user_id, tenant_id, project_id, workflow_id, task_id, correlation_id, upstream_profile, model_name, "", "error", 0, 0, 0, 0.0, latency_ms, "", "proxy_auth_missing", "Proxy auth_mode=override but no API key is configured.", prompt_summary, "")
			insert_proxy_model_trace(trace_id, parent_span_id, request_dbid, session_id, upstream_profile, model_name, "error", 500, started_ms, current_timestamp(), {}, proxy_observability)
			insert_agent_step_row(session_id, agent_id, "proxy_failed", "Proxy override mode is missing an upstream API key.", {"upstream_url": upstream_url})
			return api_error(500, "Proxy auth_mode=override requires WDG_UPSTREAM_API_KEY or WDG_UPSTREAM_API_KEY_ENV")
		}
		headers_out["Authorization"] := "Bearer " + override_key
	} else {
		auth_header := get_header(headers_in, "Authorization")
		if auth_header != "" {
			headers_out["Authorization"] := auth_header
		}
	}

	http_referer := get_header(headers_in, "HTTP-Referer")
	if http_referer != "" {
		headers_out["HTTP-Referer"] := http_referer
	}
	x_title := get_header(headers_in, "X-Title")
	if x_title != "" {
		headers_out["X-Title"] := x_title
	}
	traceparent := to_lower(trim(get_header(headers_in, "traceparent")))
	if valid_traceparent(traceparent) { headers_out["traceparent"] := traceparent }
	tracestate := trim(get_header(headers_in, "tracestate"))
	if valid_traceparent(traceparent) && tracestate != "" && len(tracestate) <= 512 && contains(tracestate, "\n") == 0 && contains(tracestate, "\r") == 0 {
		headers_out["tracestate"] := tracestate
	}

	request_options := {
		"method": method,
		"timeout": PROXY_TIMEOUT_SECS * 1.0
	}
	request_options["_headers"] := headers_out
	if len(request_body) > 0 {
		request_options["_body"] := request_body
	}

	insert_agent_step_row(session_id, agent_id, "proxy_forwarded", "Forwarded request to upstream.", {
		"upstream_url": upstream_url,
		"upstream_profile": upstream_profile,
		"method": method,
		"auth_mode": cfg["auth_mode"]
	})

	http_result := http_request(upstream_url, request_options)
	match http_result {
		case Ok(resp): {
			status_code := to_int_or_zero(safe_dict_get(resp, "_status", safe_dict_get(resp, "status", 0)))
			body_text := to_string(safe_dict_get(resp, "_body", safe_dict_get(resp, "body", "")))
			resp_headers := safe_dict_get(resp, "_headers", safe_dict_get(resp, "headers", {}))
			content_type := get_header(resp_headers, "Content-Type")
			if content_type == "" {
				content_type := "application/json"
			}

			request_id := ""
			status_label := "success"
			error_code := ""
			error_message := ""
			finish_reason := ""
			response_summary := ""
			usage := {"input_tokens": 0, "output_tokens": 0, "total_tokens": 0}

			is_sse_response := decoder_kind == "chat_completions" && contains(to_lower(content_type), "text/event-stream")
			if is_sse_response {
				proxy_observability["response_streamed"] = true
				proxy_observability["timing_source"] = "unavailable_buffered_transport"
				events := parse_stream_events(body_text)
				request_id := request_id_from_stream_events(events)
				usage := usage_from_stream_events(events)
				response_summary := response_summary_from_stream_events(events)
				finish_reason := finish_reason_from_stream_events(events)
				model_name := model_from_stream_events(events, model_name)
			} else if decoder_kind == "chat_completions" {
				parsed := parse_json_safe(body_text)
				if parsed["ok"] {
					data := parsed["data"]
					if type(data) == "dict" {
						request_id := string_dict_get(data, "id", "")
						if model_name == "" {
							model_name := string_dict_get(data, "model", model_name)
						}
						usage := usage_from_json_data(data)
						response_summary := response_summary_from_json_data(data)
						finish_reason := finish_reason_from_json_data(data)
						err_obj := safe_dict_get(data, "error", null)
						if type(err_obj) == "dict" {
							status_label := "error"
							error_code := "provider_error"
							error_message := string_dict_get(err_obj, "message", "Provider returned an error.")
						}
					}
				}
			}

			if status_code < 200 || status_code > 299 {
				status_label := "error"
				if is_sse_response && len(trim(body_text)) > 0 { proxy_observability["output_partial"] = true }
				if error_code == "" {
					error_code := "http_error"
					error_message := "HTTP " + to_string(status_code)
				}
			}

			latency_ms := current_timestamp() - started_ms
			cost_usd := watchdog_estimate_cost(model_name, usage["input_tokens"] * 1.0, usage["output_tokens"] * 1.0)
			request_dbid := insert_request_row(session_id, user_id, tenant_id, project_id, workflow_id, task_id, correlation_id, upstream_profile, model_name, request_id, status_label, usage["input_tokens"], usage["output_tokens"], usage["total_tokens"], cost_usd, latency_ms, finish_reason, error_code, error_message, prompt_summary, response_summary)
			insert_proxy_model_trace(trace_id, parent_span_id, request_dbid, session_id, upstream_profile, model_name, status_label, status_code, started_ms, current_timestamp(), usage, proxy_observability)

			insert_tool_call_row(request_dbid, session_id, "proxy_forward", {
				"method": method,
				"path": forwarded_path,
				"upstream_profile": upstream_profile,
				"upstream_url": upstream_url
			}, {
				"status_code": status_code,
				"status": status_label,
				"error_code": error_code
			}, status_label, latency_ms)

			insert_agent_step_row(session_id, agent_id, "proxy_completed", "Completed proxy request.", {
				"status_code": status_code,
				"status": status_label,
				"model": model_name,
				"latency_ms": latency_ms,
				"decoder": decoder_kind,
				"request_body_bytes": request_body_bytes,
				"response_body_bytes": utf8_byte_length(body_text),
				"path": forwarded_path
			})

			return forward_response(status_code, body_text, content_type, resp_headers)
		}
		case Err(err): {
			latency_ms := current_timestamp() - started_ms
			request_dbid := insert_request_row(session_id, user_id, tenant_id, project_id, workflow_id, task_id, correlation_id, upstream_profile, model_name, "", "error", 0, 0, 0, 0.0, latency_ms, "", "network_error", to_string(err), prompt_summary, "")
			insert_proxy_model_trace(trace_id, parent_span_id, request_dbid, session_id, upstream_profile, model_name, "error", 502, started_ms, current_timestamp(), {}, proxy_observability)
			insert_tool_call_row(request_dbid, session_id, "proxy_forward", {
				"method": method,
				"path": forwarded_path,
				"upstream_profile": upstream_profile,
				"upstream_url": upstream_url
			}, {
				"error": to_string(err)
			}, "error", latency_ms)
			insert_agent_step_row(session_id, agent_id, "proxy_failed", "Proxy network error.", {
				"error": to_string(err),
				"path": forwarded_path
			})
			return api_error(502, "Upstream request failed: " + to_string(err))
		}
		case other: {
			latency_ms := current_timestamp() - started_ms
			request_dbid := insert_request_row(session_id, user_id, tenant_id, project_id, workflow_id, task_id, correlation_id, upstream_profile, model_name, "", "error", 0, 0, 0, 0.0, latency_ms, "", "transport_error", "Unexpected http_request result type: " + type(other), prompt_summary, "")
			insert_proxy_model_trace(trace_id, parent_span_id, request_dbid, session_id, upstream_profile, model_name, "error", 502, started_ms, current_timestamp(), {}, proxy_observability)
			insert_tool_call_row(request_dbid, session_id, "proxy_forward", {
				"method": method,
				"path": forwarded_path,
				"upstream_profile": upstream_profile,
				"upstream_url": upstream_url
			}, {
				"error": "Unexpected http_request result type: " + type(other)
			}, "error", latency_ms)
			insert_agent_step_row(session_id, agent_id, "proxy_failed", "Proxy transport error.", {
				"error": "Unexpected http_request result type: " + type(other),
				"path": forwarded_path
			})
			return api_error(502, "Unexpected upstream transport result")
		}
	}
}

# ---------------------------------------------------------------------------
# HTTP Server + Routes
# ---------------------------------------------------------------------------

maybe_run_scheduled_backup()
server := http_server(PORT)

server := server.route("GET", "/healthz", func(req) {
	return api_ok({
		"status": "ok",
		"service": "watchdog"
	})
})

server := server.route("GET", "/readyz", func(req) {
	try {
		rows := db_query(db, "SELECT 1 AS ready", [])
		if len(rows) == 0 {
			return api_error(503, "Database readiness check returned no rows")
		}
		return api_ok({
			"status": "ready",
			"database": "ok"
		})
	} except err {
		return api_error(503, "Database readiness check failed")
	}
})

# Watchdog UI
server := server.route("GET", "/", func(req) {
	html := read_file("dashboard.html")
	font_base64 := ""
	if file_exists(DASHBOARD_DEPARTURE_MONO_PATH) {
		font_base64 = encode_base64(read_binary_file(DASHBOARD_DEPARTURE_MONO_PATH))
	}
	html = replace(html, "__WATCHDOG_DEPARTURE_MONO_WOFF2__", font_base64)
	return apply_default_security_headers(html_response(200, html))
})

server := server.route("GET", "/assets/vendor/dither-charts.js", func(req) {
	if !file_exists(DASHBOARD_DITHER_CHARTS_JS_PATH) {
		response := http_response(404, "Dither Kit chart bundle not found at configured path.")
		response := set_header(response, "Content-Type", "text/plain; charset=utf-8")
		return apply_default_security_headers(response)
	}

	asset := read_file(DASHBOARD_DITHER_CHARTS_JS_PATH)
	response := http_response(200, asset)
	response := set_header(response, "Content-Type", "application/javascript; charset=utf-8")
	return apply_default_security_headers(response)
})

server := server.route("GET", "/assets/vendor/dither-charts.css", func(req) {
	if !file_exists(DASHBOARD_DITHER_CHARTS_CSS_PATH) {
		response := http_response(404, "Dither Kit chart stylesheet not found at configured path.")
		response := set_header(response, "Content-Type", "text/plain; charset=utf-8")
		return apply_default_security_headers(response)
	}

	asset := read_file(DASHBOARD_DITHER_CHARTS_CSS_PATH)
	response := http_response(200, asset)
	response := set_header(response, "Content-Type", "text/css; charset=utf-8")
	return apply_default_security_headers(response)
})

# Proxy config visibility
server := server.route("GET", "/api/proxy-config", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}

	insert_audit_event("proxy_config_view", resolve_audit_actor_key(req, "api"), "success", {
		"visibility": PROXY_CONFIG_VISIBILITY
	})

	cfg := effective_proxy_config(PROXY_CONFIG_PATH)
	override_key := resolve_override_api_key(cfg)
	profiles := effective_upstream_profiles(PROXY_CONFIG_PATH)
	profile_summaries := []
	for profile_name in keys(profiles) {
		profile_cfg := profiles[profile_name]
		profile_override_key := resolve_override_api_key(profile_cfg)
		profile_summaries := push(profile_summaries, {
			"name": profile_name,
			"upstream_base_url": profile_cfg["upstream_base_url"],
			"auth_mode": profile_cfg["auth_mode"],
			"has_override_api_key": len(trim(profile_override_key)) > 0
		})
	}
	payload := {
		"upstream_base_url": cfg["upstream_base_url"],
		"auth_mode": cfg["auth_mode"],
		"has_override_api_key": len(trim(override_key)) > 0,
		"upstream_profiles": profile_summaries,
		"api_auth_mode": API_AUTH_MODE,
		"api_auth_enabled": API_AUTH_MODE == "token",
		"proxy_auth_mode": PROXY_AUTHZ_MODE,
		"proxy_auth_enabled": PROXY_AUTHZ_MODE == "token",
		"content_capture_mode": CONTENT_CAPTURE_MODE
	}

	if PROXY_CONFIG_VISIBILITY == "verbose" {
		payload["config_path"] := PROXY_CONFIG_PATH
		payload["upstream_api_key_env"] := cfg["upstream_api_key_env"]
		payload["has_api_auth_token"] := API_AUTH_TOKEN != ""
	}

	return api_ok(payload)
})

server := server.route("GET", "/api/version", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}

	return api_ok({
		"current_version": API_CONTRACT_VERSION,
		"status": API_CONTRACT_STATUS,
		"versioning_mode": "metadata",
		"legacy_base_path": "/api",
		"version_metadata_header": "X-Watchdog-API-Version",
		"telemetry_schema_versions": [TELEMETRY_SCHEMA_VERSION, CANONICAL_TELEMETRY_SCHEMA_VERSION],
		"notes": "Clients should pin behavior to the reported version metadata and monitor changelog guidance before upgrades."
	})
})

