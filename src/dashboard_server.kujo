func resolve_proxy_observability(req) {
	headers := safe_dict_get(req, "headers", {})
	result := {
		"application.name": truncate_str(trim(get_header(headers, "X-Watchdog-Application-Name")), 80),
		"application.version": truncate_str(trim(get_header(headers, "X-Watchdog-Application-Version")), 40),
		"harness.name": truncate_str(trim(get_header(headers, "X-Watchdog-Harness-Name")), 80),
		"harness.version": truncate_str(trim(get_header(headers, "X-Watchdog-Harness-Version")), 40),
		"logical_request_id": truncate_str(trim(get_header(headers, "X-Watchdog-Logical-Request-Id")), 160),
		"attempt_number": 1,
		"retry_of_request_id": truncate_str(trim(get_header(headers, "X-Watchdog-Retry-Of-Request-Id")), 160),
		"retry_reason_code": to_lower(truncate_str(trim(get_header(headers, "X-Watchdog-Retry-Reason-Code")), 40)),
		"retry_decision_source": to_lower(truncate_str(trim(get_header(headers, "X-Watchdog-Retry-Decision-Source")), 40)),
		"fallback_from_request_id": truncate_str(trim(get_header(headers, "X-Watchdog-Fallback-From-Request-Id")), 160),
		"fallback_dimension": to_lower(truncate_str(trim(get_header(headers, "X-Watchdog-Fallback-Dimension")), 40)),
		"fallback_reason_code": to_lower(truncate_str(trim(get_header(headers, "X-Watchdog-Fallback-Reason-Code")), 40)),
		"response_streamed": false,
		"timing_source": "unknown",
		"output_partial": false,
		"error": ""
	}
	attempt_text := trim(get_header(headers, "X-Watchdog-Attempt-Number"))
	if attempt_text != "" {
		try { result["attempt_number"] = parse_int(attempt_text) } except err { result["error"] = "X-Watchdog-Attempt-Number must be an integer" }
	}
	if result["attempt_number"] < 1 || result["attempt_number"] > 1000000 { result["error"] = "X-Watchdog-Attempt-Number must be from 1 to 1000000" }
	retry_reasons := ["rate_limit", "timeout", "transport", "provider_error", "invalid_response", "capacity", "policy", "operator", "unknown"]
	decision_sources := ["application", "framework", "watchdog", "provider", "operator", "unknown"]
	fallback_dimensions := ["provider", "model", "account_route", "region", "strategy", "unknown"]
	fallback_reasons := ["rate_limit", "timeout", "transport", "provider_error", "invalid_response", "capacity", "policy", "operator", "quality", "unknown"]
	if result["retry_reason_code"] != "" && contains(retry_reasons, result["retry_reason_code"]) == false { result["error"] = "invalid retry reason code" }
	if result["retry_decision_source"] != "" && contains(decision_sources, result["retry_decision_source"]) == false { result["error"] = "invalid retry decision source" }
	if result["fallback_dimension"] != "" && contains(fallback_dimensions, result["fallback_dimension"]) == false { result["error"] = "invalid fallback dimension" }
	if result["fallback_reason_code"] != "" && contains(fallback_reasons, result["fallback_reason_code"]) == false { result["error"] = "invalid fallback reason code" }
	if result["retry_reason_code"] != "" && result["retry_of_request_id"] == "" { result["error"] = "retry reason requires X-Watchdog-Retry-Of-Request-Id" }
	if result["retry_decision_source"] != "" && result["retry_of_request_id"] == "" { result["error"] = "retry decision source requires X-Watchdog-Retry-Of-Request-Id" }
	if result["fallback_dimension"] != "" && result["fallback_from_request_id"] == "" { result["error"] = "fallback dimension requires X-Watchdog-Fallback-From-Request-Id" }
	if result["fallback_reason_code"] != "" && result["fallback_dimension"] == "" { result["error"] = "fallback reason requires X-Watchdog-Fallback-Dimension" }
	return result
}

