server := server.route("POST", "/api/telemetry/v2/export-resume", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] { return api_error(auth["status"], auth["error"]) }
	parsed := parse_json_with_limit(to_string(safe_dict_get(req, "body", "{}")), MAX_PARSE_BODY_BYTES)
	if parsed["ok"] == false || type(parsed["data"]) != "dict" { return api_error(400, "Request body must be an object") }
	profile_id := truncate_str(trim(to_string(safe_dict_get(parsed["data"], "profile_id", ""))), 80)
	if profile_id == "" || exporter_profile_configured(profile_id) == false { return api_error(400, "Unknown exporter profile") }
	result := watchdog_delivery_resume_profile(db, profile_id)
	insert_audit_event("telemetry_export_profile_resume", resolve_audit_actor_key(req, "api"), "success", result)
	return api_ok(result)
})

server := server.route("POST", "/api/telemetry/v2/export-backfill", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] { return api_error(auth["status"], auth["error"]) }
	parsed := parse_json_with_limit(to_string(safe_dict_get(req, "body", "{}")), MAX_PARSE_BODY_BYTES)
	if parsed["ok"] == false || type(parsed["data"]) != "dict" { return api_error(400, "Request body must be an object") }
	profile_id := truncate_str(trim(to_string(safe_dict_get(parsed["data"], "profile_id", ""))), 80)
	if profile_id == "" || exporter_profile_configured(profile_id) == false { return api_error(400, "Unknown exporter profile") }
	limit_value := to_int_or_zero(safe_dict_get(parsed["data"], "limit", 5000))
	if limit_value < 1 { limit_value = 1 }
	if limit_value > 5000 { limit_value = 5000 }
	result := watchdog_delivery_backfill(db, profile_id, EXPORT_QUEUE_MAX_RECORDS, EXPORT_QUEUE_MAX_BYTES, limit_value)
	insert_audit_event("telemetry_export_backfill", resolve_audit_actor_key(req, "api"), "success", result)
	return api_ok(result)
})

# Existing dashboard APIs
server := server.route("GET", "/api/stats", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}
	maybe_run_scheduled_backup()

	request_time_filter := append_time_range_conditions(req, [], [], "created_at")
	request_where := where_clause_from_conditions(request_time_filter["conditions"])
	total_rows := db_query(db, "SELECT COUNT(*) AS n FROM requests" + request_where, request_time_filter["params"])
	error_rows := db_query(db, "SELECT COUNT(*) AS n FROM requests" + where_clause_from_conditions(push(request_time_filter["conditions"], "status = 'error'")), request_time_filter["params"])
	cost_rows := db_query(db, "SELECT COALESCE(SUM(cost_usd),0) AS total FROM requests" + request_where, request_time_filter["params"])
	lat_rows := db_query(db, "SELECT COALESCE(AVG(latency_ms),0) AS avg FROM requests" + where_clause_from_conditions(push(request_time_filter["conditions"], "status = 'success'")), request_time_filter["params"])
	tok_rows := db_query(db, "SELECT COALESCE(SUM(total_tokens),0) AS total FROM requests" + request_where, request_time_filter["params"])
	sess_rows := db_query(db, "SELECT COUNT(DISTINCT session_id) AS n FROM requests" + request_where, request_time_filter["params"])

	tool_time_filter := append_time_range_conditions(req, [], [], "created_at")
	tc_rows := db_query(db, "SELECT COUNT(*) AS n FROM tool_calls" + where_clause_from_conditions(tool_time_filter["conditions"]), tool_time_filter["params"])
	step_time_filter := append_time_range_conditions(req, [], [], "created_at")
	step_rows := db_query(db, "SELECT COUNT(*) AS n FROM agent_steps" + where_clause_from_conditions(step_time_filter["conditions"]), step_time_filter["params"])
	trace_time_filter := append_time_range_conditions(req, [], [], "started_at_ms")
	trace_rows := db_query(db, "SELECT COUNT(*) AS n FROM traces" + where_clause_from_conditions(trace_time_filter["conditions"]), trace_time_filter["params"])
	span_time_filter := append_time_range_conditions(req, [], [], "started_at_ms")
	span_rows := db_query(db, "SELECT COUNT(*) AS n FROM trace_spans" + where_clause_from_conditions(span_time_filter["conditions"]), span_time_filter["params"])
	event_time_filter := append_time_range_conditions(req, [], [], "occurred_at_ms")
	event_rows := db_query(db, "SELECT COUNT(*) AS n FROM trace_events" + where_clause_from_conditions(event_time_filter["conditions"]), event_time_filter["params"])
	canonical_rows := db_query(db, "SELECT COUNT(*) AS n FROM telemetry_records_v2", [])

	total := total_rows[0]["n"]
	errors := error_rows[0]["n"]
	cost := cost_rows[0]["total"]
	avg_lat := lat_rows[0]["avg"]
	tokens := tok_rows[0]["total"]
	sess_n := sess_rows[0]["n"]
	tc_n := tc_rows[0]["n"]
	steps_n := step_rows[0]["n"]
	trace_n := trace_rows[0]["n"]
	span_n := span_rows[0]["n"]
	event_n := event_rows[0]["n"]
	canonical_n := canonical_rows[0]["n"]

	error_rate := 0.0
	if total > 0 {
		error_rate := (errors * 100.0) / total
	}

	return api_ok({
		"total_requests": total,
		"total_errors": errors,
		"error_rate_pct": error_rate,
		"total_cost_usd": cost,
		"avg_latency_ms": avg_lat,
		"total_tokens": tokens,
		"total_sessions": sess_n,
		"total_tool_calls": tc_n,
		"total_agent_steps": steps_n,
		"total_traces": trace_n,
		"total_trace_spans": span_n,
		"total_trace_events": event_n,
		"total_canonical_records": canonical_n
	})
})

server := server.route("GET", "/api/requests", func(req) {
