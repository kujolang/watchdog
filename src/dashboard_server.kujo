# Watchdog + OpenAI-Compatible Proxy
# Compatibility entrypoint mirrored from src/dashboard_server.kujo.
#
# Run:
#   /path/to/kujo run --interpreter dashboard_server.kujo
#
# Default Watchdog URL:
#   http://localhost:7700
#
# Proxy URL pattern:
#   http://localhost:7700/proxy/v1/<resource>/<action>
#
# Example for chat completions:
#   POST http://localhost:7700/proxy/v1/chat/completions

