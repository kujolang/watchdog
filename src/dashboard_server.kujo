server := server.route("GET", "/api/charts/provider-breakdown", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}

	conditions := []
	params := []
	time_filter := append_time_range_conditions(req, conditions, params, "created_at")
	conditions := time_filter["conditions"]
	params := time_filter["params"]
	tenant_id := request_query_text(req, "tenant_id", "")
	if tenant_id != "" {
		conditions := push(conditions, "tenant_id = ?")
		params := push(params, tenant_id)
	}
	project_id := request_query_text(req, "project_id", "")
	if project_id != "" {
		conditions := push(conditions, "project_id = ?")
		params := push(params, project_id)
	}
	sql := "SELECT provider, model, COUNT(*) AS count, COALESCE(SUM(cost_usd),0) AS total_cost, COALESCE(AVG(latency_ms),0) AS avg_latency FROM requests"
	sql := sql + where_clause_from_conditions(conditions)
	sql := sql + " GROUP BY provider, model ORDER BY count DESC"
	rows := db_query(db, sql, params)
	return api_ok(rows)
})

server := server.route("GET", "/api/admin/diagnostics", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}

	migration_rows := db_query(db, "SELECT key, applied_at FROM schema_migrations ORDER BY key ASC", [])
	request_rows := db_query(db, "SELECT COUNT(*) AS n FROM requests", [])
	tool_rows := db_query(db, "SELECT COUNT(*) AS n FROM tool_calls", [])
	step_rows := db_query(db, "SELECT COUNT(*) AS n FROM agent_steps", [])
	audit_rows := db_query(db, "SELECT COUNT(*) AS n FROM audit_events", [])
	trace_rows := db_query(db, "SELECT COUNT(*) AS n FROM traces", [])
	span_rows := db_query(db, "SELECT COUNT(*) AS n FROM trace_spans", [])
	event_rows := db_query(db, "SELECT COUNT(*) AS n FROM trace_events", [])
	backup_run_rows := db_query(db, "SELECT COUNT(*) AS n FROM backup_runs", [])
	backup_settings := read_backup_settings()

	diagnostics := {
		"runtime": {
			"port": PORT,
			"db_path": DB_PATH,
			"proxy_config_path": PROXY_CONFIG_PATH,
			"proxy_config_visibility": PROXY_CONFIG_VISIBILITY,
			"api_auth_mode": API_AUTH_MODE,
			"api_auth_token_present": API_AUTH_TOKEN != "",
			"proxy_auth_mode": PROXY_AUTHZ_MODE,
			"proxy_auth_token_present": PROXY_AUTHZ_TOKEN != "",
			"rate_limit_mode": RATE_LIMIT_MODE,
			"rate_limit_max_requests": RATE_LIMIT_MAX_REQUESTS,
			"rate_limit_window_secs": RATE_LIMIT_WINDOW_SECS,
			"rate_limit_max_buckets": RATE_LIMIT_MAX_BUCKETS,
			"rate_limit_bucket_ttl_secs": RATE_LIMIT_BUCKET_TTL_SECS,
			"redaction_mode": REDACTION_MODE,
			"content_capture_mode": CONTENT_CAPTURE_MODE,
			"identifier_max_len": IDENTIFIER_MAX_LEN,
			"export_max_rows": EXPORT_MAX_ROWS,
			"backup_enabled": backup_settings["enabled"],
			"backup_interval_minutes": backup_settings["interval_minutes"],
			"backup_encryption_enabled": backup_settings["encryption_enabled"],
			"backup_encryption_key_configured": BACKUP_ENCRYPTION_KEY_FILE != ""
		},
		"migrations": migration_rows,
		"db_stats": {
			"requests": to_int_or_zero(request_rows[0]["n"]),
			"tool_calls": to_int_or_zero(tool_rows[0]["n"]),
			"agent_steps": to_int_or_zero(step_rows[0]["n"]),
			"audit_events": to_int_or_zero(audit_rows[0]["n"]),
			"traces": to_int_or_zero(trace_rows[0]["n"]),
			"trace_spans": to_int_or_zero(span_rows[0]["n"]),
			"trace_events": to_int_or_zero(event_rows[0]["n"]),
			"backup_runs": to_int_or_zero(backup_run_rows[0]["n"])
		}
	}

	return api_ok(diagnostics)
})

server := server.route("GET", "/api/admin/backups", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}
	maybe_run_scheduled_backup()
	return api_ok(backup_status_payload())
})

server := server.route("PUT", "/api/admin/backups/settings", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}
	body_parse := parse_json_with_limit(to_string(safe_dict_get(req, "body", "{}")), MAX_PARSE_BODY_BYTES)
	if !body_parse["ok"] || type(body_parse["data"]) != "dict" {
		return api_error(400, "Request body must be a JSON object")
	}
	body := body_parse["data"]
	current := read_backup_settings()
	enabled := parse_bool_value(safe_dict_get(body, "enabled", current["enabled"]), current["enabled"])
	interval_minutes := to_int_or_zero(safe_dict_get(body, "interval_minutes", current["interval_minutes"]))
	retention_count := to_int_or_zero(safe_dict_get(body, "retention_count", current["retention_count"]))
	encryption_enabled := parse_bool_value(safe_dict_get(body, "encryption_enabled", current["encryption_enabled"]), current["encryption_enabled"])
	backup_dir_check := validate_backup_dir(safe_dict_get(body, "backup_dir", current["backup_dir"]))
	if !backup_dir_check["ok"] {
		return api_error(400, backup_dir_check["error"])
	}
	if interval_minutes < MIN_BACKUP_INTERVAL_MINUTES || interval_minutes > MAX_BACKUP_INTERVAL_MINUTES {
		return api_error(400, "Backup interval must be between " + to_string(MIN_BACKUP_INTERVAL_MINUTES) + " and " + to_string(MAX_BACKUP_INTERVAL_MINUTES) + " minutes")
	}
	if retention_count < 1 || retention_count > 3650 {
		return api_error(400, "Backup retention count must be between 1 and 3650")
	}
	if encryption_enabled && BACKUP_ENCRYPTION_KEY_FILE == "" {
		return api_error(400, "Configure WDG_BACKUP_ENCRYPTION_KEY_FILE before enabling encrypted backups")
	}
	db_execute(db, "UPDATE backup_settings SET enabled = ?, interval_minutes = ?, backup_dir = ?, retention_count = ?, encryption_enabled = ?, updated_at_ms = ? WHERE id = 1", [bool_as_int(enabled), interval_minutes, backup_dir_check["path"], retention_count, bool_as_int(encryption_enabled), current_timestamp()])
	insert_audit_event("backup_settings_update", resolve_audit_actor_key(req, "api"), "success", {"enabled": enabled, "interval_minutes": interval_minutes, "retention_count": retention_count, "encryption_enabled": encryption_enabled})
	return api_ok(backup_status_payload())
})

server := server.route("POST", "/api/admin/backups/run", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}
	result := create_backup_run("manual")
	if !result["ok"] {
		return api_error(500, result["error"])
	}
	return api_ok({"run": result, "status": backup_status_payload()})
})

server := server.route("POST", "/api/admin/backups/delete", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}
	body_parse := parse_json_with_limit(to_string(safe_dict_get(req, "body", "{}")), MAX_PARSE_BODY_BYTES)
	if !body_parse["ok"] || type(body_parse["data"]) != "dict" {
		return api_error(400, "Request body must be a JSON object")
	}
	body := body_parse["data"]
	run_id := to_int_or_zero(safe_dict_get(body, "run_id", 0))
	settings := read_backup_settings()
	backup_path := ""
	checksum_path := ""
	status := "success"
	if run_id > 0 {
		rows := db_query(db, "SELECT id, backup_path, checksum_path, status FROM backup_runs WHERE id = ? LIMIT 1", [run_id])
		if len(rows) == 0 {
			return api_error(404, "Backup run was not found")
		}
		row := rows[0]
		backup_path = to_string(safe_dict_get(row, "backup_path", ""))
		checksum_path = to_string(safe_dict_get(row, "checksum_path", ""))
		status = to_string(safe_dict_get(row, "status", ""))
		if status != "success" || backup_path == "" {
			return api_error(400, "Only completed backup files can be deleted")
		}
	} else {
		backup_path = trim(to_string(safe_dict_get(body, "backup_path", "")))
		if backup_path == "" {
			return api_error(400, "Backup run id or backup path is required")
		}
		backup_name := backup_file_name(backup_path)
		expected_dir := normalize_backup_dir_path(settings["backup_dir"])
		if !backup_generated_file_name(backup_name) {
			return api_error(400, "Only generated backup files can be deleted")
		}
		if !(backup_path == backup_join_path(expected_dir, backup_name)) {
			return api_error(400, "Backup path must belong to the configured backup folder")
		}
		checksum_path = backup_path + ".sha256"
	}
	if !file_exists(backup_path) || path_is_dir(backup_path) {
		return api_error(404, "Backup file is no longer present on disk")
	}
	try {
		delete_file(backup_path)
	} except err {
		message := truncate_str(redact_sensitive_text(to_string(err)), 500)
		insert_audit_event("backup_delete", resolve_audit_actor_key(req, "api"), "failed", {"run_id": run_id, "reason": message})
		return api_error(500, "Could not delete backup file")
	}
	if checksum_path != "" && file_exists(checksum_path) && !path_is_dir(checksum_path) {
		try {
			delete_file(checksum_path)
		} except err {
			message := truncate_str(redact_sensitive_text(to_string(err)), 500)
			insert_audit_event("backup_delete", resolve_audit_actor_key(req, "api"), "failed", {"run_id": run_id, "reason": message, "checksum_path": checksum_path})
			return api_error(500, "Backup file was deleted but the checksum file could not be removed")
		}
	}
	insert_audit_event("backup_delete", resolve_audit_actor_key(req, "api"), "success", {"run_id": run_id, "backup_path": backup_path})
	return api_ok({"deleted_run_id": run_id, "deleted_backup_path": backup_path, "status": backup_status_payload()})
})

server := server.route("POST", "/api/admin/prune", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}

	body_text := to_string(safe_dict_get(req, "body", "{}"))
	body_parse := parse_json_safe(body_text)
	body := {}
	if body_parse["ok"] {
		if type(body_parse["data"]) == "dict" {
			body := body_parse["data"]
		}
	}

	before_ms := 0
	if has_key(body, "before_ms") {
		before_ms := to_int_or_zero(body["before_ms"])
	}
	if before_ms <= 0 {
		before_ms := request_query_int(req, "before_ms", 0, 0, 9223372036854775807)
	}
	if before_ms <= 0 {
		insert_audit_event("prune_operation", resolve_audit_actor_key(req, "api"), "invalid_request", {
			"reason": "before_ms_invalid"
		})
		return api_error(400, "before_ms is required and must be a positive integer")
	}

	dry_run := true
	if has_key(body, "dry_run") {
		dry_run := parse_bool_value(body["dry_run"], true)
	} else {
		dry_run := parse_bool_value(request_query_text(req, "dry_run", "true"), true)
	}

	request_rows := db_query(db, "SELECT COUNT(*) AS n FROM requests WHERE CAST(created_at AS INTEGER) < ?", [before_ms])
	tool_rows := db_query(db, "SELECT COUNT(*) AS n FROM tool_calls WHERE CAST(created_at AS INTEGER) < ?", [before_ms])
	step_rows := db_query(db, "SELECT COUNT(*) AS n FROM agent_steps WHERE CAST(created_at AS INTEGER) < ?", [before_ms])
	trace_rows := db_query(db, "SELECT COUNT(*) AS n FROM traces WHERE started_at_ms < ?", [before_ms])
	span_rows := db_query(db, "SELECT COUNT(*) AS n FROM trace_spans WHERE started_at_ms < ?", [before_ms])
	event_rows := db_query(db, "SELECT COUNT(*) AS n FROM trace_events WHERE occurred_at_ms < ?", [before_ms])
	canonical_prune_filter := "CAST(created_at AS INTEGER) < ? AND NOT EXISTS (SELECT 1 FROM telemetry_export_deliveries pending_delivery WHERE pending_delivery.record_dbid = telemetry_records_v2.id AND pending_delivery.status IN ('pending','retry'))"
	canonical_rows := db_query(db, "SELECT COUNT(*) AS n FROM telemetry_records_v2 WHERE " + canonical_prune_filter, [before_ms])
	export_delivery_rows := db_query(db, "SELECT COUNT(*) AS n FROM telemetry_export_deliveries WHERE status IN ('sent','dead','dropped') AND updated_at_ms < ?", [before_ms])
	dead_letter_rows := db_query(db, "SELECT COUNT(*) AS n FROM telemetry_export_dead_letters WHERE created_at_ms < ?", [before_ms])
	conflict_rows := db_query(db, "SELECT COUNT(*) AS n FROM telemetry_record_conflicts_v2 WHERE CAST(created_at AS INTEGER) < ?", [before_ms])

	counts := {
		"requests": request_rows[0]["n"],
		"tool_calls": tool_rows[0]["n"],
		"agent_steps": step_rows[0]["n"],
		"traces": trace_rows[0]["n"],
		"trace_spans": span_rows[0]["n"],
		"trace_events": event_rows[0]["n"],
		"canonical_records": canonical_rows[0]["n"],
		"export_deliveries": export_delivery_rows[0]["n"],
		"export_dead_letters": dead_letter_rows[0]["n"],
		"record_conflicts": conflict_rows[0]["n"]
	}

	if !dry_run {
		db_execute(db, "DELETE FROM telemetry_record_conflicts_v2 WHERE CAST(created_at AS INTEGER) < ?", [before_ms])
		db_execute(db, "DELETE FROM telemetry_export_dead_letters WHERE created_at_ms < ?", [before_ms])
		db_execute(db, "DELETE FROM telemetry_export_deliveries WHERE status IN ('sent','dead','dropped') AND updated_at_ms < ?", [before_ms])
		db_execute(db, "DELETE FROM telemetry_export_dead_letters WHERE record_dbid IN (SELECT id FROM telemetry_records_v2 WHERE " + canonical_prune_filter + ")", [before_ms])
		db_execute(db, "DELETE FROM telemetry_references_v2 WHERE record_dbid IN (SELECT id FROM telemetry_records_v2 WHERE " + canonical_prune_filter + ")", [before_ms])
		db_execute(db, "DELETE FROM telemetry_export_deliveries WHERE record_dbid IN (SELECT id FROM telemetry_records_v2 WHERE " + canonical_prune_filter + ")", [before_ms])
		db_execute(db, "DELETE FROM telemetry_records_v2 WHERE " + canonical_prune_filter, [before_ms])
		db_execute(db, "DELETE FROM telemetry_batches_v2 WHERE id NOT IN (SELECT DISTINCT batch_dbid FROM telemetry_records_v2)", [])
		db_execute(db, "DELETE FROM trace_events WHERE occurred_at_ms < ?", [before_ms])
		db_execute(db, "DELETE FROM trace_spans WHERE started_at_ms < ?", [before_ms])
		db_execute(db, "DELETE FROM traces WHERE started_at_ms < ?", [before_ms])
		db_execute(db, "DELETE FROM tool_calls WHERE CAST(created_at AS INTEGER) < ?", [before_ms])
		db_execute(db, "DELETE FROM agent_steps WHERE CAST(created_at AS INTEGER) < ?", [before_ms])
		db_execute(db, "DELETE FROM requests WHERE CAST(created_at AS INTEGER) < ?", [before_ms])
	}

	insert_audit_event("prune_operation", resolve_audit_actor_key(req, "api"), "success", {
		"before_ms": before_ms,
		"dry_run": dry_run,
		"affected": counts
	})

	return api_ok({
		"before_ms": before_ms,
		"dry_run": dry_run,
		"affected": counts
	})
})

server := server.route("POST", "/api/admin/prune-fixtures", func(req) {
	auth := require_api_auth(req)
	if !auth["allowed"] {
		return api_error(auth["status"], auth["error"])
	}

	body_parse := parse_json_safe(to_string(safe_dict_get(req, "body", "{}")))
