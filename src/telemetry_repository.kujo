# Canonical Watchdog telemetry repository.
#
# This module owns structural validation and persistence only. Callers must apply
# authoritative privacy/redaction policy before invoking insert_batch.

from telemetry_v2 import watchdog_telemetry_v2_is_hex_id
from telemetry_v2 import watchdog_telemetry_v2_version

func repo_get(value, key, fallback_value) {
	if type(value) != "dict" || has_key(value, key) == 0 {
		return fallback_value
	}
	return value[key]
}

func repo_text(value, max_len) {
	if type(value) == "null" { return "" }
	text := trim(to_string(value))
	if len(text) <= max_len { return text }
	return substring(text, 0, max_len)
}

func repo_nullable_text(value, max_len) {
	if type(value) == "null" { return null }
	text := repo_text(value, max_len)
	if text == "" { return null }
	return text
}

func repo_nullable_json(value) {
	if type(value) == "null" { return null }
	return to_json(value)
}

# RFC 8785-style stable object ordering for the bounded canonical record shape.
# Arrays retain producer order; scalars use the runtime JSON encoder for escaping.
func repo_canonical_json(value) {
	value_type := type(value)
	if value_type == "dict" {
		parts := []
		for key in sort(keys(value)) {
			parts = push(parts, to_json(to_string(key)) + ":" + repo_canonical_json(value[key]))
		}
		return "{" + join(parts, ",") + "}"
	}
	if value_type == "array" {
		parts := []
		for item in value { parts = push(parts, repo_canonical_json(item)) }
		return "[" + join(parts, ",") + "]"
	}
	return to_json(value)
}

func repo_record_hash(record) {
	return sha256(repo_canonical_json(record))
}

func repo_valid_timestamp(value) {
	text := repo_text(value, 80)
	if len(text) < 20 || contains(text, "T") == 0 { return false }
	if ends_with(text, "Z") { return true }
	if contains(substring(text, 10, len(text)), "+") { return true }
	if contains(substring(text, 10, len(text)), "-") { return true }
	return false
}

func repo_valid_status(value) {
	text := repo_text(value, 20)
	return text == "unset" || text == "ok" || text == "error" || text == "cancelled" || text == "timeout" || text == "denied"
}

func repo_valid_kind(value) {
	if type(value) == "null" { return true }
	text := repo_text(value, 40)
	return text == "model" || text == "agent" || text == "tool" || text == "retrieval" || text == "workflow" || text == "handoff" || text == "approval" || text == "execution" || text == "persistence" || text == "evaluation" || text == "internal"
}

func repo_in_enum(value, allowed) {
	for item in allowed { if value == item { return true } }
	return false
}

func repo_has_relation(references, relation) {
	if type(references) != "array" { return false }
	for reference in references {
		if type(reference) == "dict" && repo_text(repo_get(reference, "relation", ""), 40) == relation { return true }
	}
	return false
}

func repo_relation_id(references, relation) {
	if type(references) != "array" { return null }
	for reference in references {
		if type(reference) == "dict" && repo_text(repo_get(reference, "relation", ""), 40) == relation {
			return repo_nullable_text(repo_get(reference, "id", null), 160)
		}
	}
	return null
}

func repo_projection(record, key) {
	attributes := repo_get(record, "attributes", {})
	if type(attributes) == "dict" && has_key(attributes, key) { return attributes[key] }
	return null
}

func repo_semantic_error(record) {
	source := repo_get(record, "source", {})
	profile := repo_text(repo_get(source, "watchdog.semantic_profile", ""), 80)
	if profile == "" { return "" }
	if profile != "watchdog.observability.v1" { return "unsupported watchdog semantic profile" }
	attributes := repo_get(record, "attributes", {})
	references := repo_get(record, "references", [])
	if has_key(attributes, "watchdog.attempt.number") {
		attempt := attributes["watchdog.attempt.number"]
		attempt_number := 0
		try { attempt_number = parse_int(to_string(attempt)) } except err { return "watchdog.attempt.number must be an integer from 1 to 1000000" }
		if attempt_number < 1 || attempt_number > 1000000 { return "watchdog.attempt.number must be an integer from 1 to 1000000" }
	}
	enums := {
		"watchdog.retry.reason_code": ["rate_limit", "timeout", "transport", "provider_error", "invalid_response", "capacity", "policy", "operator", "unknown"],
		"watchdog.retry.decision_source": ["application", "framework", "watchdog", "provider", "operator", "unknown"],
		"watchdog.fallback.dimension": ["provider", "model", "account_route", "region", "strategy", "unknown"],
		"watchdog.fallback.reason_code": ["rate_limit", "timeout", "transport", "provider_error", "invalid_response", "capacity", "policy", "operator", "quality", "unknown"],
		"watchdog.recovery.outcome": ["succeeded", "failed", "partial", "unknown"],
		"watchdog.outcome.code": ["success", "error", "cancelled", "timeout", "denied", "partial", "unknown"],
		"watchdog.timing.source": ["producer_clock", "watchdog_proxy_clock", "provider_reported", "unavailable_buffered_transport", "unknown"],
		"watchdog.first_output.unit": ["token", "content_delta", "byte", "chunk", "unknown"]
	}
	for key in keys(enums) {
		if has_key(attributes, key) && repo_in_enum(attributes[key], enums[key]) == false { return "invalid enum for " + key }
	}
	if has_key(attributes, "watchdog.retry.reason_code") && repo_has_relation(references, "retries") == false { return "retry evidence requires a retries reference" }
	if has_key(attributes, "watchdog.fallback.dimension") && repo_has_relation(references, "fallback_from") == false { return "fallback evidence requires a fallback_from reference" }
	if repo_text(repo_get(record, "name", ""), 160) == "watchdog.operation.recovered" && repo_has_relation(references, "recovers") == false { return "recovery evidence requires a recovers reference" }
	timing_fields := ["watchdog.time_to_first_output_ms", "watchdog.output_generation_duration_ms", "watchdog.output_tokens_per_second"]
	for field in timing_fields {
		if has_key(attributes, field) && type(attributes[field]) != "null" {
			value := 0.0
			try { value = parse_float(to_string(attributes[field])) } except err { return field + " must be a non-negative number or null" }
			if value < 0.0 { return field + " must be a non-negative number or null" }
		}
	}
	if repo_get(attributes, "watchdog.timing.source", "") == "unavailable_buffered_transport" {
		for field in timing_fields { if has_key(attributes, field) && type(attributes[field]) != "null" { return "buffered transport timing metrics must be null" } }
	}
	if has_key(attributes, "watchdog.output_tokens_per_second") && type(attributes["watchdog.output_tokens_per_second"]) != "null" {
		duration := repo_get(attributes, "watchdog.output_generation_duration_ms", null)
		usage := repo_get(record, "usage", null)
		output_tokens := null
		if type(usage) == "dict" { output_tokens = repo_get(usage, "output_tokens", null) }
		if type(duration) == "null" || type(output_tokens) == "null" || parse_float(to_string(duration)) <= 0.0 || parse_float(to_string(output_tokens)) <= 0.0 { return "throughput requires positive output tokens and generation duration" }
	}
	return ""
}

func repo_validate_batch(batch) {
	if type(batch) != "dict" {
		return {"ok": false, "error": "telemetry batch must be an object"}
	}
	if repo_text(repo_get(batch, "schema_version", ""), 80) != watchdog_telemetry_v2_version {
		return {"ok": false, "error": "unsupported canonical telemetry schema_version"}
	}
	batch_id := repo_text(repo_get(batch, "batch_id", ""), 160)
	if batch_id == "" { return {"ok": false, "error": "batch_id is required"} }
	producer := repo_get(batch, "producer", {})
	if type(producer) != "dict" || repo_text(repo_get(producer, "name", ""), 80) == "" {
		return {"ok": false, "error": "producer.name is required"}
	}
	if repo_text(repo_get(producer, "version", ""), 40) == "" || len(keys(producer)) > 5 {
		return {"ok": false, "error": "producer version or shape is invalid"}
	}
	records := repo_get(batch, "records", [])
	if type(records) != "array" || len(records) == 0 || len(records) > 100 {
		return {"ok": false, "error": "records must contain between 1 and 100 items"}
	}
	seen := {}
	for record in records {
		if type(record) != "dict" { return {"ok": false, "error": "each record must be an object"} }
		record_id := repo_text(repo_get(record, "record_id", ""), 160)
		if record_id == "" { return {"ok": false, "error": "record_id is required"} }
		if has_key(seen, record_id) { return {"ok": false, "error": "duplicate record_id in batch: " + record_id} }
		seen[record_id] = true
		record_type := repo_text(repo_get(record, "record_type", ""), 20)
		if record_type != "trace" && record_type != "span" && record_type != "event" {
			return {"ok": false, "error": "invalid record_type for " + record_id}
		}
		trace_id := repo_text(repo_get(record, "trace_id", ""), 32)
		if watchdog_telemetry_v2_is_hex_id(trace_id, 32) == false {
			return {"ok": false, "error": "invalid trace_id for " + record_id}
		}
		span_id := repo_nullable_text(repo_get(record, "span_id", null), 16)
		if record_type == "trace" && type(span_id) != "null" {
			return {"ok": false, "error": "trace records cannot have span_id"}
		}
		if record_type == "span" && type(span_id) == "null" {
			return {"ok": false, "error": "span records require span_id"}
		}
		if type(span_id) != "null" && watchdog_telemetry_v2_is_hex_id(span_id, 16) == false {
			return {"ok": false, "error": "invalid span_id for " + record_id}
		}
		parent_span_id := repo_nullable_text(repo_get(record, "parent_span_id", null), 16)
		if type(parent_span_id) != "null" && watchdog_telemetry_v2_is_hex_id(parent_span_id, 16) == false {
			return {"ok": false, "error": "invalid parent_span_id for " + record_id}
		}
		if type(span_id) != "null" && span_id == parent_span_id {
			return {"ok": false, "error": "span cannot parent itself: " + record_id}
		}
		if repo_valid_timestamp(repo_get(record, "observed_at", "")) == false {
			return {"ok": false, "error": "observed_at must be RFC3339 for " + record_id}
		}
		if type(repo_get(record, "started_at", null)) != "null" && repo_valid_timestamp(record["started_at"]) == false {
			return {"ok": false, "error": "started_at must be RFC3339 for " + record_id}
		}
		if type(repo_get(record, "ended_at", null)) != "null" && repo_valid_timestamp(record["ended_at"]) == false {
			return {"ok": false, "error": "ended_at must be RFC3339 for " + record_id}
		}
		if repo_valid_status(repo_get(record, "status", "unset")) == false || repo_valid_kind(repo_get(record, "kind", null)) == false {
			return {"ok": false, "error": "status or kind is invalid for " + record_id}
		}
		if type(repo_get(record, "source", {})) != "dict" || len(keys(repo_get(record, "source", {}))) > 16 {
			return {"ok": false, "error": "source exceeds bounds for " + record_id}
		}
		if type(repo_get(record, "attributes", {})) != "dict" || len(keys(repo_get(record, "attributes", {}))) > 128 {
			return {"ok": false, "error": "attributes exceeds bounds for " + record_id}
		}
		if type(repo_get(record, "references", [])) != "array" || len(repo_get(record, "references", [])) > 24 {
			return {"ok": false, "error": "references exceeds bounds for " + record_id}
		}
		if type(repo_get(record, "costs", [])) != "array" || len(repo_get(record, "costs", [])) > 8 {
			return {"ok": false, "error": "costs exceeds bounds for " + record_id}
		}
		if type(repo_get(record, "content", [])) != "array" || len(repo_get(record, "content", [])) > 16 {
			return {"ok": false, "error": "content exceeds bounds for " + record_id}
		}
			privacy := repo_get(record, "privacy", {})
		if type(privacy) != "dict" || repo_text(repo_get(privacy, "policy_version", ""), 80) == "" {
				return {"ok": false, "error": "privacy policy is required for " + record_id}
			}
			semantic_error := repo_semantic_error(record)
			if semantic_error != "" { return {"ok": false, "error": semantic_error, "error_code": "invalid_semantics"} }
		}
	return {"ok": true, "error": ""}
}

func repo_content_mode(records) {
	mode := "off"
	for record in records {
		privacy := repo_get(record, "privacy", {})
		next_mode := repo_text(repo_get(privacy, "content_mode", "off"), 20)
		if next_mode != "off" { mode = next_mode }
	}
	return mode
}

func repo_insert_references(db, record_dbid, references) {
	if type(references) != "array" { return }
	count := 0
	for reference in references {
		if count < 24 && type(reference) == "dict" {
			ref_type := repo_text(repo_get(reference, "type", "external"), 40)
			ref_id := repo_text(repo_get(reference, "id", ""), 160)
			if ref_id != "" {
				db_execute(db, "INSERT OR IGNORE INTO telemetry_references_v2 (record_dbid, ref_type, ref_id, namespace, relation) VALUES (?,?,?,?,?)", [record_dbid, ref_type, ref_id, repo_text(repo_get(reference, "namespace", ""), 80), repo_text(repo_get(reference, "relation", ""), 40)])
				count = count + 1
			}
		}
	}
}

func repo_insert_batch_rows(db, batch) {
	producer := batch["producer"]
	producer_name := repo_text(repo_get(producer, "name", "external"), 80)
	batch_id := repo_text(batch["batch_id"], 160)
	records := batch["records"]
	existing := db_query(db, "SELECT id, record_count FROM telemetry_batches_v2 WHERE producer_name = ? AND batch_id = ?", [producer_name, batch_id])
	conflicts := []
	identical := {}
	for record in records {
		record_id := repo_text(record["record_id"], 160)
		incoming_sha256 := repo_record_hash(record)
		prior := db_query(db, "SELECT id, canonical_json, canonical_sha256 FROM telemetry_records_v2 WHERE producer_name = ? AND record_id = ?", [producer_name, record_id])
		if len(prior) > 0 {
			parsed_prior := parse_json(prior[0]["canonical_json"])
			existing_sha256 := repo_text(repo_get(prior[0], "canonical_sha256", ""), 64)
			if existing_sha256 == "" {
				existing_sha256 = repo_record_hash(parsed_prior)
				db_execute(db, "UPDATE telemetry_records_v2 SET canonical_sha256 = ? WHERE id = ? AND (canonical_sha256 IS NULL OR canonical_sha256 = '')", [existing_sha256, prior[0]["id"]])
			}
			if existing_sha256 == incoming_sha256 {
				identical[record_id] = true
			} else {
				conflicts = push(conflicts, {"record_id": record_id, "existing_sha256": existing_sha256, "incoming_sha256": incoming_sha256})
			}
		}
	}
	if len(conflicts) > 0 || (len(existing) > 0 && (existing[0]["record_count"] != len(records) || len(keys(identical)) != len(records))) {
		if len(conflicts) == 0 {
			conflicts = push(conflicts, {"record_id": "batch:" + batch_id, "existing_sha256": sha256("existing:" + to_string(existing[0]["record_count"])), "incoming_sha256": sha256("incoming:" + to_string(len(records)))})
		}
		created_at := to_string(current_timestamp())
		for conflict in conflicts {
			db_execute(db, "INSERT INTO telemetry_record_conflicts_v2 (producer_name, record_id, batch_id, existing_sha256, incoming_sha256, result, created_at) VALUES (?,?,?,?,?,'rejected',?)", [producer_name, conflict["record_id"], batch_id, conflict["existing_sha256"], conflict["incoming_sha256"], created_at])
		}
		return {"ok": false, "error": "record_identity_conflict", "error_code": "record_identity_conflict", "records": 0, "deduplicated": false, "conflicts": len(conflicts)}
	}
	if len(existing) > 0 {
		return {"ok": true, "error": "", "batch_dbid": existing[0]["id"], "records": existing[0]["record_count"], "deduplicated": true}
	}
	if len(keys(identical)) == len(records) {
		return {"ok": true, "error": "", "batch_dbid": 0, "records": 0, "deduplicated": true}
	}

	received_at := to_string(current_timestamp())
	db_execute(db, "INSERT INTO telemetry_batches_v2 (producer_name, batch_id, schema_version, sent_at, received_at, record_count, content_mode) VALUES (?,?,?,?,?,?,?)", [producer_name, batch_id, watchdog_telemetry_v2_version, repo_nullable_text(repo_get(batch, "sent_at", null), 80), received_at, len(records), repo_content_mode(records)])
	batch_rows := db_query(db, "SELECT last_insert_rowid() AS id", [])
	batch_dbid := batch_rows[0]["id"]
	inserted := 0
	for record in records {
		record_id := repo_text(record["record_id"], 160)
		if has_key(identical, record_id) { continue }
		references := repo_get(record, "references", [])
		canonical_json := repo_canonical_json(record)
		source := repo_get(record, "source", {})
		terminal_outcome := null
		if repo_projection(record, "watchdog.outcome.terminal") == true { terminal_outcome = repo_nullable_text(repo_projection(record, "watchdog.outcome.code"), 20) }
		db_execute(db, "INSERT INTO telemetry_records_v2 (batch_dbid, producer_name, record_id, record_type, trace_id, span_id, parent_span_id, observed_at, started_at, ended_at, kind, name, status, source_json, references_json, attributes_json, usage_json, costs_json, error_json, content_json, privacy_json, canonical_json, canonical_sha256, logical_request_id, attempt_number, retry_of_request_id, terminal_outcome, time_to_first_output_ms, output_generation_duration_ms, output_tokens_per_second, application_name, harness_name, instrumentation_name, instrumentation_version, created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)", [batch_dbid, producer_name, record_id, repo_text(record["record_type"], 20), repo_text(record["trace_id"], 32), repo_nullable_text(repo_get(record, "span_id", null), 16), repo_nullable_text(repo_get(record, "parent_span_id", null), 16), repo_text(record["observed_at"], 80), repo_nullable_text(repo_get(record, "started_at", null), 80), repo_nullable_text(repo_get(record, "ended_at", null), 80), repo_nullable_text(repo_get(record, "kind", null), 40), repo_nullable_text(repo_get(record, "name", null), 160), repo_text(repo_get(record, "status", "unset"), 20), to_json(source), to_json(references), to_json(repo_get(record, "attributes", {})), repo_nullable_json(repo_get(record, "usage", null)), to_json(repo_get(record, "costs", [])), repo_nullable_json(repo_get(record, "error", null)), to_json(repo_get(record, "content", [])), to_json(repo_get(record, "privacy", {})), canonical_json, repo_record_hash(record), repo_nullable_text(repo_projection(record, "watchdog.logical_request_id"), 160), repo_projection(record, "watchdog.attempt.number"), repo_relation_id(references, "retries"), terminal_outcome, repo_projection(record, "watchdog.time_to_first_output_ms"), repo_projection(record, "watchdog.output_generation_duration_ms"), repo_projection(record, "watchdog.output_tokens_per_second"), repo_nullable_text(repo_get(source, "application.name", null), 80), repo_nullable_text(repo_get(source, "harness.name", null), 80), repo_nullable_text(repo_get(source, "instrumentation.name", null), 80), repo_nullable_text(repo_get(source, "instrumentation.version", null), 40), received_at])
		rows := db_query(db, "SELECT id FROM telemetry_records_v2 WHERE producer_name = ? AND record_id = ?", [producer_name, record_id])
		if len(rows) > 0 {
			record_dbid := rows[0]["id"]
			db_execute(db, "DELETE FROM telemetry_references_v2 WHERE record_dbid = ?", [record_dbid])
			repo_insert_references(db, record_dbid, references)
		}
		inserted = inserted + 1
	}
	return {"ok": true, "error": "", "batch_dbid": batch_dbid, "records": inserted, "deduplicated": false}
}

func repo_insert_batch(db, batch) {
	validation := repo_validate_batch(batch)
	if validation["ok"] == false { return validation }
	db_execute(db, "BEGIN IMMEDIATE", [])
	try {
		result := repo_insert_batch_rows(db, batch)
		db_execute(db, "COMMIT", [])
		return result
	} except err {
		try { db_execute(db, "ROLLBACK", []) } except rollback_err {}
		throw(err)
	}
}

func repo_insert_batch_fast(db, batch) {
	validation := repo_validate_batch(batch)
	if validation["ok"] == false { return validation }
	if len(batch["records"]) != 1 { return {"ok": false, "error": "fast repository path requires exactly one record"} }
	return repo_insert_batch_rows(db, batch)
}

export watchdog_telemetry_repository_validate := repo_validate_batch
export watchdog_telemetry_repository_insert := repo_insert_batch
export watchdog_telemetry_repository_insert_fast := repo_insert_batch_fast
export watchdog_telemetry_repository_canonical_json := repo_canonical_json
export watchdog_telemetry_repository_record_hash := repo_record_hash
