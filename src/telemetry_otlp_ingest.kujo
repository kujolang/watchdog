# Guarded AI-relevant OTLP/HTTP JSON -> canonical Watchdog mapper.

from telemetry_v2 import watchdog_telemetry_v2_is_hex_id
from telemetry_v2 import watchdog_telemetry_v2_timestamp

func ingest_get(value, key, fallback_value) {
	if type(value) == "dict" {
		if has_key(value, key) { return value[key] }
	}
	return fallback_value
}

func ingest_text(value, max_len) {
	if type(value) == "null" { return "" }
	text := trim(to_string(value))
	if len(text) <= max_len { return text }
	return substring(text, 0, max_len)
}

func ingest_any_value_policy(value, depth) {
	if depth > 8 || type(value) != "dict" { return {"value": null, "content_dropped": false} }
	if has_key(value, "stringValue") { return {"value": ingest_text(value["stringValue"], 4096), "content_dropped": false} }
	if has_key(value, "intValue") {
		try { return {"value": parse_int(to_string(value["intValue"])), "content_dropped": false} } except err { return {"value": ingest_text(value["intValue"], 160), "content_dropped": false} }
	}
	if has_key(value, "doubleValue") { return {"value": value["doubleValue"], "content_dropped": false} }
	if has_key(value, "boolValue") { return {"value": value["boolValue"], "content_dropped": false} }
	if has_key(value, "bytesValue") { return {"value": {"$watchdog.bytes_base64": ingest_text(value["bytesValue"], 65536)}, "content_dropped": false} }
	if has_key(value, "arrayValue") {
		array_values := []
		content_dropped := false
		array_value := value["arrayValue"]
		if type(array_value) == "dict" {
			items := ingest_get(array_value, "values", [])
			if type(items) == "array" {
				item_count := 0
				for item in items {
					if item_count < 128 {
						mapped := ingest_any_value_policy(item, depth + 1)
						if type(mapped["value"]) != "null" { array_values = push(array_values, mapped["value"]) }
						if mapped["content_dropped"] { content_dropped = true }
					}
					item_count = item_count + 1
				}
			}
		}
		return {"value": array_values, "content_dropped": content_dropped}
	}
	if has_key(value, "kvlistValue") {
		kv_values := []
		content_dropped := false
		kvlist_value := value["kvlistValue"]
		if type(kvlist_value) == "dict" {
			items := ingest_get(kvlist_value, "values", [])
			if type(items) == "array" {
				item_count := 0
				for item in items {
					if item_count < 128 && type(item) == "dict" {
						key := ingest_text(ingest_get(item, "key", ""), 160)
						if key != "" {
							if ingest_content_key(key) { content_dropped = true } else {
								mapped := ingest_any_value_policy(ingest_get(item, "value", {}), depth + 1)
								if type(mapped["value"]) != "null" { kv_values = push(kv_values, {"key": key, "value": mapped["value"]}) }
								if mapped["content_dropped"] { content_dropped = true }
							}
						}
					}
					item_count = item_count + 1
				}
			}
		}
		return {"value": {"$watchdog.kvlist": kv_values}, "content_dropped": content_dropped}
	}
	return {"value": null, "content_dropped": false}
}

func ingest_content_key(key) {
	text := to_lower(to_string(key))
	if contains(text, "input.value") || contains(text, "output.value") || contains(text, "prompt") || contains(text, "completion") || contains(text, "tool.arguments") || contains(text, "tool.result") || contains(text, "retrieval.documents") { return true }
	return false
}

func ingest_attributes(raw_attributes) {
	attributes := {}
	content_dropped := false
	if type(raw_attributes) != "array" { return {"attributes": attributes, "content_dropped": false} }
	for attribute in raw_attributes {
		if len(keys(attributes)) < 128 && type(attribute) == "dict" {
			key := ingest_text(ingest_get(attribute, "key", ""), 160)
			if key != "" {
				if ingest_content_key(key) { content_dropped = true } else {
					mapped := ingest_any_value_policy(ingest_get(attribute, "value", {}), 0)
					if type(mapped["value"]) != "null" { attributes[key] = mapped["value"] }
					if mapped["content_dropped"] { content_dropped = true }
				}
			}
		}
	}
	return {"attributes": attributes, "content_dropped": content_dropped}
}

func ingest_ai_relevant(attributes) {
	for key in keys(attributes) {
		key_text := to_lower(to_string(key))
		if starts_with(key_text, "gen_ai.") || starts_with(key_text, "openinference.") || starts_with(key_text, "watchdog.") { return true }
		if key_text == "rpc.system" && to_lower(to_string(attributes[key])) == "mcp" { return true }
	}
	return false
}

func ingest_kind(attributes) {
	oi_kind := to_upper(to_string(ingest_get(attributes, "openinference.span.kind", "")))
	if oi_kind == "LLM" { return "model" }
	if oi_kind == "AGENT" { return "agent" }
	if oi_kind == "TOOL" { return "tool" }
	if oi_kind == "RETRIEVER" { return "retrieval" }
	if oi_kind == "EVALUATOR" { return "evaluation" }
	if oi_kind == "CHAIN" { return "workflow" }
	if has_key(attributes, "gen_ai.operation.name") || has_key(attributes, "gen_ai.request.model") || has_key(attributes, "gen_ai.response.model") { return "model" }
	if has_key(attributes, "gen_ai.tool.name") || (has_key(attributes, "rpc.system") && to_lower(to_string(attributes["rpc.system"])) == "mcp") { return "tool" }
	if has_key(attributes, "watchdog.span.kind") { return ingest_text(attributes["watchdog.span.kind"], 40) }
	return "internal"
}

func ingest_status(status) {
	if type(status) != "dict" { return "unset" }
	code := ingest_get(status, "code", 0)
	if to_string(code) == "2" || to_upper(to_string(code)) == "STATUS_CODE_ERROR" { return "error" }
	if to_string(code) == "1" || to_upper(to_string(code)) == "STATUS_CODE_OK" { return "ok" }
	return "unset"
}

func ingest_nano_timestamp(value) {
	try {
		nanos := parse_int(to_string(value))
		return watchdog_telemetry_v2_timestamp(nanos / 1000000, current_timestamp())
	} except err { return watchdog_telemetry_v2_timestamp(current_timestamp(), current_timestamp()) }
}

func ingest_usage(attributes) {
	input_tokens := ingest_get(attributes, "gen_ai.usage.input_tokens", ingest_get(attributes, "llm.token_count.prompt", null))
	output_tokens := ingest_get(attributes, "gen_ai.usage.output_tokens", ingest_get(attributes, "llm.token_count.completion", null))
	total_tokens := ingest_get(attributes, "watchdog.usage.total_tokens", ingest_get(attributes, "llm.token_count.total", null))
	return {
		"input_tokens": input_tokens,
		"output_tokens": output_tokens,
		"total_tokens": total_tokens,
		"cached_input_tokens": ingest_get(attributes, "watchdog.usage.cached_input_tokens", null),
		"cache_write_input_tokens": ingest_get(attributes, "watchdog.usage.cache_write_input_tokens", null),
		"reasoning_tokens": ingest_get(attributes, "watchdog.usage.reasoning_tokens", null),
		"usage_source": "otlp",
		"total_semantics": "source_preserved",
		"provider_usage": {"gen_ai.usage.input_tokens": ingest_get(attributes, "gen_ai.usage.input_tokens", null), "gen_ai.usage.output_tokens": ingest_get(attributes, "gen_ai.usage.output_tokens", null), "llm.token_count.prompt": ingest_get(attributes, "llm.token_count.prompt", null), "llm.token_count.completion": ingest_get(attributes, "llm.token_count.completion", null), "llm.token_count.total": ingest_get(attributes, "llm.token_count.total", null)}
	}
}

func ingest_references(attributes, service_name) {
	references := []
	ref_fields := {"session": ["gen_ai.conversation.id", "session.id", "watchdog.session.id"], "run": ["watchdog.run.id"], "turn": ["watchdog.turn.id"], "tool_call": ["gen_ai.tool.call.id", "watchdog.tool_call.id"]}
	for ref_type in keys(ref_fields) {
		for field in ref_fields[ref_type] {
			if has_key(attributes, field) && ingest_text(attributes[field], 160) != "" {
				references = push(references, {"type": ref_type, "id": ingest_text(attributes[field], 160), "namespace": service_name, "relation": "groups"})
				break
			}
		}
	}
	return references
}

func ingest_resource_source(resource) {
	parsed := ingest_attributes(ingest_get(resource, "attributes", []))
	attributes := parsed["attributes"]
	service_name := "otlp-producer"
	if has_key(attributes, "service.name") { service_name = ingest_text(attributes["service.name"], 80) }
	source := {"watchdog.semantic_profile": "watchdog.observability.v1", "application.name": service_name}
	allowlist := {"service.version": "application.version", "process.runtime.name": "runtime.name", "process.runtime.version": "runtime.version"}
	for key in keys(allowlist) {
		if has_key(attributes, key) {
			value := ingest_text(attributes[key], 80)
			if value != "" { source[allowlist[key]] = value }
		}
	}
	return source
}

func ingest_map_span(span, resource_source, scope_name, scope_version, ordinal) {
	service_name := ingest_text(ingest_get(resource_source, "application.name", "otlp-producer"), 80)
	record_source_base := parse_json(to_json(resource_source))
	parsed_attributes := ingest_attributes(ingest_get(span, "attributes", []))
	attributes := parsed_attributes["attributes"]
	if ingest_ai_relevant(attributes) == false { return {"ok": false, "error": "span is not AI-relevant", "records": []} }
	trace_id := to_lower(ingest_text(ingest_get(span, "traceId", ""), 32))
	span_id := to_lower(ingest_text(ingest_get(span, "spanId", ""), 16))
	if watchdog_telemetry_v2_is_hex_id(trace_id, 32) == false || watchdog_telemetry_v2_is_hex_id(span_id, 16) == false { return {"ok": false, "error": "invalid OTLP trace/span ID", "records": []} }
	parent_span_id := to_lower(ingest_text(ingest_get(span, "parentSpanId", ""), 16))
	if parent_span_id == "" { parent_span_id = null }
	if type(parent_span_id) != "null" && watchdog_telemetry_v2_is_hex_id(parent_span_id, 16) == false { return {"ok": false, "error": "invalid OTLP parent span ID", "records": []} }
	transformations := []
	if parsed_attributes["content_dropped"] { transformations = push(transformations, "source_content_dropped_by_watchdog_policy") }
	record := {
		"record_id": "otlp:span:" + trace_id + ":" + span_id,
		"record_type": "span",
		"trace_id": trace_id,
		"span_id": span_id,
		"parent_span_id": parent_span_id,
		"observed_at": watchdog_telemetry_v2_timestamp(current_timestamp(), current_timestamp()),
		"started_at": ingest_nano_timestamp(ingest_get(span, "startTimeUnixNano", "0")),
		"ended_at": ingest_nano_timestamp(ingest_get(span, "endTimeUnixNano", ingest_get(span, "startTimeUnixNano", "0"))),
		"kind": ingest_kind(attributes),
		"name": ingest_text(ingest_get(span, "name", "otlp.span"), 160),
		"status": ingest_status(ingest_get(span, "status", {})),
		"source": record_source_base,
		"references": ingest_references(attributes, service_name),
		"attributes": attributes,
		"usage": ingest_usage(attributes),
		"costs": [],
		"error": null,
		"content": [],
		"privacy": {"content_mode": "off", "policy_version": "watchdog.privacy.v1", "transformations": transformations}
	}
	record_source := record["source"]
	record_source["producer"] = service_name
	record_source["adapter_id"] = "watchdog.otlp-json-ingest"
	record_source["adapter_version"] = "watchdog.ingestion-adapter.v1"
	record_source["original_schema"] = "otlp-json"
	record_source["instrumentation.name"] = scope_name
	if scope_version != "" { record_source["instrumentation.version"] = scope_version }
	record["source"] = record_source
	span_records := [record]
	events := ingest_get(span, "events", [])
	if type(events) == "array" {
		event_occurrences := {}
		for event in events {
			if len(span_records) < 16 && type(event) == "dict" {
				event_attrs := ingest_attributes(ingest_get(event, "attributes", []))
				event_time := ingest_text(ingest_get(event, "timeUnixNano", ingest_get(span, "endTimeUnixNano", "0")), 40)
				event_name := ingest_text(ingest_get(event, "name", "event"), 160)
				duplicate_key := event_time + ":" + event_name
				occurrence := 0
				if has_key(event_occurrences, duplicate_key) { occurrence = event_occurrences[duplicate_key] }
				event_occurrences[duplicate_key] = occurrence + 1
				event_digest := substring(sha256(service_name + ":" + trace_id + ":" + span_id + ":" + event_time + ":" + event_name + ":" + to_string(occurrence)), 0, 32)
				event_source := parse_json(to_json(record_source))
				span_records = push(span_records, {"record_id": "otlp:event:" + event_digest, "record_type": "event", "trace_id": trace_id, "span_id": span_id, "parent_span_id": null, "observed_at": ingest_nano_timestamp(event_time), "started_at": null, "ended_at": null, "kind": null, "name": event_name, "status": "unset", "source": event_source, "references": [], "attributes": event_attrs["attributes"], "usage": null, "costs": [], "error": null, "content": [], "privacy": {"content_mode": "off", "policy_version": "watchdog.privacy.v1", "transformations": []}})
			}
		}
	}
	return {"ok": true, "error": "", "records": span_records}
}

func ingest_map(payload) {
	resource_spans := ingest_get(payload, "resourceSpans", [])
	if type(resource_spans) != "array" { return {"ok": false, "error": "resourceSpans must be an array", "records": [], "rejected": 0, "producer": ""} }
	records := []
	rejected := 0
	producer := "otlp-producer"
	ordinal := 0
	for resource_span in resource_spans {
		if type(resource_span) == "dict" {
			resource_source := ingest_resource_source(ingest_get(resource_span, "resource", {}))
			service_name := ingest_text(ingest_get(resource_source, "application.name", "otlp-producer"), 80)
			if producer == "otlp-producer" { producer = service_name }
			scope_spans := ingest_get(resource_span, "scopeSpans", [])
			if type(scope_spans) == "array" {
				for scope_span in scope_spans {
					scope := ingest_get(scope_span, "scope", {})
					scope_name := ingest_text(ingest_get(scope, "name", "unknown"), 80)
					scope_version := ingest_text(ingest_get(scope, "version", ""), 40)
					spans := ingest_get(scope_span, "spans", [])
					if type(spans) == "array" {
						for span in spans {
							if len(records) < 100 {
								mapped := ingest_map_span(span, resource_source, scope_name, scope_version, ordinal)
								if mapped["ok"] == true {
									mapped_records := mapped["records"]
									for mapped_record in mapped_records { if len(records) < 100 { records = push(records, mapped_record) } }
								}
								if mapped["ok"] == false { rejected = rejected + 1 }
								ordinal = ordinal + 1
							} else { rejected = rejected + 1 }
						}
					}
				}
			}
		}
	}
	if len(records) == 0 { return {"ok": false, "error": "no AI-relevant OTLP spans accepted", "records": [], "rejected": rejected, "producer": producer} }
	return {"ok": true, "error": "", "records": records, "rejected": rejected, "producer": producer}
}

export watchdog_otlp_ingest_map := ingest_map
