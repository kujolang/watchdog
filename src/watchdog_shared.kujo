# Shared helpers for Watchdog modules.
# Compatibility entrypoint mirrored from src/watchdog_shared.kujo.

func cost_per_million(model) {
	table := {
		"gpt-4.1": {"input": 2.00, "output": 8.00},
		"gpt-4.1-mini": {"input": 0.40, "output": 1.60},
		"gpt-4.1-nano": {"input": 0.10, "output": 0.40},
		"gpt-4o": {"input": 2.50, "output": 10.00},
		"gpt-4o-mini": {"input": 0.15, "output": 0.60},
		"gpt-3.5-turbo": {"input": 0.50, "output": 1.50},
		"deepseek-chat": {"input": 0.07, "output": 1.10},
		"deepseek-reasoner": {"input": 0.55, "output": 2.19},
		"openai/gpt-4.1-mini": {"input": 0.40, "output": 1.60},
		"glm-5.2": {"input": 1.40, "output": 4.40},
		"glm-5.2:cloud": {"input": 1.40, "output": 4.40},
		"kimi-k2.7-code": {"input": 0.95, "output": 4.00},
		"kimi-k2.7-code:cloud": {"input": 0.95, "output": 4.00},
		"minimax-m3": {"input": 0.30, "output": 1.20},
		"minimax-m3:cloud": {"input": 0.30, "output": 1.20},
		"qwen3.5": {"input": 0.60, "output": 3.60},
		"qwen3.5:397b": {"input": 0.60, "output": 3.60},
		"qwen3.5:397b-cloud": {"input": 0.60, "output": 3.60},
		"qwen3.5-397b-a17b": {"input": 0.60, "output": 3.60}
	}

	model_key := to_lower(trim(to_string(model)))
	if has_key(table, model_key) {
		return table[model_key]
	}

	return {"input": 1.00, "output": 3.00}
}

func has_known_pricing(model) {
	known_models := [
		"gpt-4.1", "gpt-4.1-mini", "gpt-4.1-nano", "gpt-4o", "gpt-4o-mini", "gpt-3.5-turbo",
		"deepseek-chat", "deepseek-reasoner", "openai/gpt-4.1-mini",
		"glm-5.2", "glm-5.2:cloud", "kimi-k2.7-code", "kimi-k2.7-code:cloud",
		"minimax-m3", "minimax-m3:cloud", "qwen3.5", "qwen3.5:397b", "qwen3.5:397b-cloud", "qwen3.5-397b-a17b"
	]
	model_key := to_lower(trim(to_string(model)))
	for known_model in known_models {
		if model_key == known_model {
			return true
		}
	}
	return false
}

func estimate_cost(model, input_tokens, output_tokens) {
	rates := cost_per_million(model)
	input_cost := (input_tokens / 1000000.0) * rates["input"]
	output_cost := (output_tokens / 1000000.0) * rates["output"]
	return input_cost + output_cost
}

func ensure_schema(db) {
	db_execute(db, "CREATE TABLE IF NOT EXISTS schema_migrations (key TEXT PRIMARY KEY, applied_at TEXT NOT NULL DEFAULT '')", [])

	db_execute(db, "CREATE TABLE IF NOT EXISTS requests (id INTEGER PRIMARY KEY AUTOINCREMENT, session_id TEXT NOT NULL DEFAULT '', user_id TEXT NOT NULL DEFAULT '', tenant_id TEXT NOT NULL DEFAULT '', project_id TEXT NOT NULL DEFAULT '', workflow_id TEXT NOT NULL DEFAULT '', task_id TEXT NOT NULL DEFAULT '', correlation_id TEXT NOT NULL DEFAULT '', provider TEXT NOT NULL DEFAULT '', model TEXT NOT NULL DEFAULT '', request_id TEXT NOT NULL DEFAULT '', status TEXT NOT NULL DEFAULT 'success', input_tokens INTEGER NOT NULL DEFAULT 0, output_tokens INTEGER NOT NULL DEFAULT 0, total_tokens INTEGER NOT NULL DEFAULT 0, cost_usd REAL NOT NULL DEFAULT 0.0, latency_ms INTEGER NOT NULL DEFAULT 0, finish_reason TEXT NOT NULL DEFAULT '', error_code TEXT NOT NULL DEFAULT '', error_message TEXT NOT NULL DEFAULT '', prompt_summary TEXT NOT NULL DEFAULT '', response_summary TEXT NOT NULL DEFAULT '', source_app TEXT NOT NULL DEFAULT 'legacy', data_class TEXT NOT NULL DEFAULT 'legacy', created_at TEXT NOT NULL DEFAULT '')", [])

	db_execute(db, "CREATE TABLE IF NOT EXISTS tool_calls (id INTEGER PRIMARY KEY AUTOINCREMENT, request_dbid INTEGER NOT NULL DEFAULT 0, session_id TEXT NOT NULL DEFAULT '', tool_name TEXT NOT NULL DEFAULT '', tool_args TEXT NOT NULL DEFAULT '{}', tool_result TEXT NOT NULL DEFAULT '', status TEXT NOT NULL DEFAULT 'success', latency_ms INTEGER NOT NULL DEFAULT 0, source_app TEXT NOT NULL DEFAULT 'legacy', data_class TEXT NOT NULL DEFAULT 'legacy', created_at TEXT NOT NULL DEFAULT '')", [])

	db_execute(db, "CREATE TABLE IF NOT EXISTS agent_steps (id INTEGER PRIMARY KEY AUTOINCREMENT, session_id TEXT NOT NULL DEFAULT '', agent_id TEXT NOT NULL DEFAULT '', step_number INTEGER NOT NULL DEFAULT 0, step_type TEXT NOT NULL DEFAULT '', content TEXT NOT NULL DEFAULT '', metadata TEXT NOT NULL DEFAULT '{}', source_app TEXT NOT NULL DEFAULT 'legacy', data_class TEXT NOT NULL DEFAULT 'legacy', created_at TEXT NOT NULL DEFAULT '')", [])

	db_execute(db, "CREATE TABLE IF NOT EXISTS audit_events (id INTEGER PRIMARY KEY AUTOINCREMENT, action TEXT NOT NULL DEFAULT '', actor_key TEXT NOT NULL DEFAULT '', result TEXT NOT NULL DEFAULT '', metadata TEXT NOT NULL DEFAULT '{}', created_at TEXT NOT NULL DEFAULT '')", [])

	db_execute(db, "CREATE TABLE IF NOT EXISTS traces (id INTEGER PRIMARY KEY AUTOINCREMENT, trace_id TEXT NOT NULL UNIQUE, request_dbid INTEGER NOT NULL DEFAULT 0, session_id TEXT NOT NULL DEFAULT '', source_app TEXT NOT NULL DEFAULT 'legacy', data_class TEXT NOT NULL DEFAULT 'legacy', name TEXT NOT NULL DEFAULT '', status TEXT NOT NULL DEFAULT 'success', started_at_ms INTEGER NOT NULL DEFAULT 0, ended_at_ms INTEGER NOT NULL DEFAULT 0, duration_ms INTEGER NOT NULL DEFAULT 0, input_tokens INTEGER NOT NULL DEFAULT 0, output_tokens INTEGER NOT NULL DEFAULT 0, cached_input_tokens INTEGER NOT NULL DEFAULT 0, cache_write_input_tokens INTEGER NOT NULL DEFAULT 0, input_cost_usd REAL NOT NULL DEFAULT 0.0, output_cost_usd REAL NOT NULL DEFAULT 0.0, input_rate_per_million REAL NOT NULL DEFAULT 0.0, output_rate_per_million REAL NOT NULL DEFAULT 0.0, pricing_source TEXT NOT NULL DEFAULT '', attributes_json TEXT NOT NULL DEFAULT '{}', created_at TEXT NOT NULL DEFAULT '')", [])

	db_execute(db, "CREATE TABLE IF NOT EXISTS trace_spans (id INTEGER PRIMARY KEY AUTOINCREMENT, trace_id TEXT NOT NULL DEFAULT '', span_id TEXT NOT NULL DEFAULT '', parent_span_id TEXT NOT NULL DEFAULT '', request_dbid INTEGER NOT NULL DEFAULT 0, session_id TEXT NOT NULL DEFAULT '', source_app TEXT NOT NULL DEFAULT 'legacy', data_class TEXT NOT NULL DEFAULT 'legacy', span_kind TEXT NOT NULL DEFAULT 'internal', name TEXT NOT NULL DEFAULT '', status TEXT NOT NULL DEFAULT 'success', started_at_ms INTEGER NOT NULL DEFAULT 0, ended_at_ms INTEGER NOT NULL DEFAULT 0, duration_ms INTEGER NOT NULL DEFAULT 0, attributes_json TEXT NOT NULL DEFAULT '{}', created_at TEXT NOT NULL DEFAULT '', UNIQUE(trace_id, span_id))", [])

	db_execute(db, "CREATE TABLE IF NOT EXISTS trace_events (id INTEGER PRIMARY KEY AUTOINCREMENT, event_id TEXT NOT NULL DEFAULT '', trace_id TEXT NOT NULL DEFAULT '', span_id TEXT NOT NULL DEFAULT '', sequence INTEGER NOT NULL DEFAULT 0, event_name TEXT NOT NULL DEFAULT '', occurred_at_ms INTEGER NOT NULL DEFAULT 0, attributes_json TEXT NOT NULL DEFAULT '{}', source_app TEXT NOT NULL DEFAULT 'legacy', data_class TEXT NOT NULL DEFAULT 'legacy', created_at TEXT NOT NULL DEFAULT '', UNIQUE(trace_id, event_id))", [])
	db_execute(db, "CREATE TABLE IF NOT EXISTS rate_limit_buckets (bucket_key TEXT PRIMARY KEY, window_start_ms INTEGER NOT NULL DEFAULT 0, request_count INTEGER NOT NULL DEFAULT 0, last_seen_ms INTEGER NOT NULL DEFAULT 0)", [])

	try {
		db_execute(db, "ALTER TABLE requests ADD COLUMN workflow_id TEXT NOT NULL DEFAULT ''", [])
	} except err {
	}

	try {
		db_execute(db, "ALTER TABLE requests ADD COLUMN tenant_id TEXT NOT NULL DEFAULT ''", [])
	} except err {
	}

	try {
		db_execute(db, "ALTER TABLE requests ADD COLUMN project_id TEXT NOT NULL DEFAULT ''", [])
	} except err {
	}

	try {
		db_execute(db, "ALTER TABLE requests ADD COLUMN task_id TEXT NOT NULL DEFAULT ''", [])
	} except err {
	}

	try {
		db_execute(db, "ALTER TABLE requests ADD COLUMN correlation_id TEXT NOT NULL DEFAULT ''", [])
	} except err {
	}

	try {
		db_execute(db, "ALTER TABLE requests ADD COLUMN source_app TEXT NOT NULL DEFAULT 'legacy'", [])
	} except err {
	}

	try {
		db_execute(db, "ALTER TABLE requests ADD COLUMN data_class TEXT NOT NULL DEFAULT 'legacy'", [])
	} except err {
	}

	try {
		db_execute(db, "ALTER TABLE tool_calls ADD COLUMN source_app TEXT NOT NULL DEFAULT 'legacy'", [])
	} except err {
	}

	try {
		db_execute(db, "ALTER TABLE tool_calls ADD COLUMN data_class TEXT NOT NULL DEFAULT 'legacy'", [])
	} except err {
	}

	try {
		db_execute(db, "ALTER TABLE agent_steps ADD COLUMN source_app TEXT NOT NULL DEFAULT 'legacy'", [])
	} except err {
	}

	try {
		db_execute(db, "ALTER TABLE agent_steps ADD COLUMN data_class TEXT NOT NULL DEFAULT 'legacy'", [])
	} except err {
	}

	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_requests_created_at ON requests(created_at)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_requests_created_at_ms ON requests(CAST(created_at AS INTEGER))", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_requests_session_id ON requests(session_id)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_requests_status ON requests(status)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_requests_provider_model ON requests(provider, model)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_requests_tenant_id ON requests(tenant_id)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_requests_project_id ON requests(project_id)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_requests_workflow_id ON requests(workflow_id)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_requests_task_id ON requests(task_id)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_requests_correlation_id ON requests(correlation_id)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_requests_source_class ON requests(source_app, data_class)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_tool_calls_created_at ON tool_calls(created_at)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_tool_calls_created_at_ms ON tool_calls(CAST(created_at AS INTEGER))", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_tool_calls_session_id ON tool_calls(session_id)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_tool_calls_source_class ON tool_calls(source_app, data_class)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_agent_steps_session_step ON agent_steps(session_id, step_number)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_agent_steps_created_at ON agent_steps(created_at)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_agent_steps_created_at_ms ON agent_steps(CAST(created_at AS INTEGER))", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_agent_steps_source_class ON agent_steps(source_app, data_class)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_audit_events_created_at ON audit_events(created_at)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_audit_events_created_at_ms ON audit_events(CAST(created_at AS INTEGER))", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_audit_events_action_result ON audit_events(action, result)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_traces_started_at ON traces(started_at_ms)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_traces_session_id ON traces(session_id)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_traces_source_status ON traces(source_app, status)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_trace_spans_trace_start ON trace_spans(trace_id, started_at_ms)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_trace_spans_kind_status ON trace_spans(span_kind, status)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_trace_events_trace_sequence ON trace_events(trace_id, sequence)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_trace_events_name_time ON trace_events(event_name, occurred_at_ms)", [])
	db_execute(db, "CREATE INDEX IF NOT EXISTS idx_rate_limit_buckets_last_seen ON rate_limit_buckets(last_seen_ms)", [])

	db_execute(db, "INSERT OR IGNORE INTO schema_migrations (key, applied_at) VALUES (?, ?)", ["0001_base_schema", to_string(current_timestamp())])
	db_execute(db, "INSERT OR IGNORE INTO schema_migrations (key, applied_at) VALUES (?, ?)", ["0002_kennel_correlation_fields", to_string(current_timestamp())])
	db_execute(db, "INSERT OR IGNORE INTO schema_migrations (key, applied_at) VALUES (?, ?)", ["0003_tenant_project_fields", to_string(current_timestamp())])
	db_execute(db, "INSERT OR IGNORE INTO schema_migrations (key, applied_at) VALUES (?, ?)", ["0004_audit_events", to_string(current_timestamp())])
	db_execute(db, "INSERT OR IGNORE INTO schema_migrations (key, applied_at) VALUES (?, ?)", ["0005_time_filter_indexes", to_string(current_timestamp())])
	db_execute(db, "INSERT OR IGNORE INTO schema_migrations (key, applied_at) VALUES (?, ?)", ["0006_source_classification", to_string(current_timestamp())])
	db_execute(db, "INSERT OR IGNORE INTO schema_migrations (key, applied_at) VALUES (?, ?)", ["0009_granular_trace_spans_events", to_string(current_timestamp())])
	db_execute(db, "INSERT OR IGNORE INTO schema_migrations (key, applied_at) VALUES (?, ?)", ["0010_sqlite_rate_limit_buckets", to_string(current_timestamp())])

	pricing_migration := db_query(db, "SELECT key FROM schema_migrations WHERE key = ? LIMIT 1", ["0007_direct_api_cost_estimates"])
	if len(pricing_migration) == 0 {
		zero_cost_rows := db_query(db, "SELECT id, model, input_tokens, output_tokens FROM requests WHERE cost_usd = 0 AND (input_tokens > 0 OR output_tokens > 0)", [])
		for row in zero_cost_rows {
			if has_known_pricing(row["model"]) {
				estimated_cost := estimate_cost(row["model"], row["input_tokens"] * 1.0, row["output_tokens"] * 1.0)
				db_execute(db, "UPDATE requests SET cost_usd = ? WHERE id = ? AND cost_usd = 0", [estimated_cost, row["id"]])
			}
		}
		db_execute(db, "INSERT INTO schema_migrations (key, applied_at) VALUES (?, ?)", ["0007_direct_api_cost_estimates", to_string(current_timestamp())])
	}

	ai_chat_pricing_migration := db_query(db, "SELECT key FROM schema_migrations WHERE key = ? LIMIT 1", ["0008_ai_chat_direct_api_reprice"])
	if len(ai_chat_pricing_migration) == 0 {
		ai_chat_rows := db_query(db, "SELECT id, model, input_tokens, output_tokens FROM requests WHERE source_app = 'ai-chat' AND (input_tokens > 0 OR output_tokens > 0)", [])
		for row in ai_chat_rows {
			if has_known_pricing(row["model"]) {
				estimated_cost := estimate_cost(row["model"], row["input_tokens"] * 1.0, row["output_tokens"] * 1.0)
				db_execute(db, "UPDATE requests SET cost_usd = ? WHERE id = ?", [estimated_cost, row["id"]])
			}
		}
		db_execute(db, "INSERT INTO schema_migrations (key, applied_at) VALUES (?, ?)", ["0008_ai_chat_direct_api_reprice", to_string(current_timestamp())])
	}
}

export watchdog_cost_per_million := cost_per_million
export watchdog_estimate_cost := estimate_cost
export watchdog_has_known_pricing := has_known_pricing
export watchdog_ensure_schema := ensure_schema
