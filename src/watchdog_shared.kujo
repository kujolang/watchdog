	db_execute(db, "INSERT OR IGNORE INTO schema_migrations (key, applied_at) VALUES (?, ?)", ["0010_sqlite_rate_limit_buckets", to_string(current_timestamp())])
	db_execute(db, "INSERT OR IGNORE INTO schema_migrations (key, applied_at) VALUES (?, ?)", ["0011_automated_backups", to_string(current_timestamp())])
	db_execute(db, "INSERT OR IGNORE INTO schema_migrations (key, applied_at) VALUES (?, ?)", ["0012_pricing_provenance", to_string(current_timestamp())])
	db_execute(db, "INSERT OR IGNORE INTO schema_migrations (key, applied_at) VALUES (?, ?)", ["0013_pricing_reprice_audit", to_string(current_timestamp())])
}

export watchdog_cost_per_million := cost_per_million
export watchdog_estimate_cost := estimate_cost
export watchdog_has_known_pricing := has_known_pricing
export watchdog_pricing_record := pricing_record
export watchdog_cost_breakdown := cost_breakdown
export watchdog_ensure_schema := ensure_schema
