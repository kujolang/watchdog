from watchdog_shared import watchdog_ensure_schema
from telemetry_repository import watchdog_telemetry_repository_insert
from telemetry_delivery import watchdog_delivery_enqueue_batch
from telemetry_delivery import watchdog_delivery_load_profiles

db_path := env("WDG_TEST_DB_PATH")
config_path := env("WDG_TEST_EXPORTERS_PATH")
db := db_connect("sqlite", db_path)
watchdog_ensure_schema(db)
profiles := watchdog_delivery_load_profiles(config_path)
assert(len(profiles) == 2, "exporter profile filtering drift")

first_batch := parse_json(read_file("tests/fixtures/telemetry-v2/canonical-minimal.json"))
first := watchdog_telemetry_repository_insert(db, first_batch)
first_delivery := watchdog_delivery_enqueue_batch(db, profiles, first["batch_dbid"], 1, 1048576)
assert(first_delivery["enqueued"] == 2 && first_delivery["dropped"] == 0, "first delivery enqueue failed")

second_batch := parse_json(read_file("tests/fixtures/telemetry-v2/canonical-model-batch.json"))
second := watchdog_telemetry_repository_insert(db, second_batch)
second_delivery := watchdog_delivery_enqueue_batch(db, profiles, second["batch_dbid"], 1, 1048576)
assert(second_delivery["enqueued"] == 2 && second_delivery["dropped"] == 2, "bounded queue did not drop oldest delivery")

rows := db_query(db, "SELECT status, COUNT(*) AS n FROM telemetry_export_deliveries GROUP BY status ORDER BY status", [])
assert(len(rows) == 2, "delivery status cardinality drift")
assert(rows[0]["status"] == "dropped" && rows[0]["n"] == 2, "oldest delivery was not marked dropped")
assert(rows[1]["status"] == "pending" && rows[1]["n"] == 2, "newest delivery was not retained")

byte_bounded := watchdog_delivery_enqueue_batch(db, profiles, second["batch_dbid"], 10, 1)
assert(byte_bounded["enqueued"] == 0 && byte_bounded["dropped"] >= 2, "queue byte cap did not reject oversized records")
pending_after_byte_cap := db_query(db, "SELECT COUNT(*) AS n FROM telemetry_export_deliveries WHERE status IN ('pending','retry')", [])
assert(pending_after_byte_cap[0]["n"] == 0, "queue byte cap left oversized pending delivery")

# Incoming batches can exceed the configured queue count even when empty.
large := parse_json(read_file("tests/fixtures/telemetry-v2/canonical-minimal.json"))
large["batch_id"] = "queue-large"
records := []
for n in [1, 2, 3] {
    record := parse_json(to_json(large["records"][0]))
    record["record_id"] = "queue-record-" + to_string(n)
    record["name"] = repeat("界", 100)
    records = push(records, record)
}
large["records"] = records
inserted := watchdog_telemetry_repository_insert(db, large)
assert(inserted["ok"], "large fixture was not inserted")
limited := watchdog_delivery_enqueue_batch(db, ["count-bound"], inserted["batch_dbid"], 1, 1048576)
counts := db_query(db, "SELECT COUNT(*) AS n FROM telemetry_export_deliveries WHERE profile_id = 'count-bound' AND status IN ('pending','retry')", [])
assert(counts[0]["n"] == 1 && limited["dropped"] == 2, "incoming batch exceeded queue record cap")
size := db_query(db, "SELECT LENGTH(canonical_json) AS chars, LENGTH(CAST(canonical_json AS BLOB)) AS bytes FROM telemetry_records_v2 WHERE batch_dbid = ? ORDER BY id LIMIT 1", [inserted["batch_dbid"]])[0]
assert(size["bytes"] > size["chars"], "Unicode fixture did not distinguish bytes from characters")
unicode := watchdog_delivery_enqueue_batch(db, ["byte-bound"], inserted["batch_dbid"], 100, size["chars"])
assert(unicode["enqueued"] == 0, "Unicode queue cap counted characters instead of bytes")

print("telemetry_delivery_check: PASS")
