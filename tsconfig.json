{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] },
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "components/**/*.tsx"]
}
