# Shared helpers for Watchdog modules.
# Compatibility entrypoint mirrored from src/watchdog_shared.kujo.

DEFAULT_PROVIDER_PRICING_CATALOG_PATH := "config/provider_pricing_catalog.json"
DEFAULT_OPENROUTER_PRICING_CATALOG_PATH := "config/openrouter_pricing_catalog.json"
DEFAULT_FALLBACK_INPUT_RATE_PER_MILLION := 1.00
DEFAULT_FALLBACK_OUTPUT_RATE_PER_MILLION := 3.00
DEFAULT_FALLBACK_PRICING_SOURCE := "watchdog-fallback-estimate:v1"
DEFAULT_UNKNOWN_PRICING_SOURCE := "watchdog-pricing-unavailable:v1"

func shared_env_or(key, fallback_value) {
	value := env(key)
	if type(value) == "null" {
		return fallback_value
	}
	text := trim(to_string(value))
	if text == "" {
		return fallback_value
	}
	return text
}

func to_float_or_zero(value) {
	try {
		return parse_float(to_string(value))
	} except err {
		return 0.0
	}
}

func normalize_model_key(model) {
	return to_lower(trim(to_string(model)))
}

func load_pricing_catalog(env_key, fallback_path, missing_catalog_id) {
	catalog_path := shared_env_or(env_key, fallback_path)
	try {
		raw := read_file(catalog_path)
		parsed := parse_json(raw)
		if type(parsed) == "dict" {
			return parsed
		}
	} except err {
	}
	return {
		"schema_version": 1,
		"catalog_id": missing_catalog_id,
		"models": {},
		"aliases": {}
	}
}

func load_provider_pricing_catalog() {
	return load_pricing_catalog("WDG_PROVIDER_PRICING_CATALOG_PATH", DEFAULT_PROVIDER_PRICING_CATALOG_PATH, "missing-provider-catalog")
}

func load_openrouter_pricing_catalog() {
	return load_pricing_catalog("WDG_OPENROUTER_PRICING_CATALOG_PATH", DEFAULT_OPENROUTER_PRICING_CATALOG_PATH, "missing-openrouter-catalog")
}

PROVIDER_PRICING_CATALOG := load_provider_pricing_catalog()
OPENROUTER_PRICING_CATALOG := load_openrouter_pricing_catalog()

func catalog_models(catalog) {
	if has_key(catalog, "models") && type(catalog["models"]) == "dict" {
		return catalog["models"]
	}
	return {}
}

func catalog_aliases(catalog) {
	if has_key(catalog, "aliases") && type(catalog["aliases"]) == "dict" {
		return catalog["aliases"]
	}
	return {}
}

func pricing_record_from_catalog(catalog, requested_model, record, priced_model, pricing_source_override) {
	pricing_source := pricing_source_override
	if pricing_source == "" {
		pricing_source = to_string(record["pricing_source"])
	}
	has_pricing := 0
	if has_key(record, "has_pricing") {
		has_pricing = to_string(record["has_pricing"]) == "true" || record["has_pricing"] == true
	}
	if !has_pricing {
		return {
			"requested_model": requested_model,
			"priced_model": priced_model,
			"pricing_kind": "unknown",
			"pricing_source": pricing_source,
			"input_rate_per_million": 0.0,
			"output_rate_per_million": 0.0,
			"cached_input_rate_per_million": 0.0,
			"cache_write_input_rate_per_million": 0.0
		}
	}
	return {
		"requested_model": requested_model,
		"priced_model": priced_model,
		"pricing_kind": "catalog",
		"pricing_source": pricing_source,
		"input_rate_per_million": to_float_or_zero(record["input_rate_per_million"]),
		"output_rate_per_million": to_float_or_zero(record["output_rate_per_million"]),
		"cached_input_rate_per_million": to_float_or_zero(record["cached_input_rate_per_million"]),
		"cache_write_input_rate_per_million": to_float_or_zero(record["cache_write_input_rate_per_million"])
	}
}

func lookup_catalog_pricing_record(catalog, model_key) {
	models := catalog_models(catalog)
	aliases := catalog_aliases(catalog)
	if has_key(models, model_key) && type(models[model_key]) == "dict" {
		return pricing_record_from_catalog(catalog, model_key, models[model_key], to_string(models[model_key]["priced_model"]), "")
	}
	if has_key(aliases, model_key) && type(aliases[model_key]) == "dict" {
		alias_record := aliases[model_key]
		target_model := normalize_model_key(alias_record["target_model_id"])
		if target_model != "" && has_key(models, target_model) && type(models[target_model]) == "dict" {
			return pricing_record_from_catalog(catalog, model_key, models[target_model], target_model, to_string(alias_record["pricing_source"]))
		}
	}
	return null
}

func pricing_record(model) {
	model_key := normalize_model_key(model)
	if model_key == "" {
		return {
			"requested_model": "",
			"priced_model": "",
			"pricing_kind": "unknown",
			"pricing_source": DEFAULT_UNKNOWN_PRICING_SOURCE,
			"input_rate_per_million": 0.0,
			"output_rate_per_million": 0.0,
			"cached_input_rate_per_million": 0.0,
			"cache_write_input_rate_per_million": 0.0
		}
	}

	provider_record := lookup_catalog_pricing_record(PROVIDER_PRICING_CATALOG, model_key)
	if type(provider_record) == "dict" {
		return provider_record
	}

	ollama_alias_record := lookup_catalog_pricing_record(PROVIDER_PRICING_CATALOG, "ollama-cloud/" + model_key)
	if type(ollama_alias_record) == "dict" {
		return ollama_alias_record
	}

	openrouter_record := lookup_catalog_pricing_record(OPENROUTER_PRICING_CATALOG, model_key)
	if type(openrouter_record) == "dict" {
		return openrouter_record
	}

	return {
		"requested_model": model_key,
		"priced_model": model_key,
		"pricing_kind": "fallback",
		"pricing_source": DEFAULT_FALLBACK_PRICING_SOURCE,
		"input_rate_per_million": DEFAULT_FALLBACK_INPUT_RATE_PER_MILLION,
		"output_rate_per_million": DEFAULT_FALLBACK_OUTPUT_RATE_PER_MILLION,
		"cached_input_rate_per_million": 0.0,
		"cache_write_input_rate_per_million": 0.0
	}
}

func cost_breakdown(model, input_tokens, output_tokens, cached_input_tokens, cache_write_input_tokens) {
	pricing := pricing_record(model)
	input_cost := (input_tokens / 1000000.0) * pricing["input_rate_per_million"]
	output_cost := (output_tokens / 1000000.0) * pricing["output_rate_per_million"]
	cached_input_cost := (cached_input_tokens / 1000000.0) * pricing["cached_input_rate_per_million"]
	cache_write_input_cost := (cache_write_input_tokens / 1000000.0) * pricing["cache_write_input_rate_per_million"]
	return {
		"requested_model": pricing["requested_model"],
		"priced_model": pricing["priced_model"],
		"pricing_kind": pricing["pricing_kind"],
		"pricing_source": pricing["pricing_source"],
		"input_rate_per_million": pricing["input_rate_per_million"],
		"output_rate_per_million": pricing["output_rate_per_million"],
		"cached_input_rate_per_million": pricing["cached_input_rate_per_million"],
		"cache_write_input_rate_per_million": pricing["cache_write_input_rate_per_million"],
		"input_cost_usd": input_cost,
		"output_cost_usd": output_cost,
		"cached_input_cost_usd": cached_input_cost,
		"cache_write_input_cost_usd": cache_write_input_cost,
		"total_cost_usd": input_cost + output_cost + cached_input_cost + cache_write_input_cost
	}
}

func cost_per_million(model) {
	pricing := pricing_record(model)
	return {"input": pricing["input_rate_per_million"], "output": pricing["output_rate_per_million"]}
}

func has_known_pricing(model) {
	return pricing_record(model)["pricing_kind"] == "catalog"
}

func estimate_cost(model, input_tokens, output_tokens) {
	return cost_breakdown(model, input_tokens, output_tokens, 0.0, 0.0)["total_cost_usd"]
}

func ensure_schema(db) {
	# Local-first concurrency baseline: one durable writer, concurrent readers,
	# and a bounded wait instead of immediate lock failures.
	db_query(db, "PRAGMA journal_mode=WAL", [])
	db_query(db, "PRAGMA synchronous=NORMAL", [])
	db_query(db, "PRAGMA busy_timeout=5000", [])
	db_query(db, "PRAGMA foreign_keys=ON", [])
	db_execute(db, "CREATE TABLE IF NOT EXISTS schema_migrations (key TEXT PRIMARY KEY, applied_at TEXT NOT NULL DEFAULT '')", [])

	db_execute(db, "CREATE TABLE IF NOT EXISTS requests (id INTEGER PRIMARY KEY AUTOINCREMENT, session_id TEXT NOT NULL DEFAULT '', user_id TEXT NOT NULL DEFAULT '', tenant_id TEXT NOT NULL DEFAULT '', project_id TEXT NOT NULL DEFAULT '', workflow_id TEXT NOT NULL DEFAULT '', task_id TEXT NOT NULL DEFAULT '', correlation_id TEXT NOT NULL DEFAULT '', provider TEXT NOT NULL DEFAULT '', model TEXT NOT NULL DEFAULT '', request_id TEXT NOT NULL DEFAULT '', status TEXT NOT NULL DEFAULT 'success', input_tokens INTEGER NOT NULL DEFAULT 0, output_tokens INTEGER NOT NULL DEFAULT 0, total_tokens INTEGER NOT NULL DEFAULT 0, cached_input_tokens INTEGER NOT NULL DEFAULT 0, cache_write_input_tokens INTEGER NOT NULL DEFAULT 0, cost_usd REAL NOT NULL DEFAULT 0.0, input_cost_usd REAL NOT NULL DEFAULT 0.0, output_cost_usd REAL NOT NULL DEFAULT 0.0, cached_input_cost_usd REAL NOT NULL DEFAULT 0.0, cache_write_input_cost_usd REAL NOT NULL DEFAULT 0.0, input_rate_per_million REAL NOT NULL DEFAULT 0.0, output_rate_per_million REAL NOT NULL DEFAULT 0.0, cached_input_rate_per_million REAL NOT NULL DEFAULT 0.0, cache_write_input_rate_per_million REAL NOT NULL DEFAULT 0.0, pricing_source TEXT NOT NULL DEFAULT '', pricing_kind TEXT NOT NULL DEFAULT 'unknown', priced_model TEXT NOT NULL DEFAULT '', latency_ms INTEGER NOT NULL DEFAULT 0, finish_reason TEXT NOT NULL DEFAULT '', error_code TEXT NOT NULL DEFAULT '', error_message TEXT NOT NULL DEFAULT '', prompt_summary TEXT NOT NULL DEFAULT '', response_summary TEXT NOT NULL DEFAULT '', source_app TEXT NOT NULL DEFAULT 'legacy', data_class TEXT NOT NULL DEFAULT 'legacy', created_at TEXT NOT NULL DEFAULT '')", [])

	db_execute(db, "CREATE TABLE IF NOT EXISTS tool_calls (id INTEGER PRIMARY KEY AUTOINCREMENT, request_dbid INTEGER NOT NULL DEFAULT 0, session_id TEXT NOT NULL DEFAULT '', tool_call_id TEXT NOT NULL DEFAULT '', tool_name TEXT NOT NULL DEFAULT '', tool_args TEXT NOT NULL DEFAULT '{}', tool_result TEXT NOT NULL DEFAULT '', status TEXT NOT NULL DEFAULT 'success', latency_ms INTEGER NOT NULL DEFAULT 0, source_app TEXT NOT NULL DEFAULT 'legacy', data_class TEXT NOT NULL DEFAULT 'legacy', created_at TEXT NOT NULL DEFAULT '')", [])

	db_execute(db, "CREATE TABLE IF NOT EXISTS agent_steps (id INTEGER PRIMARY KEY AUTOINCREMENT, session_id TEXT NOT NULL DEFAULT '', agent_id TEXT NOT NULL DEFAULT '', step_number INTEGER NOT NULL DEFAULT 0, step_type TEXT NOT NULL DEFAULT '', content TEXT NOT NULL DEFAULT '', metadata TEXT NOT NULL DEFAULT '{}', source_app TEXT NOT NULL DEFAULT 'legacy', data_class TEXT NOT NULL DEFAULT 'legacy', created_at TEXT NOT NULL DEFAULT '')", [])

	db_execute(db, "CREATE TABLE IF NOT EXISTS audit_events (id INTEGER PRIMARY KEY AUTOINCREMENT, action TEXT NOT NULL DEFAULT '', actor_key TEXT NOT NULL DEFAULT '', result TEXT NOT NULL DEFAULT '', metadata TEXT NOT NULL DEFAULT '{}', created_at TEXT NOT NULL DEFAULT '')", [])

	db_execute(db, "CREATE TABLE IF NOT EXISTS traces (id INTEGER PRIMARY KEY AUTOINCREMENT, trace_id TEXT NOT NULL UNIQUE, schema_version TEXT NOT NULL DEFAULT 'kujo.telemetry.v1', request_dbid INTEGER NOT NULL DEFAULT 0, session_id TEXT NOT NULL DEFAULT '', source_app TEXT NOT NULL DEFAULT 'legacy', data_class TEXT NOT NULL DEFAULT 'legacy', model TEXT NOT NULL DEFAULT '', name TEXT NOT NULL DEFAULT '', status TEXT NOT NULL DEFAULT 'success', started_at_ms INTEGER NOT NULL DEFAULT 0, ended_at_ms INTEGER NOT NULL DEFAULT 0, duration_ms INTEGER NOT NULL DEFAULT 0, input_tokens INTEGER NOT NULL DEFAULT 0, output_tokens INTEGER NOT NULL DEFAULT 0, cached_input_tokens INTEGER NOT NULL DEFAULT 0, cache_write_input_tokens INTEGER NOT NULL DEFAULT 0, input_cost_usd REAL NOT NULL DEFAULT 0.0, output_cost_usd REAL NOT NULL DEFAULT 0.0, cached_input_cost_usd REAL NOT NULL DEFAULT 0.0, cache_write_input_cost_usd REAL NOT NULL DEFAULT 0.0, input_rate_per_million REAL NOT NULL DEFAULT 0.0, output_rate_per_million REAL NOT NULL DEFAULT 0.0, cached_input_rate_per_million REAL NOT NULL DEFAULT 0.0, cache_write_input_rate_per_million REAL NOT NULL DEFAULT 0.0, pricing_source TEXT NOT NULL DEFAULT '', pricing_kind TEXT NOT NULL DEFAULT 'unknown', priced_model TEXT NOT NULL DEFAULT '', attributes_json TEXT NOT NULL DEFAULT '{}', created_at TEXT NOT NULL DEFAULT '')", [])

	db_execute(db, "CREATE TABLE IF NOT EXISTS trace_spans (id INTEGER PRIMARY KEY AUTOINCREMENT, trace_id TEXT NOT NULL DEFAULT '', span_id TEXT NOT NULL DEFAULT '', parent_span_id TEXT NOT NULL DEFAULT '', request_dbid INTEGER NOT NULL DEFAULT 0, session_id TEXT NOT NULL DEFAULT '', source_app TEXT NOT NULL DEFAULT 'legacy', data_class TEXT NOT NULL DEFAULT 'legacy', span_kind TEXT NOT NULL DEFAULT 'internal', name TEXT NOT NULL DEFAULT '', status TEXT NOT NULL DEFAULT 'success', started_at_ms INTEGER NOT NULL DEFAULT 0, ended_at_ms INTEGER NOT NULL DEFAULT 0, duration_ms INTEGER NOT NULL DEFAULT 0, attributes_json TEXT NOT NULL DEFAULT '{}', created_at TEXT NOT NULL DEFAULT '', UNIQUE(trace_id, span_id))", [])

	db_execute(db, "CREATE TABLE IF NOT EXISTS trace_events (id INTEGER PRIMARY KEY AUTOINCREMENT, event_id TEXT NOT NULL DEFAULT '', trace_id TEXT NOT NULL DEFAULT '', span_id TEXT NOT NULL DEFAULT '', sequence INTEGER NOT NULL DEFAULT 0, event_name TEXT NOT NULL DEFAULT '', occurred_at_ms INTEGER NOT NULL DEFAULT 0, attributes_json TEXT NOT NULL DEFAULT '{}', source_app TEXT NOT NULL DEFAULT 'legacy', data_class TEXT NOT NULL DEFAULT 'legacy', created_at TEXT NOT NULL DEFAULT '', UNIQUE(trace_id, event_id))", [])
	db_execute(db, "CREATE TABLE IF NOT EXISTS rate_limit_buckets (bucket_key TEXT PRIMARY KEY, window_start_ms INTEGER NOT NULL DEFAULT 0, request_count INTEGER NOT NULL DEFAULT 0, last_seen_ms INTEGER NOT NULL DEFAULT 0)", [])
	db_execute(db, "CREATE TABLE IF NOT EXISTS backup_settings (id INTEGER PRIMARY KEY CHECK(id = 1), enabled INTEGER NOT NULL DEFAULT 1, interval_minutes INTEGER NOT NULL DEFAULT 1440, backup_dir TEXT NOT NULL DEFAULT 'data/backups', retention_count INTEGER NOT NULL DEFAULT 30, encryption_enabled INTEGER NOT NULL DEFAULT 0, updated_at_ms INTEGER NOT NULL DEFAULT 0)", [])
	db_execute(db, "CREATE TABLE IF NOT EXISTS backup_runs (id INTEGER PRIMARY KEY AUTOINCREMENT, trigger_type TEXT NOT NULL DEFAULT 'scheduled', status TEXT NOT NULL DEFAULT 'running', backup_path TEXT NOT NULL DEFAULT '', checksum_path TEXT NOT NULL DEFAULT '', size_bytes INTEGER NOT NULL DEFAULT 0, encrypted INTEGER NOT NULL DEFAULT 0, error_message TEXT NOT NULL DEFAULT '', started_at_ms INTEGER NOT NULL DEFAULT 0, finished_at_ms INTEGER NOT NULL DEFAULT 0)", [])
	db_execute(db, "CREATE TABLE IF NOT EXISTS pricing_reprice_runs (id INTEGER PRIMARY KEY AUTOINCREMENT, run_id TEXT NOT NULL UNIQUE, dry_run INTEGER NOT NULL DEFAULT 1, selector_json TEXT NOT NULL DEFAULT '{}', pricing_source TEXT NOT NULL DEFAULT '', candidate_count INTEGER NOT NULL DEFAULT 0, applied_change_count INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL DEFAULT '')", [])
	db_execute(db, "CREATE TABLE IF NOT EXISTS pricing_reprice_changes (id INTEGER PRIMARY KEY AUTOINCREMENT, run_id TEXT NOT NULL DEFAULT '', request_dbid INTEGER NOT NULL DEFAULT 0, trace_id TEXT NOT NULL DEFAULT '', source_app TEXT NOT NULL DEFAULT '', model TEXT NOT NULL DEFAULT '', before_record_json TEXT NOT NULL DEFAULT '{}', after_record_json TEXT NOT NULL DEFAULT '{}', applied INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL DEFAULT '')", [])
	db_execute(db, "CREATE TABLE IF NOT EXISTS telemetry_batches_v2 (id INTEGER PRIMARY KEY AUTOINCREMENT, producer_name TEXT NOT NULL, batch_id TEXT NOT NULL, schema_version TEXT NOT NULL DEFAULT 'watchdog.telemetry.v2', sent_at TEXT, received_at TEXT NOT NULL, record_count INTEGER NOT NULL DEFAULT 0, content_mode TEXT NOT NULL DEFAULT 'off', UNIQUE(producer_name, batch_id))", [])
	db_execute(db, "CREATE TABLE IF NOT EXISTS telemetry_records_v2 (id INTEGER PRIMARY KEY AUTOINCREMENT, batch_dbid INTEGER NOT NULL, producer_name TEXT NOT NULL, record_id TEXT NOT NULL, record_type TEXT NOT NULL, trace_id TEXT NOT NULL, span_id TEXT, parent_span_id TEXT, observed_at TEXT NOT NULL, started_at TEXT, ended_at TEXT, kind TEXT, name TEXT, status TEXT NOT NULL DEFAULT 'unset', source_json TEXT NOT NULL DEFAULT '{}', references_json TEXT NOT NULL DEFAULT '[]', attributes_json TEXT NOT NULL DEFAULT '{}', usage_json TEXT, costs_json TEXT NOT NULL DEFAULT '[]', error_json TEXT, content_json TEXT NOT NULL DEFAULT '[]', privacy_json TEXT NOT NULL DEFAULT '{}', canonical_json TEXT NOT NULL, canonical_sha256 TEXT, logical_request_id TEXT, attempt_number INTEGER, retry_of_request_id TEXT, terminal_outcome TEXT, time_to_first_output_ms INTEGER, output_generation_duration_ms INTEGER, output_tokens_per_second REAL, context_window_tokens INTEGER, context_utilization_ratio REAL, application_name TEXT, harness_name TEXT, instrumentation_name TEXT, instrumentation_version TEXT, created_at TEXT NOT NULL, UNIQUE(producer_name, record_id))", [])
	db_execute(db, "CREATE TABLE IF NOT EXISTS telemetry_references_v2 (record_dbid INTEGER NOT NULL, ref_type TEXT NOT NULL, ref_id TEXT NOT NULL, namespace TEXT NOT NULL DEFAULT '', relation TEXT NOT NULL DEFAULT '', PRIMARY KEY(record_dbid, ref_type, ref_id, namespace, relation))", [])
	db_execute(db, "CREATE TABLE IF NOT EXISTS telemetry_record_conflicts_v2 (id INTEGER PRIMARY KEY AUTOINCREMENT, producer_name TEXT NOT NULL, record_id TEXT NOT NULL, batch_id TEXT NOT NULL, existing_sha256 TEXT NOT NULL, incoming_sha256 TEXT NOT NULL, result TEXT NOT NULL DEFAULT 'rejected', created_at TEXT NOT NULL)", [])
	db_execute(db, "CREATE TABLE IF NOT EXISTS telemetry_export_deliveries (id INTEGER PRIMARY KEY AUTOINCREMENT, profile_id TEXT NOT NULL, record_dbid INTEGER NOT NULL, status TEXT NOT NULL DEFAULT 'pending', attempts INTEGER NOT NULL DEFAULT 0, next_attempt_ms INTEGER NOT NULL DEFAULT 0, last_http_status INTEGER NOT NULL DEFAULT 0, last_error TEXT NOT NULL DEFAULT '', created_at_ms INTEGER NOT NULL, updated_at_ms INTEGER NOT NULL, UNIQUE(profile_id, record_dbid))", [])
	db_execute(db, "CREATE TABLE IF NOT EXISTS telemetry_export_profile_state (profile_id TEXT PRIMARY KEY, status TEXT NOT NULL DEFAULT 'ready', consecutive_failures INTEGER NOT NULL DEFAULT 0, last_success_ms INTEGER NOT NULL DEFAULT 0, last_failure_ms INTEGER NOT NULL DEFAULT 0, paused_reason TEXT NOT NULL DEFAULT '', updated_at_ms INTEGER NOT NULL DEFAULT 0)", [])
	db_execute(db, "CREATE TABLE IF NOT EXISTS telemetry_export_dead_letters (id INTEGER PRIMARY KEY AUTOINCREMENT, delivery_id INTEGER NOT NULL, profile_id TEXT NOT NULL, record_dbid INTEGER NOT NULL, reason TEXT NOT NULL DEFAULT '', payload_sha256 TEXT NOT NULL DEFAULT '', created_at_ms INTEGER NOT NULL)", [])
	db_execute(db, "CREATE TABLE IF NOT EXISTS source_observations (source_kind TEXT NOT NULL, source_identity TEXT NOT NULL, first_seen_at TEXT, last_seen_at TEXT, accepted_records INTEGER NOT NULL DEFAULT 0, legacy_requests INTEGER NOT NULL DEFAULT 0, is_otlp INTEGER NOT NULL DEFAULT 0, PRIMARY KEY(source_kind, source_identity))", [])
	db_execute(db, "CREATE TABLE IF NOT EXISTS source_observation_state (id INTEGER PRIMARY KEY CHECK(id = 1), revision INTEGER NOT NULL DEFAULT 0)", [])
	db_execute(db, "INSERT OR IGNORE INTO source_observation_state(id, revision) VALUES(1, 0)", [])
	db_execute(db, "CREATE TRIGGER IF NOT EXISTS trg_source_observation_request_insert AFTER INSERT ON requests WHEN NEW.source_app <> '' BEGIN INSERT INTO source_observations(source_kind, source_identity, first_seen_at, last_seen_at, legacy_requests) VALUES(CASE WHEN NEW.source_app = 'watchdog-proxy' THEN 'proxy' ELSE 'legacy' END, CASE WHEN NEW.source_app = 'watchdog-proxy' THEN NEW.provider ELSE NEW.source_app END, NEW.created_at, NEW.created_at, 1) ON CONFLICT(source_kind, source_identity) DO UPDATE SET first_seen_at = CASE WHEN excluded.first_seen_at < first_seen_at THEN excluded.first_seen_at ELSE first_seen_at END, last_seen_at = CASE WHEN excluded.last_seen_at > last_seen_at THEN excluded.last_seen_at ELSE last_seen_at END, legacy_requests = legacy_requests + 1; END", [])
	db_execute(db, "CREATE TRIGGER IF NOT EXISTS trg_source_observation_canonical_insert AFTER INSERT ON telemetry_records_v2 BEGIN INSERT INTO source_observations(source_kind, source_identity, first_seen_at, last_seen_at, accepted_records, is_otlp) VALUES('canonical', NEW.producer_name, NEW.observed_at, NEW.observed_at, 1, CASE WHEN NEW.source_json LIKE '%otlp-%' OR NEW.source_json LIKE '%otlp_%' THEN 1 ELSE 0 END) ON CONFLICT(source_kind, source_identity) DO UPDATE SET first_seen_at = CASE WHEN excluded.first_seen_at < first_seen_at THEN excluded.first_seen_at ELSE first_seen_at END, last_seen_at = CASE WHEN excluded.last_seen_at > last_seen_at THEN excluded.last_seen_at ELSE last_seen_at END, accepted_records = accepted_records + 1, is_otlp = CASE WHEN excluded.is_otlp = 1 THEN 1 ELSE is_otlp END; END", [])
	db_execute(db, "CREATE TRIGGER IF NOT EXISTS trg_source_observation_request_delete AFTER DELETE ON requests WHEN OLD.source_app <> '' BEGIN UPDATE source_observations SET legacy_requests = (SELECT COUNT(*) FROM requests WHERE source_app <> '' AND (CASE WHEN source_app = 'watchdog-proxy' THEN 'proxy' ELSE 'legacy' END) = source_observations.source_kind AND (CASE WHEN source_app = 'watchdog-proxy' THEN provider ELSE source_app END) = source_observations.source_identity), first_seen_at = (SELECT MIN(created_at) FROM requests WHERE source_app <> '' AND (CASE WHEN source_app = 'watchdog-proxy' THEN 'proxy' ELSE 'legacy' END) = source_observations.source_kind AND (CASE WHEN source_app = 'watchdog-proxy' THEN provider ELSE source_app END) = source_observations.source_identity), last_seen_at = (SELECT MAX(created_at) FROM requests WHERE source_app <> '' AND (CASE WHEN source_app = 'watchdog-proxy' THEN 'proxy' ELSE 'legacy' END) = source_observations.source_kind AND (CASE WHEN source_app = 'watchdog-proxy' THEN provider ELSE source_app END) = source_observations.source_identity) WHERE source_kind = CASE WHEN OLD.source_app = 'watchdog-proxy' THEN 'proxy' ELSE 'legacy' END AND source_identity = CASE WHEN OLD.source_app = 'watchdog-proxy' THEN OLD.provider ELSE OLD.source_app END; DELETE FROM source_observations WHERE source_kind = CASE WHEN OLD.source_app = 'watchdog-proxy' THEN 'proxy' ELSE 'legacy' END AND source_identity = CASE WHEN OLD.source_app = 'watchdog-proxy' THEN OLD.provider ELSE OLD.source_app END AND legacy_requests <= 0 AND accepted_records <= 0; END", [])
	db_execute(db, "CREATE TRIGGER IF NOT EXISTS trg_source_observation_canonical_delete AFTER DELETE ON telemetry_records_v2 BEGIN UPDATE source_observations SET accepted_records = (SELECT COUNT(*) FROM telemetry_records_v2 WHERE producer_name = OLD.producer_name), first_seen_at = (SELECT MIN(observed_at) FROM telemetry_records_v2 WHERE producer_name = OLD.producer_name), last_seen_at = (SELECT MAX(observed_at) FROM telemetry_records_v2 WHERE producer_name = OLD.producer_name), is_otlp = (SELECT COALESCE(MAX(CASE WHEN source_json LIKE '%otlp-%' OR source_json LIKE '%otlp_%' THEN 1 ELSE 0 END), 0) FROM telemetry_records_v2 WHERE producer_name = OLD.producer_name) WHERE source_kind = 'canonical' AND source_identity = OLD.producer_name; DELETE FROM source_observations WHERE source_kind = 'canonical' AND source_identity = OLD.producer_name AND legacy_requests <= 0 AND accepted_records <= 0; END", [])
	db_execute(db, "CREATE TRIGGER IF NOT EXISTS trg_source_observation_request_revision_insert AFTER INSERT ON requests BEGIN UPDATE source_observation_state SET revision = revision + 1 WHERE id = 1; END", [])
	db_execute(db, "CREATE TRIGGER IF NOT EXISTS trg_source_observation_request_revision_delete AFTER DELETE ON requests BEGIN UPDATE source_observation_state SET revision = revision + 1 WHERE id = 1; END", [])
	db_execute(db, "CREATE TRIGGER IF NOT EXISTS trg_source_observation_canonical_revision_insert AFTER INSERT ON telemetry_records_v2 BEGIN UPDATE source_observation_state SET revision = revision + 1 WHERE id = 1; END", [])
	db_execute(db, "CREATE TRIGGER IF NOT EXISTS trg_source_observation_canonical_revision_delete AFTER DELETE ON telemetry_records_v2 BEGIN UPDATE source_observation_state SET revision = revision + 1 WHERE id = 1; END", [])
	observation_migration := db_query(db, "SELECT key FROM schema_migrations WHERE key = '0018_connected_sources_summary' LIMIT 1", [])
	if len(observation_migration) == 0 {
		db_execute(db, "INSERT INTO source_observations(source_kind, source_identity, first_seen_at, last_seen_at, legacy_requests) SELECT CASE WHEN source_app = 'watchdog-proxy' THEN 'proxy' ELSE 'legacy' END, CASE WHEN source_app = 'watchdog-proxy' THEN provider ELSE source_app END, MIN(created_at), MAX(created_at), COUNT(*) FROM requests WHERE source_app <> '' GROUP BY 1, 2 ON CONFLICT(source_kind, source_identity) DO UPDATE SET first_seen_at=excluded.first_seen_at,last_seen_at=excluded.last_seen_at,legacy_requests=excluded.legacy_requests", [])
		db_execute(db, "INSERT INTO source_observations(source_kind, source_identity, first_seen_at, last_seen_at, accepted_records, is_otlp) SELECT 'canonical', producer_name, MIN(observed_at), MAX(observed_at), COUNT(*), MAX(CASE WHEN source_json LIKE '%otlp-%' OR source_json LIKE '%otlp_%' THEN 1 ELSE 0 END) FROM telemetry_records_v2 GROUP BY producer_name ON CONFLICT(source_kind, source_identity) DO UPDATE SET first_seen_at=excluded.first_seen_at,last_seen_at=excluded.last_seen_at,accepted_records=excluded.accepted_records,is_otlp=excluded.is_otlp", [])
	}

	try { db_execute(db, "ALTER TABLE requests ADD COLUMN workflow_id TEXT NOT NULL DEFAULT ''", []) } except err {}
	try { db_execute(db, "ALTER TABLE requests ADD COLUMN tenant_id TEXT NOT NULL DEFAULT ''", []) } except err {}
	try { db_execute(db, "ALTER TABLE requests ADD COLUMN project_id TEXT NOT NULL DEFAULT ''", []) } except err {}
	try { db_execute(db, "ALTER TABLE requests ADD COLUMN task_id TEXT NOT NULL DEFAULT ''", []) } except err {}
	try { db_execute(db, "ALTER TABLE requests ADD COLUMN correlation_id TEXT NOT NULL DEFAULT ''", []) } except err {}
	try { db_execute(db, "ALTER TABLE requests ADD COLUMN cached_input_tokens INTEGER NOT NULL DEFAULT 0", []) } except err {}
	try { db_execute(db, "ALTER TABLE requests ADD COLUMN cache_write_input_tokens INTEGER NOT NULL DEFAULT 0", []) } except err {}
	try { db_execute(db, "ALTER TABLE requests ADD COLUMN input_cost_usd REAL NOT NULL DEFAULT 0.0", []) } except err {}
	try { db_execute(db, "ALTER TABLE requests ADD COLUMN output_cost_usd REAL NOT NULL DEFAULT 0.0", []) } except err {}
