	db_execute(db, "INSERT OR IGNORE INTO schema_migrations (key, applied_at) VALUES (?, ?)", ["0007_direct_api_cost_estimates", to_string(current_timestamp())])
	db_execute(db, "INSERT OR IGNORE INTO schema_migrations (key, applied_at) VALUES (?, ?)", ["0008_ai_chat_direct_api_reprice", to_string(current_timestamp())])
	db_execute(db, "INSERT OR IGNORE INTO schema_migrations (key, applied_at) VALUES (?, ?)", ["0009_granular_trace_spans_events", to_string(current_timestamp())])
	db_execute(db, "INSERT OR IGNORE INTO schema_migrations (key, applied_at) VALUES (?, ?)", ["0010_sqlite_rate_limit_buckets", to_string(current_timestamp())])
